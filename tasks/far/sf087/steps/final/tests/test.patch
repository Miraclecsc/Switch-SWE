@@ -0,0 +1,44 @@
+import pytest
+from packaging.metadata import Metadata, parse_email
+
+RAW = {"metadata_version":"2.3", "name":"example", "version":"1.0", "summary":"café", "requires_dist":["a>=1","b"], "description":"héllo\nworld"}
+
+class ChildMetadata(Metadata): pass
+
+class OverriddenMetadata(Metadata):
+    @property
+    def summary(self): return "derived summary"
+
+def test_inherited_export():
+    base=Metadata.from_raw(dict(RAW))
+    child=ChildMetadata.from_raw(dict(RAW))
+    assert child.as_rfc822().as_bytes() == base.as_rfc822().as_bytes()
+    assert child.as_rfc822().get_all("requires-dist") == ["a>=1","b"]
+
+def test_override_effective_value():
+    msg=OverriddenMetadata.from_raw(dict(RAW)).as_rfc822()
+    assert msg["summary"] == "derived summary"
+    assert msg["name"] == "example"
+
+def test_exclusion_and_roundtrip():
+    obj=ChildMetadata.from_raw(dict(RAW))
+    msg=obj.as_rfc822(exclude=iter(["requires_dist","description"]))
+    parsed,unparsed=parse_email(msg.as_bytes())
+    assert unparsed == {}
+    assert parsed["name"] == "example" and parsed["summary"] == "café"
+    assert "requires_dist" not in parsed and not parsed.get("description")
+    assert obj.description == RAW["description"]
+
+def test_excluded_invalid_field_not_evaluated():
+    obj=Metadata.from_raw({**RAW,"requires_python":"not a specifier"},validate=False)
+    msg=obj.as_rfc822(exclude="requires_python")
+    assert msg["requires-python"] is None and msg["name"] == "example"
+
+def test_unknown_exclusion_before_validation():
+    obj=Metadata.from_raw({**RAW,"requires_python":"not a specifier"},validate=False)
+    with pytest.raises(ValueError,match="unknown metadata exclusion"):
+        obj.as_rfc822(exclude=["not_a_field"])
+
+def test_original_export_unicode():
+    msg=Metadata.from_raw(dict(RAW)).as_rfc822()
+    assert parse_email(msg.as_bytes())[0]["summary"] == "café"

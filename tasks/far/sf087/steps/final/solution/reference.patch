+    def as_rfc822(self, *, exclude=()) -> RFC822Message:
+        """
+        Return an RFC822 message with the metadata.
+        """
+        message = RFC822Message()
+        self._write_metadata(message, exclude=exclude)
+        return message
+
+    def _write_metadata(self, message: RFC822Message, *, exclude=()) -> None:
+        """
+        Return an RFC822 message with the metadata.
+        """
+        fields = {}
+        for cls in reversed(self.__class__.__mro__):
+            for name, validator in cls.__dict__.items():
+                if isinstance(validator, _Validator):
+                    fields[name] = validator
+        omitted = {exclude} if isinstance(exclude, str) else set(exclude)
+        unknown = omitted.difference(fields)
+        if unknown:
+            raise ValueError("unknown metadata exclusion: " + ", ".join(sorted(unknown)))
+        for name in fields:
+            if name not in omitted and name != "description":
+                value = getattr(self, name)
+                email_name = _RAW_TO_EMAIL_MAPPING[name]
+                if value is not None:
+                    if email_name == "project-url":
+                        for label, url in value.items():
+                            message[email_name] = f"{label}, {url}"
+                    elif email_name == "keywords":
+                        message[email_name] = ",".join(value)
+                    elif isinstance(value, list):
+                        for item in value:
+                            message[email_name] = str(item)
+                    else:
+                        message[email_name] = str(value)
+
+        # The description is a special case because it is in the body of the message.
+        if "description" not in omitted and self.description is not None:
+            message.set_payload(self.description)

diff --git a/networkx/__init__.py b/networkx/__init__.py
index de987ca06..66d0ab473 100644
--- a/networkx/__init__.py
+++ b/networkx/__init__.py
@@ -51,3 +51,21 @@ from networkx.linalg import *
 
 from networkx import drawing
 from networkx.drawing import *
+
+
+def _removed_random_tree_error(module, prefix):
+    return AttributeError(
+        f"{prefix}.random_tree was removed in version 3.4. Use `nx.random_labeled_tree` instead.\n"
+        "See: https://networkx.org/documentation/latest/release/release_3.4.html",
+        name="random_tree", obj=module,
+    )
+
+
+def __getattr__(name):
+    import sys
+    module = sys.modules[__name__]
+    if name == "random_tree":
+        raise _removed_random_tree_error(module, "nx")
+    raise AttributeError(
+        f"module 'networkx' has no attribute '{name}'", name=name, obj=module
+    )
diff --git a/networkx/generators/trees.py b/networkx/generators/trees.py

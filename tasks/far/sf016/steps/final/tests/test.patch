@@ -0,0 +1,62 @@
+import boto3
+import pytest
+from botocore.exceptions import ClientError
+from moto import mock_aws
+
+
+CONFIG = dict(agentRuntimeArtifact={"containerConfiguration":{"containerUri":"123456789012.dkr.ecr.us-east-1.amazonaws.com/agent:latest"}},
+              roleArn="arn:aws:iam::123456789012:role/Runtime",
+              networkConfiguration={"networkMode":"PUBLIC"})
+
+
+def setup():
+    c = boto3.client("bedrock-agentcore-control",region_name="us-east-1")
+    rid = c.create_agent_runtime(agentRuntimeName="versioned_runtime", **CONFIG)["agentRuntimeId"]
+    c.update_agent_runtime(agentRuntimeId=rid, **CONFIG)
+    return c, rid
+
+
+@mock_aws
+def test_endpoint_promotes_existing_target_revision_when_ready():
+    c, rid = setup()
+    c.create_agent_runtime_endpoint(agentRuntimeId=rid,name="endpoint",agentRuntimeVersion="1")
+    initial = c.get_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint")
+    assert initial["targetVersion"] == initial["liveVersion"] == "1"
+    update = c.update_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint",agentRuntimeVersion="2")
+    assert update["targetVersion"] == "2"
+    final = c.get_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint")
+    assert final["status"] == "READY"
+    assert final["targetVersion"] == final["liveVersion"] == "2"
+
+
+@mock_aws
+def test_create_unknown_version_does_not_leave_endpoint():
+    c, rid = setup()
+    with pytest.raises(ClientError) as caught:
+        c.create_agent_runtime_endpoint(agentRuntimeId=rid,name="invalid",agentRuntimeVersion="999")
+    assert caught.value.response["Error"]["Code"] == "ResourceNotFoundException"
+    assert c.list_agent_runtime_endpoints(agentRuntimeId=rid)["runtimeEndpoints"] == []
+
+
+@mock_aws
+def test_invalid_update_is_atomic_for_description_and_version():
+    c, rid = setup()
+    c.create_agent_runtime_endpoint(agentRuntimeId=rid,name="endpoint",agentRuntimeVersion="1",description="initial")
+    with pytest.raises(ClientError) as caught:
+        c.update_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint",
+                                       agentRuntimeVersion="999",description="must not commit")
+    assert caught.value.response["Error"]["Code"] == "ResourceNotFoundException"
+    value = c.get_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint")
+    assert value["description"] == "initial"
+    assert value["targetVersion"] == value["liveVersion"] == "1"
+
+
+@mock_aws
+def test_default_revision_is_pinned_and_metadata_update_keeps_it():
+    c, rid = setup()
+    c.create_agent_runtime_endpoint(agentRuntimeId=rid,name="endpoint")
+    c.update_agent_runtime(agentRuntimeId=rid, **CONFIG)
+    c.update_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint",description="metadata")
+    result = c.get_agent_runtime_endpoint(agentRuntimeId=rid,endpointName="endpoint")
+    assert result["targetVersion"] == result["liveVersion"] == "2"
+    assert result["description"] == "metadata"

@@ -0,0 +1,47 @@
+from django.db import connection
+from django.forms import modelformset_factory
+from django.test import TestCase
+from .models import Author
+
+
+class FormsetOrderingProvenanceTests(TestCase):
+    def setUp(self):
+        self.first = Author.objects.create(name="zeta")
+        self.second = Author.objects.create(name="alpha")
+        self.third = Author.objects.create(name="zeta")
+        self.factory = modelformset_factory(Author, fields=["name"], extra=0)
+
+    def ids(self, queryset):
+        return list(self.factory(queryset=queryset).get_queryset().values_list("pk", flat=True))
+
+    def test_explicitly_cleared_ordering_uses_pk_without_reviving_meta(self):
+        qs = Author.objects.order_by()
+        self.assertEqual(self.ids(qs), [self.first.pk, self.second.pk, self.third.pk])
+        self.assertFalse(qs.ordered)
+
+    def test_reversed_cleared_ordering_keeps_direction(self):
+        self.assertEqual(self.ids(Author.objects.order_by().reverse()),
+                         [self.third.pk, self.second.pk, self.first.pk])
+
+    def test_default_ordering_is_still_used_when_not_explicitly_cleared(self):
+        self.assertEqual(self.ids(Author.objects.all()),
+                         [self.second.pk, self.first.pk, self.third.pk])
+
+    def test_extra_ordering_receives_a_real_pk_tie_breaker(self):
+        # Give the database a legitimate covering index whose unconstrained tie
+        # order is opposite to the promised tie breaker.
+        table = connection.ops.quote_name(Author._meta.db_table)
+        index = connection.ops.quote_name("formset_ordering_contract")
+        with connection.cursor() as cursor:
+            cursor.execute(f"CREATE INDEX {index} ON {table} (name DESC, id DESC)")
+        try:
+            qs = Author.objects.extra(order_by=["-name"])
+            self.assertEqual(self.ids(qs), [self.first.pk, self.third.pk, self.second.pk])
+        finally:
+            with connection.cursor() as cursor:
+                cursor.execute(f"DROP INDEX {index}")
+
+    def test_already_total_order_and_input_queryset_are_preserved(self):
+        qs = Author.objects.order_by("-pk")
+        self.assertEqual(self.ids(qs), [self.third.pk, self.second.pk, self.first.pk])
+        self.assertEqual(list(qs.values_list("pk", flat=True)), [self.third.pk, self.second.pk, self.first.pk])

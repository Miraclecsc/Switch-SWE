diff --git a/tests/queries/test_identifier_boundaries_v1.py b/tests/queries/test_identifier_boundaries_v1.py
new file mode 100644
index 0000000000..b5987ef5bf
--- /dev/null
+++ b/tests/queries/test_identifier_boundaries_v1.py
@@ -0,0 +1,80 @@
+from unittest import skipUnless
+from functools import wraps
+from django.db import DatabaseError, connection, models
+from django.test import SimpleTestCase, TransactionTestCase
+from django.test.utils import isolate_apps
+
+def successful_database_operations(function):
+    @wraps(function)
+    def wrapper(self):
+        try:
+            return function(self)
+        except DatabaseError as exc:
+            self.fail(f"Valid quoted identifier must execute successfully: {exc}")
+    return wrapper
+
+
+@skipUnless(connection.vendor == "sqlite", "SQLite identifier contract")
+class IdentifierQuotingUnitTests(SimpleTestCase):
+    def test_embedded_delimiter_is_escaped_as_one_identifier(self):
+        self.assertEqual(connection.ops.quote_name('select"archive'), '"select""archive"')
+        self.assertEqual(connection.ops.quote_name('a""b'), '"a""""b"')
+
+    def test_explicitly_quoted_and_ordinary_names_keep_legacy_behavior(self):
+        self.assertEqual(connection.ops.quote_name('"already""quoted"'), '"already""quoted"')
+        self.assertEqual(connection.ops.quote_name("ordinary"), '"ordinary"')
+        self.assertEqual(connection.ops.quote_name("one.two"), '"one.two"')
+
+
+@skipUnless(connection.vendor == "sqlite", "SQLite identifier contract")
+class IdentifierRoundtripTests(TransactionTestCase):
+    available_apps = ["queries"]
+    @successful_database_operations
+    @isolate_apps()
+    def test_schema_and_crud_with_embedded_quotes(self):
+        class QuotedRecord(models.Model):
+            label = models.CharField(max_length=30, db_column='value"column')
+            class Meta:
+                app_label = "quoted_contract"
+                db_table = 'select"records'
+        with connection.schema_editor() as editor:
+            editor.create_model(QuotedRecord)
+        try:
+            item = QuotedRecord.objects.create(label="original")
+            self.assertEqual(QuotedRecord.objects.get(pk=item.pk).label, "original")
+            QuotedRecord.objects.filter(pk=item.pk).update(label="changed")
+            self.assertEqual(list(QuotedRecord.objects.values_list("label", flat=True)), ["changed"])
+            QuotedRecord.objects.filter(pk=item.pk).delete()
+            self.assertEqual(QuotedRecord.objects.count(), 0)
+        finally:
+            with connection.schema_editor() as editor:
+                editor.delete_model(QuotedRecord)
+
+    @successful_database_operations
+    @isolate_apps()
+    def test_join_and_correlated_subquery_preserve_identifier_boundaries(self):
+        class Parent(models.Model):
+            title = models.CharField(max_length=20, db_column='title"field')
+            class Meta:
+                app_label = "quoted_contract"
+                db_table = 'parent"table'
+        class Child(models.Model):
+            parent = models.ForeignKey(Parent, on_delete=models.CASCADE, db_column='parent"ref')
+            class Meta:
+                app_label = "quoted_contract"
+                db_table = 'child"table'
+        with connection.schema_editor() as editor:
+            editor.create_model(Parent)
+            editor.create_model(Child)
+        try:
+            parent = Parent.objects.create(title="match")
+            Child.objects.create(parent=parent)
+            joined = Child.objects.select_related("parent").get()
+            self.assertEqual(joined.parent.title, "match")
+            query = Parent.objects.annotate(present=models.Exists(
+                Child.objects.filter(parent_id=models.OuterRef("pk"))))
+            self.assertEqual(list(query.values_list("title", "present")), [("match", True)])
+        finally:
+            with connection.schema_editor() as editor:
+                editor.delete_model(Child)
+                editor.delete_model(Parent)

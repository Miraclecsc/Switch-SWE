+import asyncio
+import contextvars
+from django.dispatch import Signal
+from django.test import SimpleTestCase
+
+
+class NestedDispatchContextTests(SimpleTestCase):
+    async def assert_nested_visibility(self, robust=False):
+        outer, inner = Signal(), Signal()
+        value = contextvars.ContextVar("nested-value", default="initial")
+        inner_ready, outer_changed = asyncio.Event(), asyncio.Event()
+        inner_changed, allow_return = asyncio.Event(), asyncio.Event()
+
+        async def inner_receiver(**kwargs):
+            inner_ready.set()
+            await outer_changed.wait()
+            self.assertEqual(value.get(), "outer")
+            value.set("inner")
+            inner_changed.set()
+            await allow_return.wait()
+            if robust:
+                raise ValueError("receiver failure")
+            return "nested-result"
+
+        async def enter_inner(**kwargs):
+            method = inner.asend_robust if robust else inner.asend
+            result = await method(self)
+            if robust:
+                self.assertIsInstance(result[0][1], ValueError)
+            else:
+                self.assertEqual(result, [(inner_receiver, "nested-result")])
+            return "outer-result"
+
+        async def sibling(**kwargs):
+            await inner_ready.wait()
+            value.set("outer")
+            outer_changed.set()
+            # In robust mode a failed assertion is wrapped, so use a bounded
+            # wait to report a behavioral failure instead of deadlocking.
+            await asyncio.wait_for(inner_changed.wait(), 1)
+            self.assertEqual(value.get(), "inner")
+            allow_return.set()
+            return "sibling-result"
+
+        inner.connect(inner_receiver)
+        outer.connect(enter_inner)
+        outer.connect(sibling)
+        with self.assertLogs("django.dispatch", "ERROR") if robust else _Noop():
+            result = await outer.asend(self)
+        self.assertEqual(result, [(enter_inner, "outer-result"), (sibling, "sibling-result")])
+        self.assertEqual(value.get(), "inner")
+
+    async def test_nested_dispatch_shares_live_values_bidirectionally(self):
+        await self.assert_nested_visibility()
+
+    async def test_nested_robust_failure_keeps_live_context_and_response_order(self):
+        await self.assert_nested_visibility(robust=True)
+
+    async def test_independent_top_level_tasks_keep_separate_contexts(self):
+        signal = Signal()
+        value = contextvars.ContextVar("isolated", default="caller")
+        barrier = asyncio.Event()
+        arrived = []
+        async def receiver(sender, **kwargs):
+            value.set(sender)
+            arrived.append(sender)
+            if len(arrived) == 2:
+                barrier.set()
+            await barrier.wait()
+            return value.get()
+        signal.connect(receiver)
+        async def invoke(name):
+            result = await signal.asend(name)
+            self.assertEqual(value.get(), name)
+            return result[0][1]
+        self.assertEqual(await asyncio.gather(invoke("left"), invoke("right")), ["left", "right"])
+        self.assertEqual(value.get(), "caller")
+
+    async def test_completed_dispatch_does_not_reuse_stale_context(self):
+        signal = Signal()
+        value = contextvars.ContextVar("sequential", default=0)
+        async def receiver(**kwargs):
+            value.set(value.get() + 1)
+            return value.get()
+        signal.connect(receiver)
+        self.assertEqual((await signal.asend(self))[0][1], 1)
+        value.set(40)
+        self.assertEqual((await signal.asend(self))[0][1], 41)
+        self.assertEqual(value.get(), 41)
+
+    async def test_exception_restores_changed_context_without_wrapping_single_error(self):
+        signal = Signal()
+        value = contextvars.ContextVar("failure-value", default=0)
+        error = ValueError("original")
+        async def receiver(**kwargs):
+            value.set(3)
+            raise error
+        signal.connect(receiver)
+        with self.assertRaises(ValueError) as caught:
+            await signal.asend(self)
+        self.assertIs(caught.exception, error)
+        self.assertEqual(value.get(), 3)
+
+
+class _Noop:
+    def __enter__(self):
+        return self
+    def __exit__(self, *args):
+        return False

+# Context ownership is carried by receiver tasks, never by a process global.
+_dispatch_context = contextvars.ContextVar("signal_dispatch_context", default=None)
+
+
+def _restore_context(context):
+    """
+    Check for changes in contextvars, and set them to the current
+    context for downstream consumers.
+    """
+    for cvar in context:
+        if cvar is _dispatch_context:
+            continue
+        cvalue = context.get(cvar)
+        try:
+            if cvar.get() != cvalue:
+                cvar.set(cvalue)
+        except LookupError:
+            cvar.set(cvalue)
+
+
+async def _run_parallel(*coros):
+    """
+    Execute multiple asynchronous coroutines in parallel,
+    sharing the current context between them.
+    """
+    context = _dispatch_context.get()
+    owns_context = context is None
+    if owns_context:
+        context = contextvars.copy_context()
+        context.run(_dispatch_context.set, context)
 

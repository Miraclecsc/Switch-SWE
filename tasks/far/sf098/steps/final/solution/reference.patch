+    def equation_with_symbols(self, x=None, y=None, z=None):
+        """Return an equation and its three unambiguous coordinate symbols."""
+        coordinates = [x, y, z]
+        occupied = {symbol.name for symbol in self.free_symbols}
+        explicit_names = set()
+        for index, value in enumerate(coordinates):
+            if value is None:
+                continue
+            if isinstance(value, str):
+                value = Symbol(value, real=True)
+            if not isinstance(value, Symbol):
+                raise TypeError("coordinate placeholders must be symbols or strings")
+            if value.name in occupied or value.name in explicit_names:
+                raise ValueError("coordinate names clash with plane parameters or each other")
+            explicit_names.add(value.name)
+            coordinates[index] = value
+        occupied.update(explicit_names)
+        for index, base in enumerate("xyz"):
+            if coordinates[index] is None:
+                name = base
+                suffix = 1
+                while name in occupied:
+                    name = base + "_" + str(suffix)
+                    suffix += 1
+                coordinates[index] = Symbol(name, real=True)
+                occupied.add(name)
+        return self.equation(*coordinates), tuple(coordinates)
+

+    """Remove directive syntax while preserving strings, comments and other source."""
+    from graphql import parse
+    from graphql.language.visitor import Visitor, visit, SKIP
+    from graphql.utilities import strip_ignored_characters
+
+    if not strip_ignored_characters(joined_type_defs):
+        return joined_type_defs
+    spans = []
+
+    class DirectiveRemovals(Visitor):
+        def enter_directive_definition(self, node, *_):
+            spans.append((node.loc.start, node.loc.end))
+            return SKIP
+
+        def enter_directive(self, node, *_):
+            if node.name.value not in _allowed_directives:
+                spans.append((node.loc.start, node.loc.end))
+
+    visit(parse(joined_type_defs), DirectiveRemovals())
+    for start, end in sorted(spans, reverse=True):
+        joined_type_defs = joined_type_defs[:start] + joined_type_defs[end:]
     return joined_type_defs
 
 

diff --git a/tests/test_sf052_timeout_notification.py b/tests/test_sf052_timeout_notification.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf052_timeout_notification.py
@@ -0,0 +1,64 @@
+
+import math
+import pytest
+from anyio import CancelScope, current_effective_deadline, fail_after, sleep
+pytestmark = pytest.mark.anyio
+
+async def test_callback_after_scope_exit_once_with_actual_deadline():
+    calls = []
+    with fail_after(100) as parent:
+        def notify(deadline):
+            calls.append((deadline, current_effective_deadline()))
+        with pytest.raises(TimeoutError):
+            with fail_after(0, on_timeout=notify) as scope:
+                await sleep(0)
+        assert calls == [(scope.deadline, parent.deadline)]
+
+async def test_no_callback_for_success_disabled_or_early_explicit_cancel():
+    calls = []
+    with fail_after(None, on_timeout=calls.append):
+        await sleep(0)
+    with fail_after(100, on_timeout=calls.append):
+        await sleep(0)
+    with fail_after(100, on_timeout=calls.append) as scope:
+        scope.cancel()
+        await sleep(0)
+    assert calls == []
+
+async def test_external_cancellation_is_not_a_timeout_notification():
+    calls = []
+    with CancelScope() as outer:
+        with fail_after(None, on_timeout=calls.append):
+            outer.cancel()
+            await sleep(0)
+    assert calls == []
+
+async def test_body_timeout_error_is_not_helper_timeout():
+    calls = []
+    error = TimeoutError("body")
+    with pytest.raises(TimeoutError) as caught:
+        with fail_after(None, on_timeout=calls.append):
+            raise error
+    assert caught.value is error and calls == []
+
+async def test_callback_error_chains_under_timeout():
+    cause = ValueError("notification failed")
+    def notify(deadline):
+        raise cause
+    with pytest.raises(TimeoutError) as caught:
+        with fail_after(0, on_timeout=notify):
+            await sleep(0)
+    assert caught.value.__cause__ is cause
+
+@pytest.mark.parametrize("value", [False, 3, "callback"])
+async def test_noncallable_rejected_before_body(value):
+    reached = False
+    with pytest.raises(TypeError):
+        with fail_after(1, on_timeout=value):
+            reached = True
+    assert not reached
+
+async def test_callback_return_does_not_swallow_timeout():
+    with pytest.raises(TimeoutError):
+        with fail_after(0, on_timeout=lambda deadline: True):
+            await sleep(0)

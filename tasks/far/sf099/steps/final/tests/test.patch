+++ b/sympy/matrices/expressions/tests/test_sf099_extension.py
@@ -0,0 +1,34 @@
+from sympy import symbols, MatrixSymbol, MatPow, ImmutableMatrix, I
+
+A=MatrixSymbol("A",2,2);B=MatrixSymbol("B",2,2)
+p=symbols("p",positive=True);r=symbols("r",real=True);n=symbols("n",integer=True);a=symbols("a")
+
+def test_positive_scalar_real_symbol():
+    original=MatPow(p*A*B,r)
+    result=original.doit(extract_symbolic_scalars=True)
+    assert result == p**r*MatPow(A*B,r)
+    assert result.doit(extract_symbolic_scalars=True) == result
+    assert original.doit() == original
+
+def test_nonzero_scalar_integer_symbol():
+    nz=symbols("nz",nonzero=True)
+    assert MatPow(nz*A*B,n).doit(extract_symbolic_scalars=True) == nz**n*MatPow(A*B,n)
+    assert MatPow(-2*A,n).doit(extract_symbolic_scalars=True) == (-2)**n*MatPow(A,n)
+
+def test_unsafe_assumptions_retained():
+    for base,exponent in [(a*A,r),(a*A,n),(-2*A,r),(p*A,I)]:
+        original=MatPow(base,exponent)
+        assert original.doit(extract_symbolic_scalars=True) == original
+
+def test_matrix_order_and_numeric_substitution():
+    original=MatPow(p*A*B,n)
+    result=original.doit(extract_symbolic_scalars=True)
+    assert result == p**n*MatPow(A*B,n)
+    assert result != p**n*MatPow(B*A,n)
+    values={p:3,n:2,A:ImmutableMatrix([[1,1],[0,1]]),B:ImmutableMatrix([[2,0],[1,1]])}
+    assert result.subs(values).doit() == original.subs(values).doit()
+
+def test_coefficient_free_and_default():
+    original=MatPow(A*B,n)
+    assert original.doit(extract_symbolic_scalars=True) == original
+    assert MatPow(p*A,n).doit() == MatPow(p*A,n)

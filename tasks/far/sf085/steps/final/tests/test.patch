diff --git a/tests/test_sf085_extension.py b/tests/test_sf085_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf085_extension.py
@@ -0,0 +1,43 @@
+import pytest
+from packaging import tags
+
+def patch_platform(monkeypatch, platform):
+    seen=[]
+    monkeypatch.setattr(tags.sysconfig,"get_platform",lambda:platform)
+    monkeypatch.setattr(tags._manylinux,"platform_tags",lambda arches:seen.append(("many",list(arches))) or iter(()))
+    monkeypatch.setattr(tags._musllinux,"platform_tags",lambda arches:seen.append(("musl",list(arches))) or iter(()))
+    return seen
+
+def test_live_pointer_width_and_lazy_start(monkeypatch):
+    seen=patch_platform(monkeypatch,"linux-aarch64")
+    probes=[]
+    size=[8]
+    monkeypatch.setattr(tags.struct,"calcsize",lambda fmt:probes.append(fmt) or size[0])
+    stream=tags._linux_platforms()
+    assert probes == []
+    size[0]=4
+    assert list(stream) == ["linux_armv8l","linux_armv7l"]
+    assert seen == [("many",["armv8l","armv7l"]),("musl",["armv8l","armv7l"])]
+    size[0]=8
+    assert list(tags._linux_platforms()) == ["linux_aarch64"]
+    assert probes == ["P","P"]
+
+@pytest.mark.parametrize("width,expected",[(True,"linux_i686"),(False,"linux_x86_64")])
+def test_explicit_top_level_override(monkeypatch,width,expected):
+    patch_platform(monkeypatch,"linux-x86_64")
+    monkeypatch.setattr(tags.platform,"system",lambda:"Linux")
+    def forbidden(fmt): raise AssertionError("explicit width probed")
+    monkeypatch.setattr(tags.struct,"calcsize",forbidden)
+    assert list(tags.platform_tags(is_32bit=width)) == [expected]
+
+def test_nonlinux_no_probe(monkeypatch):
+    patch_platform(monkeypatch,"custom-platform")
+    def forbidden(fmt): raise AssertionError("not Linux")
+    monkeypatch.setattr(tags.struct,"calcsize",forbidden)
+    assert list(tags._linux_platforms()) == ["custom_platform"]
+    monkeypatch.setattr(tags.platform,"system",lambda:"Custom")
+    assert list(tags.platform_tags(is_32bit=True)) == ["custom_platform"]
+
+def test_existing_explicit_linux_width(monkeypatch):
+    patch_platform(monkeypatch,"linux-x86_64")
+    assert list(tags._linux_platforms(is_32bit=True)) == ["linux_i686"]

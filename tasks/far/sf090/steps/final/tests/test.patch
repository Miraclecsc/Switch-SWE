diff --git a/trio/_core/_tests/test_sf090_extension.py b/trio/_core/_tests/test_sf090_extension.py
new file mode 100644
--- /dev/null
+++ b/trio/_core/_tests/test_sf090_extension.py
@@ -0,0 +1,56 @@
+import contextvars
+import queue
+import pytest
+import trio
+
+VAR=contextvars.ContextVar("sf090_context",default="unset")
+
+def drive(fn,context,after_start=lambda:None):
+    todo=queue.Queue();finished=[]
+    trio.lowlevel.start_guest_run(fn,context=context,run_sync_soon_threadsafe=todo.put,run_sync_soon_not_threadsafe=todo.put,done_callback=finished.append)
+    assert trio.lowlevel.current_trio_token() is not None
+    after_start()
+    while not finished:
+        todo.get(timeout=5)()
+    return finished[0].unwrap()
+
+def test_context_snapshot_main_and_system():
+    token=VAR.set("host")
+    supplied=contextvars.copy_context();supplied.run(VAR.set,"guest")
+    seen=[];ready=trio.Event()
+    async def system():
+        seen.append(VAR.get());ready.set()
+    async def main():
+        await ready.wait()
+        initial=VAR.get();VAR.set("changed-in-task")
+        return initial
+    def after():
+        assert seen == [] and VAR.get() == "host"
+        supplied.run(VAR.set,"changed-after-start")
+        trio.lowlevel.spawn_system_task(system)
+    try:
+        assert drive(main,supplied,after) == "guest"
+        assert seen == ["guest"] and VAR.get() == "host"
+        assert supplied.get(VAR) == "changed-after-start"
+    finally:
+        VAR.reset(token)
+
+def test_active_context_can_be_supplied():
+    supplied=contextvars.copy_context();supplied.run(VAR.set,"active")
+    async def main(): return VAR.get()
+    assert supplied.run(drive,main,supplied) == "active"
+
+def test_error_delivery_and_next_run():
+    error=ValueError("guest failure")
+    async def main(): raise error
+    with pytest.raises(ValueError) as caught:
+        drive(main,contextvars.Context())
+    assert caught.value is error
+    async def normal(): return 42
+    assert trio.run(normal) == 42
+
+def test_invalid_context_does_not_install_runner():
+    async def main(): return 3
+    with pytest.raises(TypeError):
+        trio.lowlevel.start_guest_run(main,context={},run_sync_soon_threadsafe=lambda fn:None,done_callback=lambda result:None)
+    assert trio.run(main)==3

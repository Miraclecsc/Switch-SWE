diff --git a/pandas/tests/test_sf048_monotonic_skipna.py b/pandas/tests/test_sf048_monotonic_skipna.py
new file mode 100644
--- /dev/null
+++ b/pandas/tests/test_sf048_monotonic_skipna.py
@@ -0,0 +1,31 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.core.algorithms import is_monotonic
+from pandas.core.arrays.base import ExtensionArray
+
+def test_numeric_skipna_preserves_order_and_input():
+    values=np.array([1.,np.nan,2.,3.]);before=values.copy()
+    assert is_monotonic(values,skipna=True)==(True,False,True)
+    assert is_monotonic(values)[:2]==(False,False)
+    np.testing.assert_equal(values,before)
+
+def test_time_like_nat_filtering():
+    values=np.array(['2020-01-01','NaT','2020-01-03'],dtype='datetime64[ns]')
+    assert is_monotonic(values,skipna=True)==(True,False,True)
+
+@pytest.mark.parametrize('dtype,values,expected', [('Int64',[2,None,1],(False,True)),('boolean',[False,None,True],(True,False))])
+def test_extension_mask_before_argsort_values(dtype,values,expected):
+    array=pd.array(values,dtype=dtype)
+    assert ExtensionArray._monotonic_check(array,skipna=True)==expected
+    assert ExtensionArray._monotonic_check(array)==(False,False)
+
+def test_all_missing_and_duplicates():
+    assert is_monotonic(np.array([np.nan,np.nan]),skipna=True)==(True,True,True)
+    assert is_monotonic(np.array([1.,np.nan,1.]),skipna=True)==(True,True,False)
+
+def test_nonorderable_remaining_values():
+    values=np.array([1+2j,2+3j])
+    with pytest.raises(TypeError):is_monotonic(values,skipna=True)
+    array=pd.array(values)
+    assert ExtensionArray._monotonic_check(array,skipna=True)==(False,False)

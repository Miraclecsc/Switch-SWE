@@ -0,0 +1,55 @@
+from textual import events
+from textual.app import App,ComposeResult
+from textual.pilot import _get_mouse_message_arguments
+from textual.widgets import Label
+
+class ClickApp(App):
+    CLICK_CHAIN_TIME_THRESHOLD=1000
+    CSS='Label {width: 10; height: 3;}'
+    def __init__(self):
+        super().__init__();self.chains=[]
+    def compose(self)->ComposeResult:yield Label('target',id='target')
+    def on_click(self,event:events.Click):self.chains.append(event.chain)
+
+async def raw(pilot,button=1,ctrl=False):
+    kwargs=_get_mouse_message_arguments(pilot.app.query_one('#target'))
+    kwargs.update(button=button,ctrl=ctrl)
+    pilot.app.post_message(events.MouseDown(**kwargs))
+    pilot.app.post_message(events.MouseUp(**kwargs))
+    await pilot.pause()
+
+async def test_pilot_multi_click_and_boolean_wrappers():
+    app=ClickApp()
+    async with app.run_test() as pilot:
+        assert await pilot.double_click('#target') is True
+        assert app.chains==[1,2]
+        app.chains.clear()
+        assert await pilot.triple_click('#target') is True
+        assert app.chains==[1,2,3]
+
+async def test_button_and_modifier_changes_break_chain():
+    app=ClickApp()
+    async with app.run_test() as pilot:
+        await raw(pilot);await raw(pilot,button=2);await raw(pilot,button=2);await raw(pilot,button=2,ctrl=True)
+        assert app.chains==[1,1,2,1]
+
+async def test_duplicate_and_mismatched_releases_do_not_click():
+    app=ClickApp()
+    async with app.run_test() as pilot:
+        await raw(pilot)
+        kwargs=_get_mouse_message_arguments(app.query_one('#target'))
+        app.post_message(events.MouseUp(**kwargs));await pilot.pause()
+        assert app.chains==[1]
+        app.post_message(events.MouseDown(**kwargs))
+        app.post_message(events.MouseUp(**dict(kwargs,button=2)))
+        app.post_message(events.MouseUp(**kwargs));await pilot.pause()
+        assert app.chains==[1]
+
+async def test_replacing_widget_at_same_position_starts_new_chain():
+    app=ClickApp()
+    async with app.run_test() as pilot:
+        await raw(pilot)
+        await app.query_one('#target').remove()
+        await app.mount(Label('replacement',id='target'))
+        await pilot.pause();await raw(pilot)
+        assert app.chains==[1,1]

diff --git a/tests/signing/test_algorithm_migration_v1.py b/tests/signing/test_algorithm_migration_v1.py
new file mode 100644
index 0000000000..0289b384fa
--- /dev/null
+++ b/tests/signing/test_algorithm_migration_v1.py
@@ -0,0 +1,57 @@
+from unittest.mock import patch
+from django.core import signing
+from django.test import SimpleTestCase
+
+
+class AlgorithmMigrationTests(SimpleTestCase):
+    def migrating(self, cls=signing.Signer, **kwargs):
+        try:
+            return cls(**kwargs)
+        except TypeError as exc:
+            self.fail(f"Explicit algorithm migration configuration is required: {exc}")
+
+    def test_old_algorithm_and_old_key_combinations_verify(self):
+        reader = self.migrating(key="new-key", fallback_keys=["old-key"],
+            algorithm="sha256", fallback_algorithms=["sha1"], salt="migration")
+        for key in ["new-key", "old-key"]:
+            for algorithm in ["sha256", "sha1"]:
+                value = signing.Signer(key=key, algorithm=algorithm, salt="migration").sign("payload")
+                self.assertEqual(reader.unsign(value), "payload")
+
+    def test_signing_uses_primary_algorithm_and_copies_fallback_configuration(self):
+        algorithms = ["sha1"]
+        signer = self.migrating(key="key", salt="migration", algorithm="sha256",
+                               fallback_algorithms=algorithms)
+        algorithms.clear()
+        old = signing.Signer(key="key", salt="migration", algorithm="sha1").sign("value")
+        self.assertEqual(signer.unsign(old), "value")
+        self.assertEqual(signer.sign("value"), signing.Signer(
+            key="key", salt="migration", algorithm="sha256").sign("value"))
+
+    def test_fallback_does_not_accept_tampering_wrong_salt_or_unlisted_algorithm(self):
+        reader = self.migrating(key="key", salt="migration", fallback_algorithms=["sha1"])
+        for value in [
+            signing.Signer(key="key", salt="different", algorithm="sha1").sign("value"),
+            signing.Signer(key="key", salt="migration", algorithm="sha512").sign("value"),
+            signing.Signer(key="key", salt="migration", algorithm="sha1").sign("value") + "x",
+        ]:
+            with self.assertRaises(signing.BadSignature):
+                reader.unsign(value)
+
+    def test_timestamp_and_compressed_object_checks_still_apply(self):
+        old = signing.TimestampSigner(key="key", salt="migration", algorithm="sha1")
+        reader = self.migrating(signing.TimestampSigner, key="key", salt="migration",
+                                fallback_algorithms=["sha1"])
+        obj = {"message": "repeated-" * 100}
+        with patch("django.core.signing.time.time", return_value=1000):
+            signed = old.sign_object(obj, compress=True)
+        with patch("django.core.signing.time.time", return_value=1005):
+            self.assertEqual(reader.unsign_object(signed, max_age=10), obj)
+        with patch("django.core.signing.time.time", return_value=1011):
+            with self.assertRaises(signing.SignatureExpired):
+                reader.unsign_object(signed, max_age=10)
+
+    def test_default_signer_does_not_implicitly_accept_sha1(self):
+        old = signing.Signer(key="key", salt="migration", algorithm="sha1")
+        with self.assertRaises(signing.BadSignature):
+            signing.Signer(key="key", salt="migration").unsign(old.sign("value"))

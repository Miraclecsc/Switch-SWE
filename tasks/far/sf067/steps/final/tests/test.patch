diff --git a/networkx/algorithms/tests/test_sf067_required_cds.py b/networkx/algorithms/tests/test_sf067_required_cds.py
new file mode 100644
--- /dev/null
+++ b/networkx/algorithms/tests/test_sf067_required_cds.py
@@ -0,0 +1,50 @@
+
+import pytest
+import networkx as nx
+
+class Once:
+    def __init__(self, values):
+        self.values = values
+        self.calls = 0
+    def __iter__(self):
+        self.calls += 1
+        assert self.calls == 1
+        return iter(self.values)
+
+@pytest.mark.parametrize("graph,required", [(nx.path_graph(8), [0, 7, 0]),
+    (nx.star_graph(6), [2, 5]), (nx.cycle_graph(8), [0, 4])])
+def test_required_vertices_form_connected_dominating_set(graph, required):
+    before = list(graph.edges())
+    values = Once(required)
+    result = nx.connected_dominating_set(graph, required=values)
+    assert set(required) <= result <= set(graph)
+    assert nx.is_connected(graph.subgraph(result))
+    assert nx.is_dominating_set(graph, result)
+    assert list(graph.edges()) == before
+    assert values.calls == 1
+    assert nx.is_connected_dominating_set(graph, Once(list(result) + list(result)))
+
+def test_predicate_materializes_generator_once():
+    graph = nx.path_graph(4)
+    assert nx.is_connected_dominating_set(graph, Once([1, 2]))
+    assert not nx.is_connected_dominating_set(graph, Once([0, 3]))
+    assert not nx.is_connected_dominating_set(graph, Once([1, 2, 100]))
+
+def test_empty_and_singleton_contract():
+    assert nx.connected_dominating_set(nx.Graph(), required=[]) == set()
+    assert nx.is_connected_dominating_set(nx.Graph(), iter([]))
+    assert not nx.is_connected_dominating_set(nx.path_graph(1), iter([]))
+    assert nx.connected_dominating_set(nx.path_graph(1), required=[0]) == {0}
+
+def test_unknown_required_and_disconnected_graphs():
+    with pytest.raises(nx.NetworkXError):
+        nx.connected_dominating_set(nx.path_graph(3), required=[9])
+    with pytest.raises(nx.NetworkXError):
+        nx.connected_dominating_set(nx.empty_graph(3), required=[0])
+
+def test_unsortable_labels_and_default_behavior():
+    labels = ["start", 17, ("tuple",), object()]
+    graph = nx.path_graph(labels)
+    result = nx.connected_dominating_set(graph, required=Once([labels[0], labels[-1]]))
+    assert nx.is_connected_dominating_set(graph, result)
+    assert nx.connected_dominating_set(graph, required=[]) == nx.connected_dominating_set(graph)

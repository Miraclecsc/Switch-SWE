@@ -0,0 +1,57 @@
+import traceback
+import pytest
+from starlette.applications import Starlette
+from starlette.middleware import Middleware
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.routing import Route
+
+class FalseyError(Exception):
+    def __bool__(self):
+        return False
+
+class PassThrough(BaseHTTPMiddleware):
+    async def dispatch(self, request, call_next):
+        return await call_next(request)
+
+@pytest.mark.parametrize('layers',[1,3])
+@pytest.mark.parametrize('mode',['suppressed','falsey','implicit'])
+def test_original_application_exception_graph(test_client_factory,layers,mode):
+    context=ValueError('application-context')
+    cause=FalseyError('explicit-cause')
+    outer=RuntimeError('outer-error')
+    outer.marker=object()
+    outer.add_note('keep this note')
+    marker=outer.marker
+    async def endpoint(request):
+        try:
+            raise context
+        except ValueError:
+            if mode=='suppressed':
+                raise outer from None
+            if mode=='falsey':
+                raise outer from cause
+            raise outer
+    app=Starlette(routes=[Route('/',endpoint)],middleware=[Middleware(PassThrough) for _ in range(layers)])
+    with pytest.raises(RuntimeError) as caught:
+        test_client_factory(app).get('/')
+    actual=caught.value
+    assert actual is outer
+    assert actual.marker is marker
+    assert actual.__notes__==['keep this note']
+    assert actual.__context__ is context
+    assert actual.__cause__ is (None if mode=='suppressed' else cause if mode=='falsey' else context)
+    assert context.__cause__ is None and context.__context__ is None
+    assert cause.__cause__ is None and cause.__context__ is None
+    text=''.join(traceback.format_exception(actual))
+    assert 'EndOfStream' not in text
+    if mode=='suppressed':assert 'application-context' not in text
+
+@pytest.mark.parametrize('layers',[1,2])
+def test_no_context_retains_original_compatibility(test_client_factory,layers):
+    error=RuntimeError('plain')
+    async def endpoint(request): raise error
+    app=Starlette(routes=[Route('/',endpoint)],middleware=[Middleware(PassThrough) for _ in range(layers)])
+    with pytest.raises(RuntimeError) as caught:test_client_factory(app).get('/')
+    assert caught.value is error
+    assert error.__cause__ is None
+    assert error.__suppress_context__ is True

+from collections import Counter
+import copy
+import boto3
+import pytest
+from botocore.exceptions import ClientError
+from moto import mock_aws
+
+def setup(strategy=None):
+    client=boto3.client('ecs',region_name='us-east-1')
+    kwargs={'clusterName':'weighted'}
+    if strategy is not None:kwargs.update(capacityProviders=['FARGATE','FARGATE_SPOT'],defaultCapacityProviderStrategy=strategy)
+    client.create_cluster(**kwargs)
+    client.register_task_definition(family='task',containerDefinitions=[{'name':'worker','image':'local','cpu':128,'memory':128}])
+    return client
+
+@mock_aws
+def test_zero_weight_is_never_selected():
+    client=setup();strategy=[{'capacityProvider':'FARGATE','weight':0},{'capacityProvider':'FARGATE_SPOT','weight':1}]
+    saved=copy.deepcopy(strategy)
+    result=client.run_task(cluster='weighted',taskDefinition='task',count=4,capacityProviderStrategy=strategy)
+    assert Counter(t['capacityProviderName'] for t in result['tasks'])=={'FARGATE_SPOT':4}
+    assert strategy==saved
+
+@mock_aws
+def test_base_then_proportional_remainder_and_persistence():
+    client=setup();strategy=[{'capacityProvider':'FARGATE','weight':1,'base':2},{'capacityProvider':'FARGATE_SPOT','weight':3}]
+    result=client.run_task(cluster='weighted',taskDefinition='task',count=10,capacityProviderStrategy=strategy)
+    assert Counter(t['capacityProviderName'] for t in result['tasks'])=={'FARGATE':4,'FARGATE_SPOT':6}
+    assert all(not t.get('containerInstanceArn') and not t.get('launchType') for t in result['tasks'])
+    described=client.describe_tasks(cluster='weighted',tasks=[t['taskArn'] for t in result['tasks']])
+    assert Counter(t['capacityProviderName'] for t in described['tasks'])=={'FARGATE':4,'FARGATE_SPOT':6}
+
+@mock_aws
+def test_default_strategy_uses_same_allocation():
+    client=setup([{'capacityProvider':'FARGATE','weight':1},{'capacityProvider':'FARGATE_SPOT','weight':1}])
+    tasks=client.run_task(cluster='weighted',taskDefinition='task',count=4)['tasks']
+    assert Counter(t['capacityProviderName'] for t in tasks)=={'FARGATE':2,'FARGATE_SPOT':2}
+
+@pytest.mark.parametrize('strategy',[
+ [{'capacityProvider':'FARGATE','weight':0},{'capacityProvider':'FARGATE_SPOT','weight':0}],
+ [{'capacityProvider':'FARGATE','weight':1,'base':1},{'capacityProvider':'FARGATE_SPOT','weight':1,'base':1}],
+ [{'capacityProvider':'FARGATE','weight':1},{'capacityProvider':'FARGATE','weight':1}],
+ [{'capacityProvider':'FARGATE','weight':1},{'capacityProvider':'custom-ec2','weight':1}],
+])
+@mock_aws
+def test_invalid_strategy_does_not_create_tasks(strategy):
+    client=setup()
+    before=client.list_tasks(cluster='weighted')['taskArns']
+    with pytest.raises(ClientError) as error:client.run_task(cluster='weighted',taskDefinition='task',count=3,capacityProviderStrategy=strategy)
+    assert error.value.response['Error']['Code']=='InvalidParameterException'
+    assert client.list_tasks(cluster='weighted')['taskArns']==before

diff --git a/tests/test_bedrockagentcorecontrol/test_gateway_retries_v1.py b/tests/test_bedrockagentcorecontrol/test_gateway_retries_v1.py
new file mode 100644
index 000000000..3876dd833
--- /dev/null
+++ b/tests/test_bedrockagentcorecontrol/test_gateway_retries_v1.py
@@ -0,0 +1,79 @@
+import boto3
+import pytest
+from botocore.exceptions import ClientError
+from moto import mock_aws
+
+
+def client(region="us-east-1"):
+    return boto3.client("bedrock-agentcore-control",region_name=region)
+
+
+def gateway(c, token="gateway-retry-token-000000000000000001", **kwargs):
+    params = dict(name="retry-gateway", roleArn="arn:aws:iam::123456789012:role/Gateway",
+                  protocolType="MCP", authorizerType="NONE", clientToken=token)
+    params.update(kwargs)
+    return c.create_gateway(**params)
+
+
+def target(c, gid, token="target-retry-token-0000000000000000001", **kwargs):
+    params = dict(gatewayIdentifier=gid, name="retry-target", clientToken=token,
+        targetConfiguration={"mcp":{"mcpServer":{"endpoint":"https://example.com/mcp"}}},
+        credentialProviderConfigurations=[{"credentialProviderType":"GATEWAY_IAM_ROLE"}])
+    params.update(kwargs)
+    return c.create_gateway_target(**params)
+
+
+@mock_aws
+def test_gateway_retry_and_conflicting_payload():
+    c = client()
+    first = gateway(c,tags={"a":"1","b":"2"})
+    second = gateway(c,tags={"b":"2","a":"1"})
+    assert first["gatewayId"] == second["gatewayId"]
+    assert first["createdAt"] == second["createdAt"]
+    with pytest.raises(ClientError) as caught:
+        gateway(c,name="different",tags={"a":"1","b":"2"})
+    assert caught.value.response["Error"]["Code"] == "ConflictException"
+    assert len(c.list_gateways()["items"]) == 1
+
+
+@mock_aws
+def test_gateway_replay_is_original_snapshot_and_never_resurrects_deleted_resource():
+    c = client()
+    first = gateway(c,description="initial")
+    gid = first["gatewayId"]
+    c.update_gateway(gatewayIdentifier=gid,name="updated",
+        roleArn="arn:aws:iam::123456789012:role/Gateway",protocolType="MCP",authorizerType="NONE",description="changed")
+    replay = gateway(c,description="initial")
+    assert replay["gatewayId"] == gid and replay["name"] == first["name"]
+    assert c.get_gateway(gatewayIdentifier=gid)["description"] == "changed"
+    c.delete_gateway(gatewayIdentifier=gid)
+    assert gateway(c,description="initial")["gatewayId"] == gid
+    assert c.list_gateways()["items"] == []
+
+
+@mock_aws
+def test_target_retry_is_scoped_to_parent_and_rejects_changes():
+    c = client()
+    one = gateway(c)["gatewayId"]
+    two = gateway(c,token="second-gateway-token-00000000000000001")["gatewayId"]
+    first = target(c,one)
+    assert target(c,one)["targetId"] == first["targetId"]
+    assert target(c,two)["targetId"] != first["targetId"]
+    with pytest.raises(ClientError) as caught:
+        target(c,one,name="different")
+    assert caught.value.response["Error"]["Code"] == "ConflictException"
+    c.delete_gateway_target(gatewayIdentifier=one,targetId=first["targetId"])
+    assert target(c,one)["targetId"] == first["targetId"]
+    assert c.list_gateway_targets(gatewayIdentifier=one)["items"] == []
+
+
+@mock_aws
+def test_tokens_are_region_scoped():
+    east, west = client(), client("us-west-2")
+    assert gateway(east)["gatewayId"] != gateway(west)["gatewayId"]
+
+
+@mock_aws
+def test_distinct_tokens_still_create_distinct_resources():
+    c = client()
+    assert gateway(c)["gatewayId"] != gateway(c,token="different-token-000000000000000000001")["gatewayId"]

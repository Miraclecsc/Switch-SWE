diff --git a/tests/test_sf054_start_deadline.py b/tests/test_sf054_start_deadline.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf054_start_deadline.py
@@ -0,0 +1,79 @@
+
+import math
+import pytest
+import anyio
+
+pytestmark = pytest.mark.anyio
+
+async def test_start_timeout_joins_cleanup_and_group_survives():
+    events = []
+    async def pending(*, task_status):
+        try:
+            await anyio.sleep_forever()
+        finally:
+            with anyio.CancelScope(shield=True):
+                await anyio.sleep(0)
+                events.append("joined")
+    async def ready(value, *, task_status):
+        task_status.started(value)
+    async with anyio.create_task_group() as tg:
+        with pytest.raises(TimeoutError):
+            await tg.start(pending, deadline=anyio.current_time() + 0.03)
+        assert events == ["joined"]
+        assert not tg.cancel_scope.cancel_called
+        assert await tg.start(ready, "next", deadline=anyio.current_time() + 10) == "next"
+
+async def test_ready_child_not_cancelled_when_start_deadline_later_expires():
+    release = anyio.Event()
+    done = []
+    async def service(*, task_status):
+        task_status.started("ready")
+        await release.wait()
+        done.append("completed")
+    async with anyio.create_task_group() as tg:
+        assert await tg.start(service, deadline=anyio.current_time() + 0.02) == "ready"
+        await anyio.sleep(0.04)
+        release.set()
+    assert done == ["completed"]
+
+@pytest.mark.parametrize("deadline,exception", [
+    (-math.inf, TimeoutError), (0, TimeoutError), (math.nan, ValueError),
+    ("later", TypeError), (True, TypeError),
+])
+async def test_invalid_or_expired_deadline_never_invokes_child(deadline, exception):
+    called = []
+    async def ready(*, task_status):
+        called.append(True)
+        task_status.started()
+    async with anyio.create_task_group() as tg:
+        with pytest.raises(exception):
+            await tg.start(ready, deadline=deadline)
+        assert not called
+        await tg.start(ready)
+        assert called == [True]
+
+async def test_outer_cancel_is_not_timeout_and_joins_child():
+    cleanup = []
+    async def pending(*, task_status):
+        try:
+            await anyio.sleep_forever()
+        finally:
+            cleanup.append(True)
+    async with anyio.create_task_group() as tg:
+        with anyio.move_on_after(0.02) as parent:
+            await tg.start(pending, deadline=anyio.current_time() + 10)
+        assert parent.cancelled_caught
+        assert cleanup == [True]
+        assert not tg.cancel_scope.cancel_called
+
+async def test_startup_error_preserves_identity_and_group_reusable():
+    error = ValueError("startup")
+    async def broken(*, task_status):
+        raise error
+    async def good(*, task_status):
+        task_status.started(42)
+    async with anyio.create_task_group() as tg:
+        with pytest.raises(ValueError) as caught:
+            await tg.start(broken, deadline=anyio.current_time() + 10)
+        assert caught.value is error
+        assert await tg.start(good, deadline=math.inf) == 42

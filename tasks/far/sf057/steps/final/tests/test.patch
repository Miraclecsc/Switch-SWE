diff --git a/tests/test_sf057_start_value_release.py b/tests/test_sf057_start_value_release.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf057_start_value_release.py
@@ -0,0 +1,71 @@
+
+import gc
+import weakref
+import pytest
+import anyio
+
+pytestmark = pytest.mark.anyio
+
+@pytest.fixture(params=["asyncio", ("asyncio", {"use_uvloop": True})],
+                ids=["asyncio", "uvloop"])
+def anyio_backend(request):
+    return request.param
+
+class Payload:
+    pass
+
+async def test_live_service_does_not_retain_delivered_start_value():
+    release = anyio.Event()
+    statuses = []
+    async def service(*, task_status):
+        statuses.append(task_status)
+        task_status.started(Payload())
+        await release.wait()
+    async with anyio.create_task_group() as tg:
+        value = await tg.start(service)
+        weak = weakref.ref(value)
+        del value
+        await anyio.sleep(0)
+        gc.collect()
+        assert weak() is None
+        with pytest.raises(RuntimeError, match="started.*twice"):
+            statuses[0].started(Payload())
+        release.set()
+
+async def test_many_handshakes_release_independently():
+    release = anyio.Event()
+    async def service(*, task_status):
+        task_status.started(Payload())
+        await release.wait()
+    async with anyio.create_task_group() as tg:
+        weak = []
+        for _ in range(5):
+            value = await tg.start(service)
+            weak.append(weakref.ref(value))
+            del value
+        await anyio.sleep(0)
+        gc.collect()
+        assert all(ref() is None for ref in weak)
+        release.set()
+
+async def test_failure_before_and_after_readiness_preserves_exception():
+    before = ValueError("before")
+    after = RuntimeError("after")
+    trigger = anyio.Event()
+    async def bad_start(*, task_status):
+        raise before
+    async def later(*, task_status):
+        task_status.started(Payload())
+        await trigger.wait()
+        raise after
+    try:
+        async with anyio.create_task_group() as tg:
+            with pytest.raises(ValueError) as caught:
+                await tg.start(bad_start)
+            assert caught.value is before
+            await tg.start(later)
+            trigger.set()
+    except ExceptionGroup as group:
+        assert group.exceptions == (after,)
+    else:
+        pytest.fail("child failure was lost")

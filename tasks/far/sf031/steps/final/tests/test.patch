+import pytest
+from sympy import S, Symbol, cos, sin, pi, simplify, symbols
+from sympy.vector import CoordSys3D, express
+
+def equivalent(actual, expected):
+    assert isinstance(actual,tuple) and len(actual)==3
+    assert all(simplify(a-b)==0 for a,b in zip(actual,expected))
+
+def test_point_identity_and_translation():
+    a=CoordSys3D('A'); b=a.locate_new('B',2*a.i-3*a.j+5*a.k)
+    x,y,z=symbols('x y z')
+    equivalent(a.transform_point_to(a,(x,y,z)),(x,y,z))
+    equivalent(b.transform_point_to(a,(x,y,z)),(x+2,y-3,z+5))
+    equivalent(a.transform_point_to(b,(x,y,z)),(x-2,y+3,z-5))
+
+def test_affine_sibling_rotation_and_roundtrip():
+    a=CoordSys3D('A')
+    b=a.create_new('B',transformation=lambda x,y,z:(2*x,z,-3*y))
+    c=a.orient_new_axis('C',pi/2,a.k).locate_new('D',a.i+2*a.j)
+    x,y,z=symbols('x y z')
+    point=(x,y,z)
+    mapped=b.transform_point_to(c,point)
+    equivalent(c.transform_point_to(b,mapped),point)
+    equivalent(b.transform_point_to(a,point),(2*x,z,-3*y))
+
+def test_permutation_substitution_is_simultaneous():
+    a=CoordSys3D('A');b=a.create_new('B',transformation=lambda x,y,z:(y,z,x))
+    bx,by,bz=b.base_scalars()
+    equivalent(b.transform_point_to(a,b.base_scalars()),(by,bz,bx))
+    equivalent(a.transform_point_to(b,a.base_scalars()),(a.z,a.x,a.y))
+
+def test_nonlinear_forward_and_declared_inverse():
+    a=CoordSys3D('A');c=a.create_new('C',transformation='cylindrical')
+    equivalent(c.transform_point_to(a,(2,pi/2,4)),(0,2,4))
+    equivalent(a.transform_point_to(c,(0,2,4)),(2,pi/2,4))
+    b=a.create_new('B',transformation=lambda x,y,z:(x**2,y,z))
+    equivalent(b.transform_point_to(a,(3,4,5)),(9,4,5))
+
+def test_ambiguous_inverse_is_rejected():
+    a=CoordSys3D('A');b=a.create_new('B',transformation=lambda x,y,z:(x**2,y,z))
+    with pytest.raises(ValueError,match='unique inverse'):a.transform_point_to(b,(4,2,3))
+
+@pytest.mark.parametrize('point', [(),(1,2),(1,2,3,4)])
+def test_wrong_coordinate_count(point):
+    a=CoordSys3D('A')
+    with pytest.raises(ValueError):a.transform_point_to(a,point)
+
+def test_target_validation_and_disconnected_tree():
+    a=CoordSys3D('A');b=CoordSys3D('B')
+    with pytest.raises(TypeError):a.transform_point_to('B',(1,2,3))
+    with pytest.raises(ValueError):a.transform_point_to(b,(1,2,3))
+
+def test_original_vector_rotation_regression():
+    a=CoordSys3D('A');b=a.orient_new_axis('B',pi/2,a.k)
+    assert express(b.i,a)==a.j

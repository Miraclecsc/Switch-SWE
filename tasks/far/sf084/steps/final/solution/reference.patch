+def mac_platforms(version=None, arch=None, minimum_version=None, binary_formats=None):
+    """Generate compatible deployment tags within an optional selection policy."""
+    allowed = None
+    if binary_formats is not None:
+        allowed = {binary_formats} if isinstance(binary_formats, str) else set(binary_formats)
+        if not allowed:
+            return
+    floor = tuple(minimum_version) if minimum_version is not None else None
+    if floor is not None and floor >= (11, 0):
+        floor = (floor[0], 0)
+    for tag in _mac_platforms_unbounded(version, arch):
+        _, major, minor, binary_format = tag.split("_", 3)
+        if floor is not None and (int(major), int(minor)) < floor:
+            continue
+        if allowed is None or binary_format in allowed:
+            yield tag
+

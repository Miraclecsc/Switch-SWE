diff --git a/tests/test_sf084_extension.py b/tests/test_sf084_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf084_extension.py
@@ -0,0 +1,34 @@
+from packaging import tags
+
+def test_big_sur_floor_normalization():
+    result=list(tags.mac_platforms((12,3), "x86_64", minimum_version=(11,7)))
+    assert result and result == [x for x in tags.mac_platforms((12,3),"x86_64") if x.startswith(("macosx_12_0_","macosx_11_0_"))]
+
+def test_legacy_floor():
+    result=list(tags.mac_platforms((11,1),"x86_64",minimum_version=(10,15),binary_formats="x86_64"))
+    assert result == ["macosx_11_0_x86_64","macosx_10_16_x86_64","macosx_10_15_x86_64"]
+    assert list(tags.mac_platforms((10,14),"x86_64",minimum_version=(10,15))) == []
+
+def test_explicit_target_without_host(monkeypatch):
+    def forbidden(): raise AssertionError("host queried for explicit target")
+    monkeypatch.setattr(tags.platform,"mac_ver",forbidden)
+    assert list(tags.mac_platforms((11,2),"riscv",minimum_version=(11,0))) == ["macosx_11_0_riscv"]
+
+def test_empty_filter_short_circuit(monkeypatch):
+    def forbidden(): raise AssertionError("host queried for empty stream")
+    monkeypatch.setattr(tags.platform,"mac_ver",forbidden)
+    assert list(tags.mac_platforms(binary_formats=[])) == []
+
+def test_one_shot_formats_and_order():
+    events=[]
+    def selection():
+        events.append("iterated")
+        yield "universal2"
+        yield "x86_64"
+    stream=tags.mac_platforms((12,1),"x86_64",minimum_version=(11,0),binary_formats=selection())
+    assert events == []
+    assert list(stream) == ["macosx_12_0_x86_64","macosx_12_0_universal2","macosx_11_0_x86_64","macosx_11_0_universal2"]
+    assert events == ["iterated"]
+
+def test_original_unknown_architecture():
+    assert list(tags.mac_platforms((11,0),"riscv")) == ["macosx_11_0_riscv"]

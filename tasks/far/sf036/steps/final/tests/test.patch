+++ b/tests/test_sf036_url_authority.py
@@ -0,0 +1,41 @@
+import pytest
+from starlette.datastructures import URL
+
+@pytest.mark.parametrize('scheme,port,expected',[('http',80,None),('https',443,None),('http',8080,8080),('ws',80,None)])
+def test_ipv6_server_scope(scheme,port,expected):
+    url=URL(scope={'scheme':scheme,'server':('2001:db8::7',port),'path':'plain','query_string':b'a=1','headers':[]})
+    assert url.hostname=='2001:db8::7' and url.port==expected
+    assert url.path=='/plain' and url.query=='a=1'
+
+@pytest.mark.parametrize('change,expected', [({'port':8080},'//:8080/path?q=1#frag'),({'username':'u'},'//u@/path?q=1#frag')])
+def test_relative_authority_legacy_compatibility(change,expected):
+    original=URL('/path?q=1#frag')
+    assert str(original.replace(**change))==expected
+    assert str(original)=='/path?q=1#frag'
+
+def test_relative_host_creation_and_empty_field_clearing():
+    original=URL('/path?q=1#frag')
+    assert original.replace(port=None)==original
+    changed=original.replace(hostname='::1',port=8080)
+    assert changed.hostname=='::1' and changed.port==8080
+    assert (changed.path,changed.query,changed.fragment)==('/path','q=1','frag')
+
+def test_credentials_are_encoded_once_and_preserve_hostname():
+    original=URL('https://old:secret@example.org/path?q=1#frag')
+    changed=original.replace(username='user@realm',password='x:/?#%')
+    assert changed.hostname=='example.org'
+    assert changed.username=='user%40realm' and changed.password=='x%3A%2F%3F%23%25'
+    assert changed.replace(port=8443).password==changed.password
+    assert (changed.path,changed.query,changed.fragment)==('/path','q=1','frag')
+    assert original.username=='old'
+
+def test_ipv6_replacement_keeps_subclass_and_unchanged_credentials():
+    class Derived(URL):pass
+    original=Derived('https://u%40v:p%3Ax@[::1]:8443/path')
+    changed=original.replace(hostname='2001:db8::8',port=None)
+    assert isinstance(changed,Derived) and changed.hostname=='2001:db8::8'
+    assert changed.port is None and changed.username=='u%40v' and changed.password=='p%3Ax'
+
+def test_host_header_precedence_regression():
+    url=URL(scope={'scheme':'http','server':('::1',80),'headers':[(b'host',b'example.org')],'path':'path'})
+    assert str(url)=='http://example.org/path'

diff --git a/tests/auth_tests/test_credential_payload_v1.py b/tests/auth_tests/test_credential_payload_v1.py
new file mode 100644
index 0000000000..c4bd94f840
--- /dev/null
+++ b/tests/auth_tests/test_credential_payload_v1.py
@@ -0,0 +1,66 @@
+import sys
+from unittest.mock import AsyncMock, Mock, patch
+from django.contrib.auth.backends import ModelBackend
+from django.test import RequestFactory, SimpleTestCase, override_settings
+from django.views.debug import ExceptionReporter
+
+
+class CredentialPayloadRedactionTests(SimpleTestCase):
+    def setUp(self):
+        self.secret = "opaque-credential-value-019723"
+        self.password = "password-value-837209"
+
+    def report(self, exc_info):
+        request = RequestFactory().get("/login/")
+        reporter = ExceptionReporter(request, *exc_info)
+        return reporter.get_traceback_html() + "\n" + reporter.get_traceback_text()
+
+    @override_settings(DEBUG=False)
+    def test_sync_backend_redacts_arbitrary_nested_credential_payloads(self):
+        model = Mock()
+        model.DoesNotExist = type("DoesNotExist", (Exception,), {})
+        model._default_manager.get_by_natural_key.side_effect = TypeError("lookup failed")
+        with patch("django.contrib.auth.backends.UserModel", model):
+            try:
+                ModelBackend().authenticate(None, username="diagnostic-user", password=self.password,
+                    opaque=self.secret, credentials_payload={"proof":self.secret})
+            except TypeError:
+                report = self.report(sys.exc_info())
+            else:
+                self.fail("Expected the lookup error")
+        self.assertNotIn(self.password, report)
+        self.assertNotIn(self.secret, report)
+        self.assertIn("diagnostic-user", report)
+        self.assertIn("lookup failed", report)
+
+    @override_settings(DEBUG=False)
+    async def test_async_backend_redacts_arbitrary_nested_credential_payloads(self):
+        model = Mock()
+        model.DoesNotExist = type("DoesNotExist", (Exception,), {})
+        model._default_manager.aget_by_natural_key = AsyncMock(side_effect=TypeError("lookup failed"))
+        with patch("django.contrib.auth.backends.UserModel", model):
+            try:
+                await ModelBackend().aauthenticate(None, username="diagnostic-user", password=self.password,
+                    opaque=self.secret, credentials_payload={"proof":self.secret})
+            except TypeError:
+                report = self.report(sys.exc_info())
+            else:
+                self.fail("Expected the lookup error")
+        self.assertNotIn(self.password, report)
+        self.assertNotIn(self.secret, report)
+        self.assertIn("diagnostic-user", report)
+
+    @override_settings(DEBUG=True)
+    def test_inactive_filter_keeps_development_diagnostics(self):
+        model = Mock()
+        model.DoesNotExist = type("DoesNotExist", (Exception,), {})
+        model._default_manager.get_by_natural_key.side_effect = TypeError("lookup failed")
+        with patch("django.contrib.auth.backends.UserModel", model):
+            try:
+                ModelBackend().authenticate(None, username="diagnostic-user", password=self.password, opaque=self.secret)
+            except TypeError:
+                report = self.report(sys.exc_info())
+            else:
+                self.fail("Expected the lookup error")
+        self.assertIn(self.secret, report)
+        self.assertIn(self.password, report)

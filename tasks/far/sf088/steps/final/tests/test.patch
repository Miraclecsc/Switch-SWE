diff --git a/tests/test_sf088_extension.py b/tests/test_sf088_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf088_extension.py
@@ -0,0 +1,38 @@
+import pytest
+from packaging.markers import Marker
+
+@pytest.mark.parametrize("text,env,expected",[
+    ('python_version >= "3.10"',{},None),
+    ('python_version >= "3.10"',{"python_version":"3.11"},True),
+    ('python_version >= "3.10" and os_name == "posix"',{"python_version":"3.9"},False),
+    ('python_version >= "3.10" or os_name == "posix"',{"python_version":"3.11"},True),
+    ('(python_version >= "3.10" or os_name == "posix") and sys_platform == "linux"',{"python_version":"3.11"},None),
+    ('(python_version >= "3.10" or os_name == "posix") and sys_platform == "linux"',{"python_version":"3.11","sys_platform":"win32"},False),
+])
+def test_partial_logic(text,env,expected):
+    marker=Marker(text);before=str(marker)
+    assert marker.evaluate_partial(env,context="requirement") is expected
+    assert str(marker) == before
+
+def test_context_defaults():
+    assert Marker('extra == ""').evaluate_partial() is True
+    assert Marker('extra == ""').evaluate_partial(context="requirement") is None
+    assert Marker('"dev" in extras').evaluate_partial(context="metadata") is None
+    assert Marker('"dev" in extras').evaluate_partial(context="lock_file") is False
+    assert Marker('"dev" not in dependency_groups').evaluate_partial(context="lock_file") is True
+
+def test_normalization_and_no_mutation():
+    values={"extras":{"Dev_Test"},"python_full_version":"3.13.0+"}
+    marker=Marker('"dev-test" in extras and python_full_version >= "3.13"')
+    assert marker.evaluate_partial(values,context="lock_file") is True
+    assert values == {"extras":{"Dev_Test"},"python_full_version":"3.13.0+"}
+    assert Marker('extra == ""').evaluate_partial({"extra":None}) is True
+
+def test_no_host_lookup(monkeypatch):
+    import packaging.markers as markers
+    monkeypatch.setattr(markers,"default_environment",lambda:pytest.fail("host leak"))
+    assert Marker('python_version == "3.12"').evaluate_partial() is None
+    with pytest.raises(ValueError): Marker('extra == "x"').evaluate_partial(context="bogus")
+
+def test_original_context_evaluation():
+    assert Marker('"dev-test" in extras').evaluate({"extras":{"dev_test"}},context="lock_file")

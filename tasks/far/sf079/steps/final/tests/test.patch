diff --git a/tests/test_sf079_extension.py b/tests/test_sf079_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf079_extension.py
@@ -0,0 +1,54 @@
+import pytest
+from packaging import tags
+
+@pytest.fixture
+def stream(monkeypatch):
+    seen, warnings = [], []
+    monkeypatch.setattr(tags, "_interpreter_name", lambda: "cp")
+    monkeypatch.setattr(tags.platform, "system", lambda: "Linux")
+    monkeypatch.setattr(tags, "_linux_platforms", lambda: ["drop", "keep"])
+    monkeypatch.setattr(tags, "_cpython_interpreter", lambda version: "cp37")
+    def abis(version, warn):
+        warnings.append(warn)
+        return ["m"]
+    monkeypatch.setattr(tags, "_cpython_abis", abis)
+    def generated(*args):
+        for p in ["drop", "keep", "keep", "drop"]:
+            seen.append(p)
+            yield tags.Tag("cp37", "m", p)
+    monkeypatch.setattr(tags, "_cpython_tags", generated)
+    monkeypatch.setattr(tags, "_independent_tags", lambda *args: iter([tags.Tag("py3", "none", "any")]))
+    return seen, warnings
+
+def test_filter_is_lazy_and_forwards_warn(stream):
+    seen, warnings = stream
+    result = tags.sys_tags(warn=True, platform_filter=["keep"])
+    assert seen == warnings == []
+    assert next(result).platform == "keep"
+    assert seen == ["drop", "keep"] and warnings == [True]
+    assert [x.platform for x in result] == ["keep"]
+
+@pytest.mark.parametrize("allowed,want", [
+    ("keep", ["keep", "keep"]), (["any"], ["any"]),
+    (["keep", "any"], ["keep", "keep", "any"]), (["unknown"], []),
+])
+def test_exact_filter(stream, allowed, want):
+    assert [x.platform for x in tags.sys_tags(platform_filter=allowed)] == want
+
+def test_filter_consumed_once(stream):
+    consumed = []
+    def allowed():
+        for p in ["keep", "any"]:
+            consumed.append(p)
+            yield p
+    assert [x.platform for x in tags.sys_tags(platform_filter=allowed())] == ["keep", "keep", "any"]
+    assert consumed == ["keep", "any"]
+
+def test_empty_filter_does_not_probe(monkeypatch):
+    def probe():
+        raise AssertionError("unnecessary probe")
+    monkeypatch.setattr(tags, "_interpreter_name", probe)
+    assert list(tags.sys_tags(warn=True, platform_filter=[])) == []
+
+def test_default_stream_is_unchanged(stream):
+    assert [x.platform for x in tags.sys_tags()] == ["drop", "keep", "keep", "drop", "any"]

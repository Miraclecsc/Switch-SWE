@@ -0,0 +1,96 @@
+"""UDP local-close ownership, including delayed transport callbacks."""
+import asyncio
+from unittest.mock import Mock
+import anyio
+import pytest
+from anyio import BrokenResourceError, ClosedResourceError
+from anyio._backends._asyncio import ConnectedUDPSocket, DatagramProtocol, UDPSocket
+
+
+def endpoint(connected):
+    protocol = DatagramProtocol()
+    transport = Mock()
+    transport.is_closing.return_value = False
+    protocol.connection_made(transport)
+    transport.close.side_effect = lambda: setattr(transport.is_closing, "return_value", True)
+    socket = (ConnectedUDPSocket if connected else UDPSocket)(transport, protocol)
+    return socket, protocol, transport
+
+
+@pytest.mark.parametrize("connected", [False, True])
+def test_local_close_rejects_buffered_and_late_datagrams(connected):
+    async def scenario():
+        sock, protocol, transport = endpoint(connected)
+        protocol.datagram_received(b"before", ("127.0.0.1", 1234))
+        await sock.aclose()
+        protocol.datagram_received(b"late", ("127.0.0.1", 1234))
+        for _ in range(2):
+            with pytest.raises(ClosedResourceError):
+                await sock.receive()
+        await sock.aclose()
+        transport.close.assert_called_once()
+    anyio.run(scenario)
+
+
+@pytest.mark.parametrize("connected", [False, True])
+def test_close_wakes_pending_receive_without_connection_lost(connected):
+    async def scenario():
+        sock, protocol, _ = endpoint(connected)
+        task = asyncio.create_task(sock.receive())
+        await anyio.wait_all_tasks_blocked()
+        await sock.aclose()
+        with pytest.raises(ClosedResourceError):
+            await asyncio.wait_for(task, 1)
+    anyio.run(scenario)
+
+
+@pytest.mark.parametrize("connected", [False, True])
+def test_close_wakes_paused_sender_and_never_sends(connected):
+    async def scenario():
+        sock, protocol, transport = endpoint(connected)
+        protocol.pause_writing()
+        item = b"data" if connected else (b"data", ("127.0.0.1", 1234))
+        task = asyncio.create_task(sock.send(item))
+        await anyio.wait_all_tasks_blocked()
+        await sock.aclose()
+        with pytest.raises(ClosedResourceError):
+            await asyncio.wait_for(task, 1)
+        transport.sendto.assert_not_called()
+        protocol.resume_writing()
+        with pytest.raises(ClosedResourceError):
+            await sock.send(item)
+    anyio.run(scenario)
+
+
+@pytest.mark.parametrize("connected", [False, True])
+def test_external_close_drains_existing_data_until_locally_closed(connected):
+    async def scenario():
+        sock, protocol, transport = endpoint(connected)
+        protocol.datagram_received(b"buffered", ("127.0.0.1", 1234))
+        transport.is_closing.return_value = True
+        protocol.connection_lost(None)
+        value = await sock.receive()
+        assert value == (b"buffered" if connected else (b"buffered", ("127.0.0.1", 1234)))
+        with pytest.raises(BrokenResourceError):
+            await sock.receive()
+        await sock.aclose()
+        with pytest.raises(ClosedResourceError):
+            await sock.receive()
+    anyio.run(scenario)
+
+
+def test_real_udp_local_close_with_buffered_packet():
+    async def scenario():
+        receiver = await anyio.create_udp_socket(local_host="127.0.0.1")
+        sender = await anyio.create_udp_socket(local_host="127.0.0.1")
+        try:
+            address = receiver.extra(anyio.abc.SocketAttribute.local_address)
+            await sender.send((b"queued", address))
+            await anyio.wait_all_tasks_blocked()
+            await receiver.aclose()
+            with pytest.raises(ClosedResourceError):
+                await receiver.receive()
+        finally:
+            await receiver.aclose()
+            await sender.aclose()
+    anyio.run(scenario)

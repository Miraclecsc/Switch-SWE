@@ -0,0 +1,35 @@
+import json
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.io.json import ujson_dumps
+
+class HookFailure(RuntimeError):pass
+
+def test_array_property_preserves_exception_identity():
+    failure=HookFailure('array property failed')
+    class BrokenSeries(pd.Series):
+        @property
+        def array(self):raise failure
+    with pytest.raises(HookFailure) as caught:ujson_dumps(BrokenSeries([1,2]),orient='values')
+    assert caught.value is failure
+
+def test_extension_hook_preserves_exception_identity(monkeypatch):
+    series=pd.Series([1,2]);failure=HookFailure('hook failed')
+    def broken(self):raise failure
+    with monkeypatch.context() as scoped:
+        scoped.setattr(type(series.array),'_values_for_json',broken)
+        with pytest.raises(HookFailure) as caught:ujson_dumps(series,orient='values')
+        assert caught.value is failure
+    assert json.loads(ujson_dumps(series,orient='values'))==[1,2]
+
+@pytest.mark.parametrize('values',[np.array([[1,2],[3,4]]),np.array([1,2,3])])
+def test_invalid_extension_shape_or_length(values,monkeypatch):
+    series=pd.Series([1,2])
+    monkeypatch.setattr(type(series.array),'_values_for_json',lambda self:values)
+    with pytest.raises(ValueError):ujson_dumps(series,orient='values')
+
+def test_valid_strided_hook_output(monkeypatch):
+    series=pd.Series([1,2,3]);values=np.array([10,0,20,0,30,0])[::2]
+    monkeypatch.setattr(type(series.array),'_values_for_json',lambda self:values)
+    assert json.loads(ujson_dumps(series,orient='values'))==[10,20,30]

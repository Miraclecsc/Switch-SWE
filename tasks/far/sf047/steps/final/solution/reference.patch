+static PyObject *validate_json_values(PyObject *obj, PyObject *values) {
+  if (!PyArray_CheckExact(values) || PyArray_NDIM((PyArrayObject *)values) != 1) {
+    PyErr_SetString(PyExc_ValueError, "JSON values must be a one-dimensional numpy array");
+    Py_DECREF(values);
+    return NULL;
+  }
+  Py_ssize_t expected = PyObject_Length(obj);
+  if (expected < 0) {
+    Py_DECREF(values);
+    return NULL;
+  }
+  if (PyArray_DIM((PyArrayObject *)values, 0) != expected) {
+    PyErr_SetString(PyExc_ValueError, "JSON values length must match Series/Index length");
+    Py_DECREF(values);
+    return NULL;
+  }
+  return values;

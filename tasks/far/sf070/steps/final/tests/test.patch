+++ b/networkx/drawing/tests/test_sf070_label_positions.py
@@ -0,0 +1,51 @@
+
+import matplotlib.pyplot as plt
+import numpy as np
+import pytest
+import networkx as nx
+
+@pytest.fixture(autouse=True)
+def close_figures():
+    yield
+    plt.close("all")
+
+@pytest.mark.parametrize("style", ["arc3,rad=0.2", "angle3", "arc", "angle", "bar"])
+def test_position_mapping_agrees_with_sequence_and_survives_redraw(style):
+    graph = nx.MultiDiGraph()
+    graph.add_edge(0, 1, key="a")
+    graph.add_edge(0, 1, key="b")
+    graph.add_edge(1, 2, key="c")
+    pos = {0: (0., 0.), 1: (1., 1.), 2: (3., 0.)}
+    labels = {(0, 1, "b"): "b", (1, 2, "c"): "c", (0, 1, "a"): "a"}
+    positions = {(0, 1, "a"): 0.8, (0, 1, "b"): 0.2}
+    fig, axes = plt.subplots(1, 2)
+    mapped = nx.draw_networkx_edge_labels(graph, pos, edge_labels=labels,
+                label_pos=positions, connectionstyle=style, ax=axes[0])
+    sequential = nx.draw_networkx_edge_labels(graph, pos, edge_labels=labels,
+                label_pos=[0.2, 0.5, 0.8], connectionstyle=style, ax=axes[1])
+    positions[(0, 1, "b")] = 1.0
+    for ax in axes:
+        ax.set_xlim(-2, 5)
+        ax.set_ylim(-2, 4)
+    fig.canvas.draw()
+    for edge in labels:
+        np.testing.assert_allclose(mapped[edge].get_position(), sequential[edge].get_position(), atol=1e-12)
+        np.testing.assert_allclose(mapped[edge].get_rotation(), sequential[edge].get_rotation(), atol=1e-12)
+
+@pytest.mark.parametrize("value,exc", [(-0.1, ValueError), (1.1, ValueError),
+    (float("nan"), ValueError), (float("inf"), ValueError), ("half", TypeError), (True, TypeError)])
+def test_invalid_mapping_rejected_before_drawing(value, exc):
+    graph = nx.path_graph(2)
+    fig, ax = plt.subplots()
+    before = len(ax.texts)
+    with pytest.raises(exc):
+        nx.draw_networkx_edge_labels(graph, {0: (0, 0), 1: (1, 1)},
+                                    edge_labels={(0, 1): "x"}, label_pos={(0, 1): value}, ax=ax)
+    assert len(ax.texts) == before
+
+def test_missing_keys_default_and_unrendered_entries_ignored():
+    graph = nx.path_graph(2)
+    fig, ax = plt.subplots()
+    labels = nx.draw_networkx_edge_labels(graph, {0: (0, 0), 1: (1, 1)},
+        edge_labels={(0, 1): "x"}, label_pos={(8, 9): "unused"}, ax=ax)
+    assert labels[(0, 1)].label_pos == 0.5

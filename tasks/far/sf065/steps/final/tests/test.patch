diff --git a/networkx/drawing/tests/test_sf065_fixed_nodes.py b/networkx/drawing/tests/test_sf065_fixed_nodes.py
new file mode 100644
--- /dev/null
+++ b/networkx/drawing/tests/test_sf065_fixed_nodes.py
@@ -0,0 +1,40 @@
+
+import numpy as np
+import pytest
+import networkx as nx
+
+@pytest.mark.parametrize("kwargs", [{}, {"linlog": True}, {"node_size": {0: 0.1, 1: 0.1, 2: 0.1}},
+                                  {"distributed_action": True, "strong_gravity": True}])
+def test_fixed_nodes_keep_positions_and_still_influence_layout(kwargs):
+    graph = nx.path_graph(3)
+    pos = {0: np.array([1., 1.]), 1: np.array([3., 2.]), 2: np.array([6., 4.])}
+    original = {n: p.copy() for n, p in pos.items()}
+    result = nx.forceatlas2_layout(graph, pos=pos, fixed=(n for n in [0, 0]),
+                                  max_iter=4, seed=3, **kwargs)
+    np.testing.assert_array_equal(result[0], pos[0])
+    assert not np.allclose(result[1], pos[1])
+    assert all(np.isfinite(value).all() for value in result.values())
+    for node in graph:
+        np.testing.assert_array_equal(pos[node], original[node])
+    moved_anchor = dict(pos, **{})
+    moved_anchor[0] = np.array([10., 1.])
+    other = nx.forceatlas2_layout(graph, pos=moved_anchor, fixed=[0], max_iter=4, seed=3, **kwargs)
+    assert not np.allclose(result[1], other[1])
+
+def test_all_fixed_and_empty_fixed():
+    graph = nx.path_graph(2)
+    pos = {0: np.array([0., 0., 0.]), 1: np.array([2., 1., 3.])}
+    result = nx.forceatlas2_layout(graph, pos=pos, fixed=graph, max_iter=10)
+    for node in graph:
+        np.testing.assert_array_equal(result[node], pos[node])
+        assert result[node] is not pos[node]
+    normal = nx.forceatlas2_layout(graph, seed=4, max_iter=3)
+    empty = nx.forceatlas2_layout(graph, seed=4, max_iter=3, fixed=[])
+    for node in graph:
+        np.testing.assert_array_equal(normal[node], empty[node])
+
+@pytest.mark.parametrize("pos,fixed", [(None, [0]), ({1: [1., 2.]}, [0]),
+                                    ({0: [1., 2.]}, [8])])
+def test_fixed_validation(pos, fixed):
+    with pytest.raises(ValueError):
+        nx.forceatlas2_layout(nx.path_graph(2), pos=pos, fixed=fixed)

@@ -0,0 +1,87 @@
+import pickle
+import pytest
+from packaging.tags import Tag
+
+
+def blank_tag():
+    return Tag.__new__(Tag)
+
+
+class Payload:
+    def __init__(self,state): self.state=state
+    def __reduce__(self): return blank_tag,(),self.state
+
+
+def state_for(kind):
+    values=("CP312","ABI3","MANYLINUX_2_17_X86_64")
+    mapping=dict(zip(("_interpreter","_abi","_platform"),values))
+    mapping["_hash"]=12345
+    return values if kind=="compact" else mapping if kind=="dict" else (None,mapping)
+
+
+@pytest.mark.parametrize("kind",["compact","dict","slots"])
+def test_every_state_format_is_canonical(kind):
+    obj=blank_tag();obj.__setstate__(state_for(kind))
+    expected=Tag("cp312","abi3","manylinux_2_17_x86_64")
+    assert obj==expected
+    assert hash(obj)==hash(expected)
+    assert str(obj)==str(expected)
+    assert obj.__getstate__()==("cp312","abi3","manylinux_2_17_x86_64")
+
+
+@pytest.mark.parametrize("kind",["compact","dict","slots"])
+@pytest.mark.parametrize("protocol",[2,4,pickle.HIGHEST_PROTOCOL])
+def test_synthetic_build_state_roundtrip(kind,protocol):
+    # Synthetic fixtures exercise actual pickle BUILD, not claimed release bytes.
+    loaded=pickle.loads(pickle.dumps(Payload(state_for(kind)),protocol=protocol))
+    assert loaded==Tag("cp312","abi3","manylinux_2_17_x86_64")
+    assert hash(loaded)==hash(Tag("cp312","abi3","manylinux_2_17_x86_64"))
+
+
+@pytest.mark.parametrize("state",[
+    {"_interpreter":"py3","_abi":"none"},
+    {"_interpreter":"py3","_abi":"none","_platform":3},
+    ({"arbitrary":1},{"_interpreter":"py3","_abi":"none","_platform":"any"}),
+    ("not-none",{"_interpreter":"py3","_abi":"none","_platform":"any"}),
+    ("py3","none",None),
+])
+def test_invalid_state_does_not_change_existing_tag(state):
+    obj=Tag("cp310","abi3","linux_x86_64")
+    before=(str(obj),hash(obj),obj.__getstate__())
+    with pytest.raises(TypeError):
+        obj.__setstate__(state)
+    assert (str(obj),hash(obj),obj.__getstate__())==before
+
+
+class ExplodingString(str):
+    def lower(self): raise RuntimeError("normalization failed")
+
+
+@pytest.mark.parametrize("kind",["dict","slots"])
+def test_later_field_normalization_failure_is_atomic(kind):
+    mapping={"_interpreter":"NEW","_abi":ExplodingString("abi"),"_platform":"ANY"}
+    state=mapping if kind=="dict" else (None,mapping)
+    obj=Tag("original","none","any");before=(str(obj),hash(obj))
+    with pytest.raises(RuntimeError,match="normalization failed"):
+        obj.__setstate__(state)
+    assert (str(obj),hash(obj))==before
+    assert obj==Tag("original","none","any")
+    obj.__setstate__(("PY3","NONE","ANY"))
+    assert obj==Tag("py3","none","any")
+
+
+def test_unrelated_legacy_keys_and_foreign_hash_ignored():
+    obj=blank_tag()
+    obj.__setstate__((None,{"_interpreter":"PY3","_abi":"NONE","_platform":"ANY",
+                           "_hash":object(),"unrelated":object()}))
+    assert obj==Tag("py3","none","any")
+    assert hash(obj)==hash(Tag("py3","none","any"))
+
+
+@pytest.mark.parametrize("protocol",range(pickle.HIGHEST_PROTOCOL+1))
+def test_standard_pickle_protocols_keep_set_membership(protocol):
+    obj=Tag("cp312","abi3","any")
+    restored=pickle.loads(pickle.dumps(obj,protocol=protocol))
+    assert restored in {obj}
+    assert obj in {restored}
+    assert restored.__getstate__()==obj.__getstate__()

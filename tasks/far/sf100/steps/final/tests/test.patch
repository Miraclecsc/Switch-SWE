+import pytest
+from sympy import symbols
+from sympy.assumptions.cnf import EncodedCNF
+from sympy.logic.algorithms.lra_theory import LRASolver
+
+x,y=symbols("x y")
+
+def solver(constraints):
+    encoded=EncodedCNF()
+    for constraint in constraints: encoded.add_prop(constraint)
+    result,conflicts=LRASolver.from_encoded_cnf(encoded,testing_mode=True)
+    assert not conflicts
+    return result
+
+def state(lra):
+    return {v.var:(v.lower.value,v.upper.value,v.assign.value) for v in lra.all_var}
+
+def test_nested_bounds_and_models():
+    lra=solver([x>=0,x<=10,x>=3,x<=2,x<=8])
+    lra.assert_lit(1);lra.assert_lit(2);assert lra.check()[0]
+    original=state(lra)
+    assert lra.push()==1
+    lra.assert_lit(3);assert lra.check()[0];middle=state(lra)
+    assert lra.push()==2
+    lra.assert_lit(4);assert not lra.check()[0]
+    assert lra.pop()==1 and lra.check()[0] and state(lra)==middle
+    lra.assert_lit(5);assert lra.check()[0]
+    assert lra.pop()==0 and lra.check()[0] and state(lra)==original
+    lra.backtrack();assert lra.check()[0]
+
+def test_pivot_conflict_and_reassertion():
+    lra=solver([x+y>=3,x<=1,y<=1,x>=0,y>=0])
+    lra.assert_lit(1);assert lra.check()[0];before=state(lra)
+    lra.push();lra.assert_lit(2);assert lra.check()[0]
+    lra.assert_lit(3);conflict=lra.check();assert not conflict[0]
+    lra.pop();assert lra.check()[0] and state(lra)==before
+    lra.assert_lit(2);lra.assert_lit(3);assert not lra.check()[0]
+
+def test_bulk_pop_and_atomic_invalid_counts():
+    lra=solver([x>=0,x<=4,x>=5]);before=state(lra)
+    lra.push();lra.assert_lit(1);lra.check();lra.push();lra.assert_lit(2);lra.check()
+    current=state(lra)
+    for count,error in [(3,ValueError),(-1,ValueError),(1.5,TypeError)]:
+        with pytest.raises(error):lra.pop(count)
+        assert state(lra)==current
+    assert lra.pop(0)==2
+    assert lra.pop(2)==0 and state(lra)==before
+    with pytest.raises(ValueError):lra.pop()
+    with pytest.raises(ValueError):lra.backtrack()
+
+def test_checkpoint_of_conflict():
+    lra=solver([x>=3,x<=2]);lra.assert_lit(1);assert lra.check()[0]
+    lra.assert_lit(2);conflict=lra.check();assert not conflict[0]
+    lra.push();lra.backtrack();assert lra.check()[0]
+    lra.pop();assert lra.check()==conflict
+
+def test_original_empty_backtrack():
+    lra=solver([x>=0])
+    with pytest.raises(ValueError):lra.backtrack()

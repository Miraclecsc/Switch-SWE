+    def push(self):
+        """Save the current solver state and return the checkpoint depth."""
+        from copy import deepcopy
+        snapshot = deepcopy({key: value for key, value in self.__dict__.items()
+                             if key != "_decision_levels"})
+        self._decision_levels.append(snapshot)
+        return len(self._decision_levels)
+
+    def pop(self, levels=1):
+        """Restore one or more saved decision levels, atomically on invalid input."""
+        if not isinstance(levels, int):
+            raise TypeError("levels must be an integer")
+        stack = self._decision_levels
+        if levels < 0 or levels > len(stack):
+            raise ValueError("not enough decision checkpoints")
+        if levels == 0:
+            return len(stack)
+        snapshot = stack[-levels]
+        del stack[-levels:]
+        self.__dict__.clear()
+        self.__dict__.update(snapshot)
+        self._decision_levels = stack
+        return len(stack)
+
+    def backtrack(self):
+        """
+        Revert the most recent bound update to resolve a conflict.
+
+        Pops the last state from the ``bound_history`` stack and restores the
+        variable's previous upper or lower bound. It also reverts all variable
+        assignments to their previous valid state using a dictionary,
+        thus clearing the current conflict and restoring satisfiability.
+
+        Raises
+        ======
+
+        ValueError
+            If called when the ``bound_history`` stack is empty, indicating
+            the solver's internal state is out of sync.
+        """
+        if not self.bound_history:
+            raise ValueError("Cannot backtrack, bound_history stack is empty")
+
+        xi, old_bound, upper = self.bound_history.pop()
+
+        if upper:
+            xi.upper = old_bound
+        else:
+            xi.lower = old_bound
+
+        for var in self.all_var:
+            var.assign = self.last_assign_snapshot[var]
+
+        self.is_sat = True
+        self.result = None
 

+++ b/sympy/printing/tests/test_sf096_extension.py
@@ -0,0 +1,25 @@
+import pytest
+from sympy import symbols, Float, log, sin, cos, exp, ceiling, floor
+from sympy.printing.codeprinter import rust_code
+from sympy.printing.rust import TypeCast
+from sympy.codegen.ast import real
+
+@pytest.mark.parametrize("fn",[ceiling,floor])
+def test_integer_coefficients_of_float_rounding(fn):
+    x=symbols("x")
+    assert rust_code(2*fn(x)) == rust_code(Float(2)*fn(x))
+    assert rust_code(2+fn(x)) == rust_code(Float(2)+fn(x))
+
+@pytest.mark.parametrize("fn",[log,sin,cos,exp])
+def test_integer_float_method_receiver(fn):
+    assert rust_code(fn(2,evaluate=False)) == rust_code(fn(Float(2),evaluate=False))
+
+def test_compound_explicit_cast():
+    i,j=symbols("i j",integer=True)
+    code=rust_code(TypeCast(i+j,real))
+    assert "(i + j)" in code and code.endswith(" as f64")
+    method=rust_code(log(i+j,evaluate=False))
+    assert "(i + j)" in method and "as f64" in method and method.endswith(".ln()")
+
+def test_custom_mapping_not_promoted():
+    assert rust_code(sin(2,evaluate=False),user_functions={"sin":"custom"}) == "2_i32.custom()"

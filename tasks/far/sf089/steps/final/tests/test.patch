@@ -0,0 +1,44 @@
+import pickle
+import pytest
+from .._multierror import MultiError
+
+pytestmark = pytest.mark.filterwarnings("ignore::trio.TrioDeprecationWarning")
+
+@pytest.mark.parametrize("protocol",range(pickle.HIGHEST_PROTOCOL+1))
+def test_singleton_shape(protocol):
+    inner=MultiError([ValueError("leaf")],_collapse=False)
+    outer=MultiError([inner],_collapse=False)
+    restored=pickle.loads(pickle.dumps(outer,protocol=protocol))
+    assert isinstance(restored,MultiError) and restored.collapse is False
+    assert len(restored.exceptions)==1 and isinstance(restored.exceptions[0],MultiError)
+    assert restored.exceptions[0].collapse is False
+    assert restored.exceptions[0].exceptions[0].args == ("leaf",)
+
+@pytest.mark.parametrize("protocol",[0,pickle.HIGHEST_PROTOCOL])
+def test_state_aliasing_and_causes(protocol):
+    leaf=ValueError("shared")
+    group=MultiError([leaf,leaf],_collapse=False)
+    group.details={"self":group,"leaf":leaf}
+    group.add_note("diagnostic note")
+    group.__cause__=KeyError("cause")
+    group.__context__=RuntimeError("context")
+    group.__suppress_context__=True
+    restored=pickle.loads(pickle.dumps(group,protocol=protocol))
+    assert restored.exceptions[0] is restored.exceptions[1]
+    assert restored.details["self"] is restored
+    assert restored.details["leaf"] is restored.exceptions[0]
+    assert restored.__notes__ == ["diagnostic note"]
+    assert restored.__cause__.args == ("cause",)
+    assert restored.__context__.args == ("context",)
+    assert restored.__suppress_context__ is True
+    assert group.details["self"] is group and group.exceptions[0] is leaf
+
+def test_base_exception_distinction():
+    group=MultiError([KeyboardInterrupt()],_collapse=False)
+    result=pickle.loads(pickle.dumps(group))
+    assert isinstance(result,MultiError) and not isinstance(result,Exception)
+    assert isinstance(result.exceptions[0],KeyboardInterrupt)
+
+def test_original_multi_child_pickle():
+    result=pickle.loads(pickle.dumps(MultiError([ValueError("a"),KeyError("b")])))
+    assert [e.args for e in result.exceptions] == [("a",),("b",)]

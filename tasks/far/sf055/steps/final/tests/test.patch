--- /dev/null
+++ b/tests/test_checkpoint_budget.py
@@ -0,0 +1,216 @@
+"""Public bounded-fast requirements. Tests use actual scheduling and cancellation."""
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+import sniffio
+
+from anyio import (
+    CancelScope, Event, Lock, Semaphore, create_task_group,
+    wait_all_tasks_blocked,
+)
+
+pytestmark = pytest.mark.anyio
+
+
+def make(kind, **kwargs):
+    return Lock(**kwargs) if kind == "lock" else Semaphore(1, max_value=1, **kwargs)
+
+
+async def observed_acquire(primitive):
+    """Whether acquiring scheduled an already-runnable independent task."""
+    if sniffio.current_async_library() == "trio":
+        import trio
+
+        current = trio.lowlevel.current_task()
+
+        class Steps(trio.abc.Instrument):
+            yielded = False
+
+            def after_task_step(self, task):
+                if task is current:
+                    self.yielded = True
+
+        instrument = Steps()
+        trio.lowlevel.add_instrument(instrument)
+        try:
+            async with primitive:
+                return instrument.yielded
+        finally:
+            trio.lowlevel.remove_instrument(instrument)
+
+    called = False
+
+    async def other():
+        nonlocal called
+        called = True
+
+    async with create_task_group() as tg:
+        tg.start_soon(other)
+        async with primitive:
+            scheduled = called
+    return scheduled
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+@pytest.mark.parametrize("interval", [1, 2, 3, 5])
+async def test_exact_repeated_quota(kind, interval):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=interval)
+    actual = [await observed_acquire(primitive) for _ in range(interval * 3)]
+    assert actual == [i % interval == 0 for i in range(1, interval * 3 + 1)]
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_default_and_unbounded(kind):
+    assert await observed_acquire(make(kind))
+    assert not await observed_acquire(make(kind, fast_acquire=True))
+    assert not await observed_acquire(
+        make(kind, fast_acquire=True, checkpoint_every=None)
+    )
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_instances_are_independent(kind):
+    a = make(kind, fast_acquire=True, checkpoint_every=2)
+    b = make(kind, fast_acquire=True, checkpoint_every=2)
+    assert not await observed_acquire(a)
+    assert not await observed_acquire(b)
+    assert await observed_acquire(a)
+    assert await observed_acquire(b)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_cancellation_before_acquire_does_not_consume_quota(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    assert not await observed_acquire(primitive)
+    returned = False
+    with CancelScope() as scope:
+        scope.cancel()
+        await primitive.acquire()
+        returned = True
+    assert not returned
+    assert await observed_acquire(primitive)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_acquire_nowait_does_not_consume_quota(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    for _ in range(3):
+        primitive.acquire_nowait()
+        primitive.release()
+    assert not await observed_acquire(primitive)
+    assert await observed_acquire(primitive)
+
+
+async def test_failed_recursive_lock_acquire_does_not_consume_quota():
+    lock = Lock(fast_acquire=True, checkpoint_every=2)
+    await lock.acquire()
+    with pytest.raises(RuntimeError):
+        await lock.acquire()
+    lock.release()
+    assert await observed_acquire(lock)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_contended_completion_does_not_consume_quota(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    primitive.acquire_nowait()
+    done = Event()
+
+    async def waiter():
+        async with primitive:
+            done.set()
+
+    async with create_task_group() as tg:
+        tg.start_soon(waiter)
+        await wait_all_tasks_blocked()
+        assert primitive.statistics().tasks_waiting == 1
+        primitive.release()
+        await done.wait()
+    assert not await observed_acquire(primitive)
+    assert await observed_acquire(primitive)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_counter_belongs_to_instance_not_acquiring_task(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    first_done = Event()
+
+    async def first_task():
+        assert not await observed_acquire(primitive)
+        first_done.set()
+
+    async with create_task_group() as tg:
+        tg.start_soon(first_task)
+        await first_done.wait()
+    assert await observed_acquire(primitive)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+@pytest.mark.parametrize("bad", [True, False, 1.0, "2", [], object()])
+async def test_invalid_interval_type(kind, bad):
+    with pytest.raises(TypeError):
+        make(kind, fast_acquire=True, checkpoint_every=bad)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+@pytest.mark.parametrize("bad", [0, -1, -50])
+async def test_nonpositive_interval(kind, bad):
+    with pytest.raises(ValueError):
+        make(kind, fast_acquire=True, checkpoint_every=bad)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_interval_requires_fast_mode(kind):
+    with pytest.raises(ValueError):
+        make(kind, checkpoint_every=2)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_cancelled_contended_waiter_leaves_quota_and_capacity(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    primitive.acquire_nowait()
+    scope_ready = Event()
+    scopes = []
+
+    async def waiter():
+        with CancelScope() as scope:
+            scopes.append(scope)
+            scope_ready.set()
+            await primitive.acquire()
+            pytest.fail("cancelled waiter unexpectedly acquired")
+
+    async with create_task_group() as tg:
+        tg.start_soon(waiter)
+        await scope_ready.wait()
+        await wait_all_tasks_blocked()
+        scopes[0].cancel()
+    primitive.release()
+    assert primitive.statistics().tasks_waiting == 0
+    assert not await observed_acquire(primitive)
+    assert await observed_acquire(primitive)
+
+
+@pytest.mark.parametrize("anyio_backend", ["asyncio"])
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+async def test_native_cancel_at_quota_checkpoint_releases_and_does_not_count(kind):
+    primitive = make(kind, fast_acquire=True, checkpoint_every=2)
+    assert not await observed_acquire(primitive)
+    loop = asyncio.get_running_loop()
+    current = asyncio.current_task()
+    # The callback runs only if the due acquisition really schedules a checkpoint.
+    loop.call_soon(current.cancel)
+    with pytest.raises(asyncio.CancelledError):
+        await primitive.acquire()
+    if hasattr(current, "uncancel"):
+        current.uncancel()
+    assert primitive.statistics().tasks_waiting == 0
+    # A failed due acquisition leaves the counter at N-1; retry is due again.
+    assert await observed_acquire(primitive)
+
+
+@pytest.mark.parametrize("kind", ["lock", "semaphore"])
+def test_construct_outside_async_context(kind):
+    # Constructors must validate without needing a running backend.
+    make(kind, fast_acquire=True, checkpoint_every=2)

+def _validate_checkpoint_every(fast_acquire: bool, interval: int | None) -> None:
+    if interval is not None:
+        if isinstance(interval, bool) or not isinstance(interval, int):
+            raise TypeError("checkpoint_every must be an integer or None")
+        if interval <= 0:
+            raise ValueError("checkpoint_every must be positive")
+        if not fast_acquire:
+            raise ValueError("checkpoint_every requires fast_acquire=True")

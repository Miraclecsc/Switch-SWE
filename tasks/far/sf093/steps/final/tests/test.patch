@@ -0,0 +1,62 @@
+import pytest
+import trio
+from trio.testing import wait_all_tasks_blocked
+
+def test_pause_holds_existing_and_queued_borrowers():
+    async def main():
+        limiter=trio.CapacityLimiter(1);limiter.acquire_on_behalf_of_nowait("held")
+        entered=[]
+        async def borrower(name):
+            await limiter.acquire_on_behalf_of(name)
+            entered.append(name)
+        async with trio.open_nursery() as nursery:
+            with limiter.pause():
+                nursery.start_soon(borrower,"first")
+                await wait_all_tasks_blocked()
+                nursery.start_soon(borrower,"second")
+                await wait_all_tasks_blocked()
+                limiter.release_on_behalf_of("held")
+                assert limiter.total_tokens == 1 and limiter.available_tokens == 0
+                with pytest.raises(trio.WouldBlock): limiter.acquire_on_behalf_of_nowait("new")
+                await wait_all_tasks_blocked();assert entered == []
+            await wait_all_tasks_blocked();assert entered == ["first"]
+            limiter.release_on_behalf_of("first")
+            await wait_all_tasks_blocked();assert entered == ["first","second"]
+            limiter.release_on_behalf_of("second")
+    trio.run(main)
+
+def test_nested_pause_and_changed_zero_capacity():
+    limiter=trio.CapacityLimiter(2)
+    with pytest.raises(ValueError):
+        with limiter.pause():
+            with limiter.pause():
+                limiter.total_tokens=0
+            with pytest.raises(trio.WouldBlock):limiter.acquire_on_behalf_of_nowait("x")
+            raise ValueError("body")
+    assert limiter.total_tokens == 0 and limiter.available_tokens == 0
+    limiter.total_tokens=1
+    limiter.acquire_on_behalf_of_nowait("x");limiter.release_on_behalf_of("x")
+
+def test_cancelled_waiter_and_resize():
+    async def main():
+        limiter=trio.CapacityLimiter(0);scope=trio.CancelScope();seen=[]
+        async def cancelled():
+            with scope: await limiter.acquire_on_behalf_of("cancelled")
+        async def survivor():
+            await limiter.acquire_on_behalf_of("survivor");seen.append(True)
+        async with trio.open_nursery() as nursery:
+            with limiter.pause():
+                nursery.start_soon(cancelled);await wait_all_tasks_blocked()
+                nursery.start_soon(survivor);await wait_all_tasks_blocked()
+                scope.cancel();await wait_all_tasks_blocked()
+                limiter.total_tokens=1
+                await wait_all_tasks_blocked()
+                assert not seen and limiter.statistics().tasks_waiting == 1
+            await wait_all_tasks_blocked()
+            assert seen == [True] and limiter.borrowed_tokens == 1
+            limiter.release_on_behalf_of("survivor")
+    trio.run(main)
+
+def test_original_zero_capacity():
+    limiter=trio.CapacityLimiter(0)
+    with pytest.raises(trio.WouldBlock):limiter.acquire_on_behalf_of_nowait("x")

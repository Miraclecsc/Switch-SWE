--- /dev/null
+++ b/tests/test_sf081_extension.py
@@ -0,0 +1,29 @@
+import pytest
+from packaging import tags
+
+@pytest.mark.parametrize("sep, expected", [("", "cp310"), ("_", "cp3_10"), (None, "cp3_10")])
+def test_cpython_policy(sep, expected):
+    result = list(tags.cpython_tags((3, 10), ["opaque_tag"], ["target"], version_separator=sep))
+    assert result[0] == tags.Tag(expected, "opaque_tag", "target")
+    older = [x.interpreter for x in result if x.abi == "abi3"]
+    assert older == ["cp" + (str(3)+str(i) if sep == "" or (sep is None and i < 10) else "3_"+str(i)) for i in range(10, 1, -1)]
+
+def test_generated_debug_abis(monkeypatch):
+    monkeypatch.setattr(tags, "_get_config_var", lambda name, warn=False: 1 if name == "Py_DEBUG" else 0)
+    result = list(tags.cpython_tags((3, 11), platforms=["target"], version_separator="", warn=True))
+    assert [(t.interpreter,t.abi) for t in result[:2]] == [("cp311","cp311d"),("cp311","cp311")]
+
+@pytest.mark.parametrize("sep, head, older", [("", "py310", "py39"), ("_", "py3_10", "py3_9"), (None,"py3_10","py39")])
+def test_compatible_policy(sep, head, older):
+    result = list(tags.compatible_tags((3,10), "opaque310", ["target"], version_separator=sep))
+    assert result[:3] == [tags.Tag(head,"none","target"), tags.Tag("py3","none","target"),tags.Tag(older,"none","target")]
+    boundary = result.index(tags.Tag("opaque310","none","any"))
+    assert [x.interpreter for x in result[:boundary]] == [x.interpreter for x in result[boundary+1:]]
+
+@pytest.mark.parametrize("function", [tags.cpython_tags, tags.compatible_tags])
+def test_invalid_policy(function):
+    with pytest.raises(ValueError):
+        list(function((3,10), platforms=["target"], version_separator="."))
+
+def test_original_multidigit_default():
+    assert next(tags.cpython_tags((3,10), ["opaque"], ["target"])).interpreter == "cp3_10"

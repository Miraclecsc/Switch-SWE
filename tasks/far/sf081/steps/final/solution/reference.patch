+def _version_nodot(version, version_separator=None):
+    # type: (PythonVersion) -> str
+    if version_separator not in (None, "", "_"):
+        raise ValueError("version_separator must be None, empty, or underscore")
+    if version_separator is not None:
+        return version_separator.join(map(str, version))
+    if any(v >= 10 for v in version):
+        sep = "_"
+    else:
+        sep = ""
+    return sep.join(map(str, version))

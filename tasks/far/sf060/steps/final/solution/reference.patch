     Python's standard :class:`~tempfile.SpooledTemporaryFile`. It supports asynchronous
     write operations and provides a method to force a rollover to disk.
 
-    :param max_size: Maximum size in bytes before the file is rolled over to disk.
+    :param max_size: Maximum encoded buffer size in bytes before automatic
+        rollover. Equality stays in memory; zero disables automatic rollover.
+
+    Rollover preserves contents and the current position, including text seek
+    cookies. An allocation error leaves the spool open and available for retry.
+    If a write triggers the error, its data and resulting position are retained.
+    Text encoding and newline translation are preserved when moving to disk.
+
     :param mode: The mode in which the file is opened. Defaults to "w+b".
     :param buffering: The buffering policy (-1 means the default buffering).
     :param encoding: The encoding used to decode or encode the file (text mode only).
@@ -312,22 +319,42 @@
         await super().aclose()
 
     async def _check(self) -> None:
-        if self._rolled or self._fp.tell() < self._max_size:
+        if self._rolled or not self._max_size:
             return
 
-        await self.rollover()
+        buffer = self._fp
+        raw_buffer = buffer.buffer if isinstance(buffer, TextIOWrapper) else buffer
+        if len(raw_buffer.getvalue()) > self._max_size:
+            await self.rollover()
 
     async def rollover(self) -> None:
+        """Move to disk without changing contents or the current position.
+
+        A failed allocation leaves the in-memory file available for retry.
+        """
         if self._rolled:
             return
 
+        buffer = self._fp
+        position = buffer.tell()
+        raw_buffer = buffer.buffer if isinstance(buffer, TextIOWrapper) else buffer
+        data = raw_buffer.getvalue()
+
+        def copy_to_disk() -> Any:
+            target = tempfile.TemporaryFile(**self._tempfile_params)
+            try:
+                raw_target = target.buffer if isinstance(target, TextIOWrapper) else target
+                raw_target.write(data)
+                target.seek(position)
+            except BaseException:
+                target.close()
+                raise
+
+            return target
+
+        target = await to_thread.run_sync(copy_to_disk)
+        self._fp = target
         self._rolled = True

+import pytest
+from packaging.version import Version
+
+@pytest.mark.parametrize("text, edits, expected", [
+    ("2", {"micro": 7}, "2.0.7"),
+    ("3!1.2.3.4rc2.post3.dev4+AbC.01", {"minor": 9}, "3!1.9.3.4rc2.post3.dev4+abc.1"),
+    ("1.2.3.4", {"major": 8, "reset_lower": True}, "8.0.0.0"),
+    ("1.2.3.4", {"major": 8, "micro": 6, "reset_lower": True}, "8.2.6.0"),
+    ("1", {"minor": 4, "reset_lower": True}, "1.4"),
+    ("1.2.3.4", {"reset_lower": True}, "1.2.3.4"),
+])
+def test_release_edits(text, edits, expected):
+    original = Version(text)
+    before = (str(original), original.release, hash(original))
+    result = original.replace_release(**edits)
+    assert isinstance(result, Version) and result is not original
+    assert str(result) == expected
+    assert result == Version(expected)
+    assert hash(result) == hash(Version(expected))
+    assert (str(original), original.release, hash(original)) == before
+
+@pytest.mark.parametrize("value, error", [(True, TypeError), (1.5, TypeError), ("3", TypeError), (-1, ValueError)])
+def test_invalid_edit_is_atomic(value, error):
+    original = Version("2!1.2rc1+abc")
+    with pytest.raises(error):
+        original.replace_release(major=9, minor=value)
+    assert str(original) == "2!1.2rc1+abc"
+
+def test_original_aliases():
+    v = Version("2")
+    assert (v.major, v.minor, v.micro) == (2, 0, 0)

+    def describe_replication_tasks_page(
+        self,
+        filters: list[dict[str, Any]],
+        max_records: int,
+        marker: Optional[str] = None,
+        without_settings: bool = False,
+    ) -> dict[str, Any]:
+        # Continuations keep membership, not an offset into a mutable registry.
+        # Object identity also distinguishes deletion/recreation of the same ARN.
+        from .utils import task_filter_functions
+
+        if not 20 <= max_records <= 100:
+            raise ValidationError("MaxRecords must be between 20 and 100")
+        query = tuple(sorted({
+            (f["Name"], tuple(sorted(set(f["Values"]))))
+            for f in filters if f["Name"] in task_filter_functions
+        }))
+        if marker is not None:
+            continuation = self._task_continuations.get(marker)
+            if continuation is None or continuation[0] != query:
+                raise ValidationError("Marker does not belong to this query")
+            members = continuation[1]
+        else:
+            members = list(filter_tasks(list(self.replication_tasks.values()), filters))
+        remaining = [t for t in members if self.replication_tasks.get(t.arn) is t]
+        page, tail = remaining[:max_records], remaining[max_records:]
+        records = [task.to_dict() for task in page]
+        if without_settings:
+            for record in records:
+                record.pop("ReplicationTaskSettings", None)
+        result: dict[str, Any] = {"ReplicationTasks": records}
+        if tail:
+            next_marker = str(uuid4())
+            self._task_continuations[next_marker] = (query, tail)
+            result["Marker"] = next_marker
+        return result
+

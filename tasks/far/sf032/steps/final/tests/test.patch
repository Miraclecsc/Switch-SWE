@@ -0,0 +1,31 @@
+import pytest
+from sympy import Add, Rational, S, log, pi
+from sympy.core.evalf import PrecisionExhausted
+
+@pytest.mark.parametrize('exponent',[60,120,400])
+@pytest.mark.parametrize('sign',[-1,1])
+def test_negative_near_unit_real_part_and_phase(exponent,sign):
+    t=sign*Rational(1,10**exponent)
+    expr=log(-(1+t),evaluate=False)
+    real,imag=expr.evalf(35,maxn=1500,strict=True).as_real_imag()
+    oracle=sum((-1)**(k+1)*t**k/Rational(k) for k in range(1,5))
+    assert abs((real-oracle.evalf(45))/t).evalf() < Rational(1,10**30)
+    assert abs(imag-pi.evalf(45)).evalf() < Rational(1,10**33)
+
+@pytest.mark.parametrize('sign',[-1,1])
+def test_unevaluated_negative_near_unit_sum(sign):
+    eps=Rational(sign,10**90)
+    arg=Add(-1,-eps,evaluate=False)
+    real=log(arg,evaluate=False).evalf(30,maxn=600,strict=True).as_real_imag()[0]
+    assert abs(real/eps-1).evalf() < Rational(1,10**25)
+
+@pytest.mark.parametrize('sign',[-1,1])
+def test_insufficient_budget_is_explicit(sign):
+    expr=log(-1+Rational(sign,10**400),evaluate=False)
+    with pytest.raises(PrecisionExhausted):expr.evalf(30,maxn=40,strict=True)
+
+def test_positive_correction_and_exact_unit_regressions():
+    eps=Rational(1,10**80)
+    assert abs(log(1+eps,evaluate=False).evalf(30,maxn=600)/eps-1).evalf() < Rational(1,10**25)
+    assert log(S.One,evaluate=False).evalf(30)==0
+    assert log(-S.One,evaluate=False).evalf(30)==(pi*S.ImaginaryUnit).evalf(30)

+    @wraps(method)
+    def wrapped(self):
+        params = json.loads(self.body)
+        token = params.pop("clientToken", None)
+        if not token:
+            return method(self)
+        parent = self._get_path_param("gatewayIdentifier") if method.__name__ == "create_gateway_target" else ""
+        key = (method.__name__, parent, token)
+        payload = json.dumps(params, sort_keys=True, separators=(",", ":"))
+        receipts = self.backend.__dict__.setdefault("_gateway_create_receipts", {})
+        if key in receipts:
+            previous, response = receipts[key]
+            if previous != payload:
+                raise ConflictException("clientToken was already used with different creation parameters")
+            return deepcopy(response)
+        result = method(self)
+        receipts[key] = (payload, deepcopy(result))
+        return result
+    return wrapped

diff --git a/tests/test_pipes/test_sf041_terminal_states.py b/tests/test_pipes/test_sf041_terminal_states.py
new file mode 100644
--- /dev/null
+++ b/tests/test_pipes/test_sf041_terminal_states.py
@@ -0,0 +1,43 @@
+import boto3
+import pytest
+from moto import mock_aws
+from moto.moto_api import state_manager
+
+def create(desired='RUNNING'):
+    client=boto3.client('pipes',region_name='eu-west-1')
+    response=client.create_pipe(Name='stable',Source='arn:aws:sqs:eu-west-1:123456789012:queue',Target='arn:aws:lambda:eu-west-1:123456789012:function:handler',RoleArn='arn:aws:iam::123456789012:role/service',DesiredState=desired)
+    assert response['CurrentState']=='CREATING'
+    return client
+
+@mock_aws
+def test_created_stopped_remains_stopped_under_polling():
+    client=create('STOPPED')
+    for _ in range(5):
+        assert client.describe_pipe(Name='stable')['CurrentState']=='STOPPED'
+        assert client.list_pipes()['Pipes'][0]['CurrentState']=='STOPPED'
+
+@mock_aws
+def test_explicit_stop_is_terminal_until_start():
+    client=create();client.stop_pipe(Name='stable')
+    for _ in range(5):assert client.describe_pipe(Name='stable')['CurrentState']=='STOPPED'
+    client.start_pipe(Name='stable')
+    for _ in range(5):assert client.describe_pipe(Name='stable')['CurrentState']=='RUNNING'
+
+@pytest.mark.parametrize('last',['RUNNING','STOPPED'])
+@mock_aws
+def test_latest_request_wins_during_delayed_transitions(last):
+    state_manager.set_transition('pipes::pipe',{'progression':'manual','times':5})
+    try:
+        client=create()
+        client.stop_pipe(Name='stable')
+        client.start_pipe(Name='stable')
+        if last=='STOPPED':client.stop_pipe(Name='stable')
+        states=[client.describe_pipe(Name='stable') for _ in range(16)]
+        assert all(row['DesiredState']==last for row in states)
+        assert all(row['CurrentState']==last for row in states[-5:])
+    finally:state_manager.unset_transition('pipes::pipe')
+
+@mock_aws
+def test_default_creation_regression():
+    client=create()
+    assert client.describe_pipe(Name='stable')['CurrentState']=='RUNNING'

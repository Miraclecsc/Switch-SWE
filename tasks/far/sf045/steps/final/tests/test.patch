+++ b/networkx/algorithms/approximation/tests/test_sf045_seeded_domination.py
@@ -0,0 +1,34 @@
+import networkx as nx
+import pytest
+from networkx.algorithms.approximation import min_weighted_dominating_set as dominate
+
+def test_seed_is_retained_and_coverage_is_removed():
+    graph=nx.cycle_graph(5);seed=[0]
+    result=dominate(graph,start_with=seed,forbidden={1,2})
+    assert result=={0,3} and nx.is_dominating_set(graph,result)
+    assert seed==[0]
+
+def test_already_dominating_seed_adds_nothing():
+    graph=nx.star_graph(5)
+    assert dominate(graph,start_with=(node for node in [0]))=={0}
+
+def test_zero_weight_and_forbidden_targets():
+    graph=nx.path_graph(['a',1,'b',2]);nx.set_node_attributes(graph,1,'cost');graph.nodes[1]['cost']=0
+    result=dominate(graph,weight='cost',start_with={2},forbidden={'a','b'})
+    assert result=={1,2} and nx.is_dominating_set(graph,result)
+
+def test_infeasible_constraints_are_explicit():
+    graph=nx.empty_graph(2)
+    with pytest.raises(nx.NetworkXUnfeasible):dominate(graph,forbidden={1})
+    with pytest.raises(nx.NetworkXUnfeasible):dominate(nx.path_graph(3),forbidden={0,1,2})
+
+def test_invalid_constraints_and_input_preservation():
+    graph=nx.path_graph(3);saved=graph.copy()
+    with pytest.raises(nx.NetworkXError):dominate(graph,start_with={9})
+    with pytest.raises(nx.NetworkXError):dominate(graph,start_with={1},forbidden={1})
+    with pytest.raises(nx.NetworkXError):dominate(graph,forbidden={9})
+    assert nx.utils.graphs_equal(graph,saved)
+
+def test_original_unconstrained_regression():
+    graph=nx.path_graph(5)
+    assert nx.is_dominating_set(graph,dominate(graph))

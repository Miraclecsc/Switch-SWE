@@ -0,0 +1,43 @@
+import json
+import boto3
+import pytest
+from moto import mock_aws
+
+def setup(raw=True):
+    sns=boto3.client('sns',region_name='us-east-1');sqs=boto3.client('sqs',region_name='us-east-1')
+    url=sqs.create_queue(QueueName='payload')['QueueUrl']
+    arn=sqs.get_queue_attributes(QueueUrl=url,AttributeNames=['QueueArn'])['Attributes']['QueueArn']
+    topic=sns.create_topic(Name='payload')['TopicArn']
+    sns.subscribe(TopicArn=topic,Protocol='sqs',Endpoint=arn,Attributes={'RawMessageDelivery':str(raw).lower(),'FilterPolicyScope':'MessageBody','FilterPolicy':json.dumps({'kind':['wanted']})})
+    return sns,sqs,url,topic
+
+@pytest.mark.parametrize('raw',[True,False])
+@mock_aws
+def test_selected_protocol_body_matches_and_is_preserved(raw):
+    sns,sqs,url,topic=setup(raw)
+    body=' {"kind": "wanted", "text": "雪"} '
+    sns.publish(TopicArn=topic,MessageStructure='json',Message=json.dumps({'default':'{"kind":"other"}','sqs':body}))
+    messages=sqs.receive_message(QueueUrl=url).get('Messages',[])
+    assert len(messages)==1
+    received=messages[0]['Body'] if raw else json.loads(messages[0]['Body'])['Message']
+    assert received==body
+
+@mock_aws
+def test_default_payload_fallback_is_filtered():
+    sns,sqs,url,topic=setup()
+    body='{"kind":"wanted","number":3}'
+    sns.publish(TopicArn=topic,MessageStructure='json',Message=json.dumps({'default':body}))
+    assert sqs.receive_message(QueueUrl=url)['Messages'][0]['Body']==body
+
+@mock_aws
+def test_wrapper_match_cannot_override_selected_nonmatch():
+    sns,sqs,url,topic=setup()
+    sns.publish(TopicArn=topic,MessageStructure='json',Message=json.dumps({'kind':'wanted','default':'{"kind":"wanted"}','sqs':'{"kind":"other"}'}))
+    assert not sqs.receive_message(QueueUrl=url).get('Messages')
+
+@mock_aws
+def test_ordinary_missing_attribute_message_regression():
+    sns,sqs,url,topic=setup()
+    body='{"kind":"wanted"}'
+    sns.publish(TopicArn=topic,Message=body)
+    assert sqs.receive_message(QueueUrl=url)['Messages'][0]['Body']==body

@@ -0,0 +1,162 @@
+"""Public behavioral regressions for sf003-v1; no implementation-shape checks."""
+from __future__ import annotations
+
+import os
+import pathlib
+
+import pytest
+
+from anyio import CapacityLimiter, Path, to_thread
+
+
+async def test_with_limiter_is_distinct_and_does_no_io(tmp_path, monkeypatch):
+    first, second = CapacityLimiter(2), CapacityLimiter(3)
+    source = Path(tmp_path / "missing" / "file", limiter=first)
+    previous_child = source / "child"
+
+    async def unexpected_io(*args, **kwargs):
+        raise AssertionError("with_limiter must not dispatch worker-thread I/O")
+
+    monkeypatch.setattr(to_thread, "run_sync", unexpected_io)
+    replacement = source.with_limiter(second)
+    unchanged_choice = source.with_limiter(first)
+    cleared = source.with_limiter(None)
+    assert replacement is not source
+    assert unchanged_choice is not source
+    assert cleared is not source
+    assert os.fspath(replacement) == os.fspath(source) == os.fspath(cleared)
+    assert replacement.limiter is second
+    assert unchanged_choice.limiter is first
+    assert cleared.limiter is None
+    assert source.limiter is first
+    assert previous_child.limiter is first
+
+
+@pytest.mark.parametrize("operation", ["copy", "child", "several_segments"])
+async def test_copy_inherits_first_path_limiter(tmp_path, operation):
+    limiter = CapacityLimiter(2)
+    source = Path(tmp_path, limiter=limiter)
+    parts = {"copy": (), "child": ("child",), "several_segments": ("a", "b")}
+    result = Path(source, *parts[operation])
+    assert result is not source
+    assert os.fspath(result) == os.fspath(pathlib.Path(tmp_path, *parts[operation]))
+    assert result.limiter is limiter
+    assert source.limiter is limiter
+    assert result.parent.limiter is limiter
+    assert (result / "leaf").limiter is limiter
+
+
+async def test_copy_explicit_override_and_clear(tmp_path):
+    first, second = CapacityLimiter(2), CapacityLimiter(3)
+    source = Path(tmp_path, limiter=first)
+    overridden = Path(source, "child", limiter=second)
+    cleared = Path(source, "child", limiter=None)
+    assert overridden.limiter is second
+    assert overridden.parent.limiter is second
+    assert cleared.limiter is None
+    assert cleared.parent.limiter is None
+    assert source.limiter is first
+    assert Path(cleared).limiter is None
+    assert Path(overridden).limiter is second
+
+
+async def test_later_path_argument_does_not_supply_limiter(tmp_path):
+    first, second = CapacityLimiter(2), CapacityLimiter(3)
+    later = Path("child", limiter=second)
+    plain_first = Path(str(tmp_path), later)
+    path_first = Path(Path(tmp_path, limiter=first), later)
+    assert plain_first.limiter is None
+    assert path_first.limiter is first
+    assert os.fspath(plain_first) == os.fspath(path_first)
+    assert later.limiter is second
+
+
+async def test_copy_after_reconfiguration_iteration_and_open(tmp_path):
+    (tmp_path / "one").write_text("payload")
+    first, second = CapacityLimiter(2), CapacityLimiter(3)
+    source = Path(tmp_path, limiter=first)
+    updated = Path(source.with_limiter(second))
+    assert updated.limiter is second
+    children = [child async for child in updated.iterdir()]
+    assert len(children) == 1
+    assert children[0].limiter is second
+    async with await children[0].open() as opened:
+        assert opened.limiter is second
+        assert await opened.read() == "payload"
+    for method in (updated.glob, updated.rglob):
+        result = [child async for child in method("*")]
+        assert len(result) == 1
+        assert result[0].limiter is second
+    assert source.limiter is first
+
+
+async def test_existing_and_new_file_operations_use_separate_limiters(tmp_path, monkeypatch):
+    (tmp_path / "payload").write_text("abc")
+    first, second = CapacityLimiter(2), CapacityLimiter(3)
+    source = Path(tmp_path / "payload", limiter=first)
+    old_file = await source.open("r+")
+    new_path = source.with_limiter(second)
+    new_file = await new_path.open("r+")
+    run_sync = to_thread.run_sync
+    seen = []
+
+    async def record_call(func, *args, **kwargs):
+        seen.append(kwargs.get("limiter"))
+        return await run_sync(func, *args, **kwargs)
+
+    monkeypatch.setattr(to_thread, "run_sync", record_call)
+    try:
+        assert await old_file.read() == "abc"
+        assert seen == [first]
+        seen.clear()
+        assert await new_file.read() == "abc"
+        assert seen == [second]
+        seen.clear()
+        await old_file.write("x")
+        assert seen == [first]
+        seen.clear()
+        await new_file.write("y")
+        assert seen == [second]
+        assert old_file.limiter is first
+        assert new_file.limiter is second
+        assert source.limiter is first
+    finally:
+        await old_file.aclose()
+        await new_file.aclose()
+
+
+async def test_read_only_properties_and_shared_capacity(tmp_path):
+    (tmp_path / "payload").write_text("abc")
+    limiter = CapacityLimiter(2)
+    source = Path(tmp_path / "payload", limiter=limiter)
+    copied = Path(source)
+    sibling = source.with_limiter(limiter)
+    async with await source.open() as opened:
+        for obj in (source, copied, sibling, opened):
+            with pytest.raises(AttributeError):
+                obj.limiter = None
+            with pytest.raises(AttributeError):
+                del obj.limiter
+            assert obj.limiter is limiter
+        limiter.total_tokens = 7
+        assert all(obj.limiter.total_tokens == 7 for obj in (source, copied, sibling, opened))
+
+
+@pytest.mark.parametrize("invalid", [1, False, "default", object()])
+async def test_invalid_reconfiguration_does_not_mutate_source(tmp_path, invalid):
+    limiter = CapacityLimiter(2)
+    source = Path(tmp_path, limiter=limiter)
+    with pytest.raises(TypeError):
+        source.with_limiter(invalid)
+    assert source.limiter is limiter
+    assert os.fspath(source) == os.fspath(tmp_path)
+
+
+async def test_reconfigured_clear_stays_clear_in_copies(tmp_path):
+    limiter = CapacityLimiter(2)
+    source = Path(tmp_path, limiter=limiter)
+    cleared = source.with_limiter(None)
+    assert Path(cleared).limiter is None
+    assert Path(cleared, "child").limiter is None
+    assert (cleared / "child").limiter is None
+    assert source.limiter is limiter

+import copy
+import boto3
+import pytest
+from botocore.exceptions import ClientError
+from moto import mock_aws
+
+
+def fixture():
+    c = boto3.client("dynamodb", region_name="us-east-1")
+    c.create_table(TableName="composite", BillingMode="PAY_PER_REQUEST",
+        KeySchema=[{"AttributeName":"pk","KeyType":"HASH"}],
+        AttributeDefinitions=[{"AttributeName":n,"AttributeType":t} for n,t in
+                              [("pk","S"),("g","S"),("r1","S"),("r2","N")]],
+        GlobalSecondaryIndexes=[{"IndexName":"composite-index",
+            "KeySchema":[{"AttributeName":"g","KeyType":"HASH"},
+                         {"AttributeName":"r1","KeyType":"RANGE"},{"AttributeName":"r2","KeyType":"RANGE"}],
+            "Projection":{"ProjectionType":"ALL"}}])
+    for i in range(4):
+        c.put_item(TableName="composite", Item={"pk":{"S":str(i)}, "g":{"S":"tenant"},
+            "r1":{"S":"group"}, "r2":{"N":str(i)}})
+    return c
+
+
+def query(c, **kwargs):
+    return c.query(TableName="composite",IndexName="composite-index",
+        KeyConditionExpression="g = :g",ExpressionAttributeValues={":g":{"S":"tenant"}}, **kwargs)
+
+
+@pytest.mark.parametrize("change", ["missing_index_key","missing_table_key","wrong_type","foreign_partition","extra_attribute"])
+@mock_aws
+def test_invalid_composite_start_key_is_validation_error(change):
+    c = fixture()
+    cursor = query(c,Limit=1)["LastEvaluatedKey"]
+    if change == "missing_index_key": cursor.pop("r2")
+    elif change == "missing_table_key": cursor.pop("pk")
+    elif change == "wrong_type": cursor["r2"] = {"S":"0"}
+    elif change == "foreign_partition": cursor["g"] = {"S":"elsewhere"}
+    else: cursor["not_a_key"] = {"S":"extra"}
+    with pytest.raises(ClientError) as caught:
+        query(c,ExclusiveStartKey=cursor)
+    assert caught.value.response["Error"]["Code"] == "ValidationException"
+
+
+@mock_aws
+def test_deleted_start_item_and_numeric_cursor_spelling_still_resume():
+    c = fixture()
+    first = query(c,Limit=2)
+    cursor = first["LastEvaluatedKey"]
+    saved = copy.deepcopy(cursor)
+    cursor["r2"] = {"N":"1.00"}
+    c.delete_item(TableName="composite",Key={"pk":cursor["pk"]})
+    result = query(c,ExclusiveStartKey=cursor)
+    assert [i["pk"]["S"] for i in result["Items"]] == ["2","3"]
+    assert saved["r2"] == {"N":"1"}
+    assert cursor["r2"] == {"N":"1.00"}
+
+
+@mock_aws
+def test_reverse_paging_visits_each_composite_key_once():
+    c = fixture()
+    first = query(c,Limit=2,ScanIndexForward=False)
+    second = query(c,ExclusiveStartKey=first["LastEvaluatedKey"],ScanIndexForward=False)
+    assert [i["pk"]["S"] for i in first["Items"]+second["Items"]] == ["3","2","1","0"]

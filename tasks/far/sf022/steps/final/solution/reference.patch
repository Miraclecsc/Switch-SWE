+    _DDL_IDENTIFIER = r"(?:`(?:``|[^`])+`|[A-Za-z_][A-Za-z0-9_]*)"
+    _DDL_STRING = r"'(?:''|[^'])*'"
+    _CREATE_DB_PATTERN = re.compile(
+        rf"\s*CREATE\s+(?:DATABASE|SCHEMA)\s+(?:IF\s+NOT\s+EXISTS\s+)?"
+        rf"(?P<name>{_DDL_IDENTIFIER})"
+        rf"(?:\s+COMMENT\s+(?P<comment>{_DDL_STRING}))?"
+        rf"(?:\s+WITH\s+DBPROPERTIES\s*\((?P<properties>.*)\))?\s*;?\s*",
+        re.IGNORECASE | re.DOTALL,
+    )
+    _DROP_DB_PATTERN = re.compile(
+        rf"\s*DROP\s+(?:DATABASE|SCHEMA)\s+(?:IF\s+EXISTS\s+)?"
+        rf"(?P<name>{_DDL_IDENTIFIER})(?:\s+(?:RESTRICT|CASCADE))?\s*;?\s*",
+        re.IGNORECASE,
+    )
+
+    def _process_ddl(self, query: str, context: Optional[str]) -> None:
+        catalog_name = context.get("Catalog", "AwsDataCatalog") if isinstance(context, dict) else "AwsDataCatalog"
+        create = self._CREATE_DB_PATTERN.fullmatch(query)
+        drop = self._DROP_DB_PATTERN.fullmatch(query)
+        match = create or drop
+        if not match:
+            return
+        name = match.group("name")
+        name = (name[1:-1].replace("``", "`") if name.startswith("`") else name).lower()
+        key = (catalog_name, name)
+        if drop:
+            self.databases.pop(key, None)
+            return
+        properties = {}
+        raw = create.group("properties")
+        if raw is not None:
+            pair = rf"({self._DDL_STRING})\s*=\s*({self._DDL_STRING})"
+            if not re.fullmatch(rf"\s*(?:{pair}(?:\s*,\s*{pair})*)?\s*", raw, re.DOTALL):
+                return
+            properties = {k[1:-1].replace("''", "'"): v[1:-1].replace("''", "'")
+                          for k, v in re.findall(pair, raw, re.DOTALL)}
+        comment = create.group("comment")
+        if key not in self.databases:
+            self.databases[key] = Database(
+                catalog_name=catalog_name, database_name=name,
+                description=comment[1:-1].replace("''", "'") if comment else "",
+                parameters=properties,
+            )
+
+
+    def get_database(self, catalog_name: str, database_name: str) -> dict[str, Any]:
+        key = (catalog_name, database_name.lower())
+        if key not in self.databases:
+            raise MetadataException(
+                f"An error occurred (EntityNotFoundException) when calling the "
+                f"GetDatabase operation: Database {database_name} not found. "
+                f"(Service: AmazonDataCatalog; Status Code: 400; "
+                f"Error Code: EntityNotFoundException)"
+            )
+        db = self.databases[key]
+        return {
+            "Name": db.name,
+            "Description": db.description,
+            "Parameters": db.parameters,
+        }
+
+    @paginate(pagination_model=PAGINATION_MODEL)
+    def list_databases(self, catalog_name: str) -> list[Database]:
+        all_dbs = [
+            db for db in self.databases.values() if db.catalog_name == catalog_name
+        ]
+        all_dbs.sort(key=lambda d: d.name)
+        return all_dbs
+

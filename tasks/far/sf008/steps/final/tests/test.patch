@@ -0,0 +1,62 @@
+from django.db import models
+from django.test import SimpleTestCase
+from django.test.utils import isolate_apps
+
+
+class ReservedManagerAccessorTests(SimpleTestCase):
+    def assert_reserved(self, field_type):
+        for alias in ["_base_manager", "_default_manager"]:
+            with isolate_apps("invalid_models_tests"):
+                class Target(models.Model):
+                    class Meta:
+                        app_label = "invalid_models_tests"
+                kwargs = {"related_name":alias}
+                if field_type is not models.ManyToManyField:
+                    kwargs["on_delete"] = models.CASCADE
+                field = field_type(Target, **kwargs)
+                try:
+                    class Source(models.Model):
+                        link = field
+                        class Meta:
+                            app_label = "invalid_models_tests"
+                except AttributeError as exc:
+                    self.fail(f"An invalid reverse name must be diagnosed by system checks, not crash model construction: {exc}")
+                errors = Source._meta.get_field("link").check(from_model=Source)
+                matches = [e for e in errors if e.id == "fields.E348"]
+                self.assertEqual(len(matches), 1)
+                self.assertIs(matches[0].obj, Source._meta.get_field("link"))
+                self.assertIn(alias, matches[0].msg)
+                self.assertIsInstance(Target._base_manager, models.Manager)
+                self.assertIsInstance(Target._default_manager, models.Manager)
+
+    def test_foreign_key_reserved_accessor(self):
+        self.assert_reserved(models.ForeignKey)
+
+    def test_one_to_one_reserved_accessor(self):
+        self.assert_reserved(models.OneToOneField)
+
+    def test_many_to_many_reserved_accessor(self):
+        self.assert_reserved(models.ManyToManyField)
+
+    @isolate_apps("invalid_models_tests")
+    def test_hidden_reverse_name_remains_valid(self):
+        class Target(models.Model):
+            class Meta:
+                app_label = "invalid_models_tests"
+        class Source(models.Model):
+            link = models.ForeignKey(Target, on_delete=models.CASCADE, related_name="_base_manager+")
+            class Meta:
+                app_label = "invalid_models_tests"
+        self.assertNotIn("fields.E348", [e.id for e in Source._meta.get_field("link").check()])
+
+    @isolate_apps("invalid_models_tests")
+    def test_ordinary_reverse_accessor_is_installed(self):
+        class Target(models.Model):
+            class Meta:
+                app_label = "invalid_models_tests"
+        class Source(models.Model):
+            link = models.ForeignKey(Target, on_delete=models.CASCADE, related_name="links")
+            class Meta:
+                app_label = "invalid_models_tests"
+        self.assertNotIn("fields.E348", [e.id for e in Source._meta.get_field("link").check()])
+        self.assertTrue(hasattr(Target, "links"))

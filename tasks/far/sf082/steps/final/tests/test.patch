--- /dev/null
+++ b/tests/test_sf082_extension.py
@@ -0,0 +1,44 @@
+import pytest
+from packaging import tags
+
+def setup_target(monkeypatch, version):
+    calls = []
+    monkeypatch.setattr(tags, "_get_glibc_version", lambda: version)
+    monkeypatch.setattr(tags, "_is_manylinux_compatible", lambda name, arch, ver: calls.append((name,arch,ver)) or True)
+    return calls
+
+def test_inclusive_floor_and_alias_priority(monkeypatch):
+    calls = setup_target(monkeypatch, (2,18))
+    assert list(tags._manylinux_tags("linux_x86_64", "x86_64", minimum_glibc=(2,17))) == ["manylinux_2_18_x86_64","manylinux_2_17_x86_64","manylinux2014_x86_64"]
+    assert all(version >= (2,17) for name,arch,version in calls)
+
+def test_alias_suppression_keeps_hook(monkeypatch):
+    setup_target(monkeypatch, (2,17))
+    monkeypatch.setattr(tags, "_is_manylinux_compatible", lambda name,arch,version: version != (2,16))
+    result = list(tags._manylinux_tags("linux_x86_64", "x86_64", minimum_glibc=(2,15), legacy=False))
+    assert result == ["manylinux_2_17_x86_64", "manylinux_2_15_x86_64"]
+
+def test_architecture_floor_and_empty(monkeypatch):
+    calls = setup_target(monkeypatch, (2,17))
+    assert list(tags._manylinux_tags("linux_aarch64", "aarch64", minimum_glibc=(2,5), legacy=False)) == ["manylinux_2_17_aarch64"]
+    calls[:] = []
+    assert list(tags._manylinux_tags("linux_aarch64", "aarch64", minimum_glibc=(2,18))) == []
+    assert calls == []
+
+def test_explicit_history(monkeypatch):
+    setup_target(monkeypatch, (3,1))
+    bounds = {2:18}
+    before = dict(tags._LAST_GLIBC_MINOR)
+    result = list(tags._manylinux_tags("linux_x86_64", "x86_64", minimum_glibc=(2,17), glibc_max_minor=bounds))
+    assert result == ["manylinux_3_1_x86_64","manylinux_3_0_x86_64","manylinux_2_18_x86_64","manylinux_2_17_x86_64","manylinux2014_x86_64"]
+    assert bounds == {2:18} and dict(tags._LAST_GLIBC_MINOR) == before
+
+def test_history_only_for_traversed_majors(monkeypatch):
+    setup_target(monkeypatch, (4,1))
+    assert list(tags._manylinux_tags("linux_x86_64", "x86_64", minimum_glibc=(4,0), glibc_max_minor={})) == ["manylinux_4_1_x86_64","manylinux_4_0_x86_64"]
+    with pytest.raises(ValueError):
+        list(tags._manylinux_tags("linux_x86_64", "x86_64", minimum_glibc=(2,17), glibc_max_minor={3:1}))
+
+def test_original_default_alias(monkeypatch):
+    setup_target(monkeypatch, (2,5))
+    assert list(tags._manylinux_tags("linux_x86_64", "x86_64")) == ["manylinux_2_5_x86_64","manylinux1_x86_64"]

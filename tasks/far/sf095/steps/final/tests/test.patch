--- /dev/null
+++ b/src/trio/_core/_tests/test_sf095_extension.py
@@ -0,0 +1,42 @@
+import math
+import pytest
+import trio
+from trio.testing import MockClock
+
+def test_relative_clone_outside_run():
+    source=trio.CancelScope(relative_deadline=5,shield=True)
+    clone=source.clone()
+    assert clone is not source and clone.is_relative is True
+    assert clone.relative_deadline==5 and clone.shield is True
+    with pytest.raises(RuntimeError): source.deadline=10
+    assert source.relative_deadline==5
+
+def test_mode_override_is_new_object():
+    source=trio.CancelScope(relative_deadline=5)
+    absolute=source.clone(deadline=20,shield=True)
+    assert absolute.deadline==20 and absolute.is_relative is False
+    relative=absolute.clone(relative_deadline=3)
+    assert relative.relative_deadline==3 and relative.shield is True
+    assert source.relative_deadline==5 and source.shield is False
+
+@pytest.mark.parametrize("options",[{"deadline":1,"relative_deadline":2},{"deadline":math.nan},{"relative_deadline":-1}])
+def test_invalid_clone_preserves_source(options):
+    source=trio.CancelScope(relative_deadline=5)
+    with pytest.raises(ValueError):source.clone(**options)
+    assert source.relative_deadline==5
+
+def test_entered_and_cancelled_source_snapshot():
+    async def main():
+        with trio.CancelScope(relative_deadline=5) as source:
+            absolute=source.deadline
+            clone=source.clone()
+            assert clone.deadline==absolute and clone.is_relative is False
+            source.cancel()
+            await trio.lowlevel.checkpoint()
+        assert source.cancelled_caught
+        fresh=source.clone(relative_deadline=2)
+        assert not fresh.cancel_called and not fresh.cancelled_caught
+        with fresh:
+            await trio.sleep(1)
+        assert not fresh.cancelled_caught
+    trio.run(main,clock=MockClock(autojump_threshold=0))

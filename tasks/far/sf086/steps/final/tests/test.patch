diff --git a/tests/test_sf086_extension.py b/tests/test_sf086_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf086_extension.py
@@ -0,0 +1,37 @@
+import pytest
+from packaging import tags
+
+@pytest.mark.parametrize("threading,stable",[(True,False),(False,True)])
+def test_explicit_policy(threading,stable):
+    result=list(tags.cpython_tags((3,13),["opaque"],["target"],threading=threading))
+    assert any(t.abi == "abi3" for t in result) is stable
+    assert result[0] == tags.Tag("cp313","opaque","target")
+    assert tags.Tag("cp313","none","target") in result
+
+@pytest.mark.parametrize("threading,expected",[(True,"cp313td"),(False,"cp313d")])
+def test_generated_policy_avoids_host(monkeypatch,threading,expected):
+    def config(name,warn=False):
+        assert name != "Py_NOGIL"
+        return name == "Py_DEBUG"
+    monkeypatch.setattr(tags,"_get_config_var",config)
+    result=list(tags.cpython_tags((3,13),platforms=["target"],threading=threading,warn=True))
+    assert result[0].abi == expected
+    assert any(t.abi == "abi3" for t in result) is (not threading)
+
+def test_all_abis_one_shot(monkeypatch):
+    monkeypatch.setattr(tags,"_get_config_var",lambda *a,**kw:pytest.fail("host inspected"))
+    result=list(tags.cpython_tags((3,13),iter(["opaque","cp313td"]),["target"]))
+    assert [t.abi for t in result] == ["opaque","cp313td","none"]
+
+def test_opaque_t_not_a_flag():
+    result=list(tags.cpython_tags((3,13),["cp313custom"],["target"]))
+    assert tags.Tag("cp313","abi3","target") in result
+
+def test_pre313_explicit_policy(monkeypatch):
+    monkeypatch.setattr(tags,"_get_config_var",lambda name,warn=False:0)
+    result=list(tags.cpython_tags((3,12),platforms=["target"],threading=True))
+    assert result[0].abi == "cp312"
+    assert all(t.abi != "abi3" for t in result)
+
+def test_original_free_threading():
+    assert [t.abi for t in tags.cpython_tags((3,13),["cp313t"],["target"])] == ["cp313t","none"]

@@ -0,0 +1,39 @@
+import pytest
+import requests
+from moto import mock_aws
+BASE='http://169.254.169.254/latest'
+
+@pytest.mark.parametrize('ttl',[None,'0','21601','-1','abc','1.5'])
+@mock_aws
+def test_invalid_ttl_is_bad_request(ttl):
+    headers={} if ttl is None else {'X-Aws-Ec2-Metadata-Token-Ttl-Seconds':ttl}
+    assert requests.put(BASE+'/api/token',headers=headers).status_code==400
+
+@mock_aws
+def test_token_methods_forwarding_and_ttl_echo():
+    result=requests.get(BASE+'/api/token')
+    assert result.status_code==405 and result.headers['Allow']=='PUT'
+    assert requests.put(BASE+'/api/token',headers={'x-aws-ec2-metadata-token-ttl-seconds':'10','X-Forwarded-For':'192.0.2.1'}).status_code==403
+    result=requests.put(BASE+'/api/token',headers={'X-AWS-EC2-METADATA-TOKEN-TTL-SECONDS':'10'})
+    assert result.status_code==200 and result.text=='fake-imdsv2-token'
+    assert result.headers['x-aws-ec2-metadata-token-ttl-seconds']=='10'
+
+@mock_aws
+def test_invalid_supplied_token_is_rejected():
+    assert requests.get(BASE+'/meta-data/instance-id',headers={'X-Aws-Ec2-Metadata-Token':'wrong'}).status_code==401
+    assert requests.get(BASE+'/meta-data/instance-id').text=='i-fake'
+
+@mock_aws
+def test_head_directory_and_unknown_path():
+    response=requests.head(BASE+'/meta-data/instance-id')
+    assert response.status_code==200 and response.content==b''
+    assert response.headers['Content-Length']==str(len('i-fake'))
+    listing=requests.get(BASE+'/meta-data/placement/')
+    assert listing.status_code==200
+    assert set(listing.text.splitlines())=={'availability-zone','availability-zone-id','region'}
+    assert requests.get(BASE+'/meta-data/no-such-value').status_code==404
+
+@mock_aws
+def test_fixed_root_and_common_value_regression():
+    assert requests.get(BASE+'/meta-data/').content==b'iam'
+    assert requests.get(BASE+'/meta-data/ami-id').text=='ami-moto-virtual'

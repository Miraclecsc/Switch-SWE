@@ -0,0 +1,49 @@
+import copy
+import pickle
+import pytest
+from sympy import Integer, Rational, Symbol
+from sympy.combinatorics.free_groups import free_group
+
+class Indexable:
+    def __index__(self):return 3
+
+def test_validated_generator_iterable_is_canonical():
+    group,x,y=free_group('x,y'); a,b=group.symbols
+    raw=[[a,Indexable()],[b,Integer(2)],[b,-2],[a,-1]]
+    result=group.dtype(pair for pair in raw)
+    assert result==x**2
+    assert hash(result)==hash(x**2)
+    assert raw[0][1].__index__()==3 and len(raw)==4
+
+@pytest.mark.parametrize('exponent',[1.0,Rational(1,2),Symbol('n'),'2'])
+def test_nonintegral_exponents_rejected(exponent):
+    group,x=free_group('x')
+    with pytest.raises(TypeError):group.dtype([(group.symbols[0],exponent)])
+
+def test_unknown_generator_even_with_zero_exponent():
+    group,x=free_group('x')
+    for exponent in [0,1]:
+        with pytest.raises(ValueError):group.dtype([(Symbol('alien'),exponent)])
+
+def test_cross_group_constructor_rejected():
+    group,x=free_group('x'); other,x2,y2=free_group('x,y')
+    with pytest.raises(ValueError):group.dtype(x2)
+    assert group.dtype(x)==x
+
+@pytest.mark.parametrize('protocol',[2,pickle.HIGHEST_PROTOCOL])
+def test_pickle_roundtrip_group_identity_and_dictionary(protocol):
+    group,x,y=free_group('x,y')
+    word=x**3*y**-2*x**-1
+    original={word:'value',group.identity:'identity'}
+    restored=pickle.loads(pickle.dumps(original,protocol=protocol))
+    assert restored[word]=='value' and restored[group.identity]=='identity'
+    for key in restored:
+        assert key.group is group
+        assert type(key) is group.dtype
+        assert key*key.inverse()==group.identity
+    cloned=copy.deepcopy(word)
+    assert cloned==word and hash(cloned)==hash(word)
+
+def test_original_cascading_reduction_regression():
+    group,x,y=free_group('x,y');a,b=group.symbols
+    assert group.dtype([(a,1),(b,2),(b,-2),(a,-1)])==group.identity

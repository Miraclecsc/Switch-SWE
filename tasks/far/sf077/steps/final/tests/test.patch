diff --git a/tests/test_sf077_extension.py b/tests/test_sf077_extension.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf077_extension.py
@@ -0,0 +1,37 @@
+import pytest
+from packaging.ranges import VersionRange
+from packaging.specifiers import SpecifierSet
+
+def r(spec, policy=None):
+    return SpecifierSet(spec, prereleases=policy).to_range()
+
+@pytest.mark.parametrize("left,right,samples,want", [
+    (">=1,<3", ">=2,<4", ["0", "1", "2", "3", "4"], [False, True, False, True, False]),
+    ("===1.0", "==1", ["1.0", "1.0.0", "1.0+local", "2"], [False, True, True, False]),
+    ("===banana", "===pear", ["banana", "BANANA", "pear", "apple", "1"], [True, True, True, False, False]),
+])
+def test_xor_membership(left, right, samples, want):
+    a, b = r(left), r(right)
+    before = repr(a), repr(b)
+    x = a.symmetric_difference(b)
+    assert [item in x for item in samples] == want
+    assert [item in (a ^ b) for item in samples] == want
+    assert x == b.symmetric_difference(a)
+    assert (repr(a), repr(b)) == before
+
+@pytest.mark.parametrize("policy", [None, True, False])
+def test_identity_and_policy(policy):
+    a = r(">=1", policy)
+    assert a.symmetric_difference(VersionRange.empty(prereleases=policy)) == a
+    assert (a ^ a).is_empty
+
+@pytest.mark.parametrize("left,right", [(None, True), (True, False), (False, None)])
+def test_reject_mismatched_policy_even_empty(left, right):
+    with pytest.raises(ValueError):
+        VersionRange.empty(prereleases=left).symmetric_difference(r(">=1", right))
+
+def test_operator_protocol():
+    a = r(">=1")
+    assert a.__xor__(object()) is NotImplemented
+    with pytest.raises(TypeError):
+        a ^ 1

@@ -0,0 +1,45 @@
+import pytest
+from starlette.datastructures import Headers
+from starlette.formparsers import FormParser,MultiPartException
+
+class Tracking(FormParser):
+    started=0
+    completed=0
+    def on_field_start(self):
+        self.started+=1
+        return super().on_field_start()
+    def on_field_end(self):
+        self.completed+=1
+        return super().on_field_end()
+
+async def stream(chunks):
+    for chunk in chunks:yield chunk
+    yield b''
+
+@pytest.mark.anyio
+async def test_one_chunk_field_limit_stops_callbacks():
+    parser=Tracking(Headers(),stream([b'a=1&b=2&c=3&d=4']),max_fields=1)
+    with pytest.raises(MultiPartException,match='Too many fields'):await parser.parse()
+    assert parser.started==2 and parser.completed==1
+
+@pytest.mark.anyio
+@pytest.mark.parametrize('body',[b'abcdef=1&z=2',b'a=123456&z=2'])
+async def test_oversized_field_aborts_before_end(body):
+    parser=Tracking(Headers(),stream([body]),max_part_size=3)
+    with pytest.raises(MultiPartException,match='Field exceeded'):await parser.parse()
+    assert parser.completed==0 and parser.started==1
+
+@pytest.mark.anyio
+async def test_split_budget_rejects_without_reading_rest():
+    consumed=[]
+    async def chunks():
+        for chunk in [b'ab=',b'12',b'345',b'&must=not-read']:
+            consumed.append(chunk);yield chunk
+    parser=Tracking(Headers(),chunks(),max_part_size=4)
+    with pytest.raises(MultiPartException):await parser.parse()
+    assert consumed==[b'ab=',b'12',b'345'] and parser.completed==0
+
+@pytest.mark.anyio
+async def test_exact_boundary_decoding_duplicates_and_infinite_count():
+    result=await FormParser(Headers(),stream([b'a=%',b'32&a=',b'3']),max_fields=float('inf'),max_part_size=4).parse()
+    assert result.multi_items()==[('a','2'),('a','3')]

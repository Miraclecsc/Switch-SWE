diff --git a/tests/test_sf037_state_mapping_copy.py b/tests/test_sf037_state_mapping_copy.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf037_state_mapping_copy.py
@@ -0,0 +1,54 @@
+import copy
+from collections.abc import MutableMapping
+from starlette.datastructures import State
+from starlette.requests import Request
+from starlette.websockets import WebSocket
+
+def test_mapping_views_update_and_attribute_alias():
+    raw={'a':1};state=State(raw)
+    assert isinstance(state,MutableMapping)
+    keys,items=state.keys(),state.items()
+    state.b=2
+    assert set(keys)=={'a','b'} and ('b',2) in items
+    state.update(c=3);assert raw['c']==3
+    assert state.setdefault('a',9)==1
+    assert state.pop('b')==2 and 'b' not in raw
+    assert dict(state)=={'a':1,'c':3}
+    state.clear();assert raw=={}
+
+def test_mapping_method_name_collision():
+    state=State({'items':'payload','keys':3})
+    assert state['items']=='payload' and state['keys']==3
+    assert dict(state.items())=={'items':'payload','keys':3}
+
+def test_shallow_copy_preserves_nested_alias_only():
+    class Derived(State):pass
+    source=Derived({'value':[1]});result=copy.copy(source)
+    assert type(result) is Derived and result is not source
+    result['other']=2;assert 'other' not in source
+    result['value'].append(3);assert source['value']==[1,3]
+
+def test_deep_copy_preserves_cycles_and_isolation():
+    source=State({'value':[1]});source['self']=source
+    result=copy.deepcopy(source)
+    assert result is not source and result['self'] is result
+    result['value'].append(2);assert source['value']==[1]
+
+def test_typed_websocket_and_request_share_scope_state():
+    shared={}
+    async def channel(*args):return {'type':'websocket.connect'}
+    websocket=WebSocket[dict[str,int]]({'type':'websocket','state':shared},channel,channel)
+    request=Request({'type':'http','state':shared})
+    websocket.state['count']=4
+    assert request.state.count==4
+    request.state.extra=5
+    assert websocket.state['extra']==5
+
+def test_missing_key_and_attribute_remain_distinct():
+    state=State()
+    try:state['missing']
+    except KeyError:pass
+    else:assert False
+    try:state.missing
+    except AttributeError:pass
+    else:assert False

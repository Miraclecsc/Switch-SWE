new file mode 100644
index 0000000000..ece91db712
--- /dev/null
+++ b/tests/admin_views/test_action_object_permissions_v1.py
@@ -0,0 +1,59 @@
+from unittest.mock import patch
+from django.contrib.admin.helpers import ACTION_CHECKBOX_NAME
+from django.contrib.auth import get_user_model
+from django.test import TestCase, override_settings
+from django.urls import reverse
+from .admin import CustomManagerAdmin, restore_filtered_manager
+from .models import FilteredManager
+
+
+@override_settings(ROOT_URLCONF="admin_views.urls")
+class ChangeFormObjectPermissionTests(TestCase):
+    def setUp(self):
+        user = get_user_model().objects.create_superuser("action-scope", "a@example.com", "password")
+        self.client.force_login(user)
+        self.target = FilteredManager.all_objects.create(deleted=True)
+        self.other = FilteredManager.all_objects.create(deleted=True)
+
+    def submit(self):
+        return self.client.post(reverse("admin:admin_views_filteredmanager_change", args=[self.target.pk]), {
+            "CHANGE_FORM-action":"restore_filtered_manager",
+            ACTION_CHECKBOX_NAME:[self.target.pk], "index":0,
+        })
+
+    def test_request_level_change_permission_is_not_object_permission(self):
+        def allowed(admin, request, obj=None):
+            return obj is None
+        with patch.object(restore_filtered_manager, "allowed_permissions", ["change"], create=True), \
+             patch.object(CustomManagerAdmin, "has_change_permission", allowed):
+            response = self.submit()
+        self.assertEqual(response.status_code, 403)
+        self.target.refresh_from_db()
+        self.assertTrue(self.target.deleted)
+
+    def test_explicit_delete_permission_is_checked_for_the_object(self):
+        def allowed(admin, request, obj=None):
+            return obj is None
+        with patch.object(restore_filtered_manager, "allowed_permissions", ["delete"], create=True), \
+             patch.object(CustomManagerAdmin, "has_delete_permission", allowed):
+            response = self.submit()
+        self.assertEqual(response.status_code, 403)
+        self.target.refresh_from_db()
+        self.assertTrue(self.target.deleted)
+
+    def test_any_explicit_builtin_permission_may_authorize_action(self):
+        with patch.object(restore_filtered_manager, "allowed_permissions", ["change","view"], create=True), \
+             patch.object(CustomManagerAdmin, "has_change_permission", lambda self,request,obj=None: obj is None), \
+             patch.object(CustomManagerAdmin, "has_view_permission", lambda self,request,obj=None: True):
+            response = self.submit()
+        self.assertEqual(response.status_code, 302)
+        self.target.refresh_from_db()
+        self.other.refresh_from_db()
+        self.assertFalse(self.target.deleted)
+        self.assertTrue(self.other.deleted)
+
+    def test_unannotated_original_action_still_uses_admin_queryset(self):
+        response = self.submit()
+        self.assertEqual(response.status_code, 302)
+        self.target.refresh_from_db()
+        self.assertFalse(self.target.deleted)

@@ -0,0 +1,49 @@
+import pytest
+import trio
+from trio.testing import MockClock
+
+@pytest.mark.parametrize("strict",[False,True])
+def test_timeout_cleans_and_nursery_reusable(strict):
+    async def main():
+        cleaned=[]
+        async def stuck(*,task_status):
+            try: await trio.sleep_forever()
+            finally: cleaned.append(True)
+        async def ready(*,task_status): task_status.started(7)
+        async with trio.open_nursery(strict_exception_groups=strict) as nursery:
+            with pytest.raises(trio.TooSlowError): await nursery.start_with_timeout(1,stuck)
+            assert cleaned == [True]
+            assert await nursery.start_with_timeout(None,ready) == 7
+    trio.run(main,clock=MockClock(autojump_threshold=0),strict_exception_groups=strict)
+
+def test_deadline_ends_at_handshake():
+    async def main():
+        finished=[]
+        async def child(value,*,task_status):
+            assert trio.lowlevel.current_task().name == "startup"
+            task_status.started(value)
+            await trio.sleep(5)
+            finished.append(value)
+        async with trio.open_nursery() as nursery:
+            assert await nursery.start_with_timeout(1,child,42,name="startup") == 42
+        assert finished == [42]
+    trio.run(main,clock=MockClock(autojump_threshold=0))
+
+@pytest.mark.parametrize("strict",[False,True])
+def test_error_group_has_no_extra_wrapper(strict):
+    async def main():
+        async def child(*,task_status): raise ExceptionGroup("user",[ValueError("leaf")])
+        async with trio.open_nursery(strict_exception_groups=strict) as nursery:
+            with pytest.raises(ExceptionGroup) as caught: await nursery.start_with_timeout(10,child)
+            assert caught.value.message == "user"
+            assert len(caught.value.exceptions)==1 and isinstance(caught.value.exceptions[0],ValueError)
+    trio.run(main,clock=MockClock(autojump_threshold=0),strict_exception_groups=strict)
+
+def test_outer_cancellation_not_timeout():
+    async def main():
+        async def stuck(*,task_status): await trio.sleep_forever()
+        async with trio.open_nursery() as nursery:
+            with trio.move_on_after(1) as scope:
+                await nursery.start_with_timeout(10,stuck)
+            assert scope.cancelled_caught
+    trio.run(main,clock=MockClock(autojump_threshold=0))

+
+@dataclass(eq=False)
+class _WeightedWaiter:
+    units: int
+    event: Event
+    granted: bool = False
+
+
+class WeightedSemaphore:
+    """A FIFO semaphore that acquires and releases multiple permits atomically.
+
+    ``value`` counts available, unreserved permits. A queued request cannot be
+    bypassed by a smaller request. Cancellation before acquire returns refunds
+    any reserved permits and allows the next request to proceed.
+    """
+
+    def __init__(self, initial_value: int, *, max_value: int | None = None) -> None:
+        if not isinstance(initial_value, int):
+            raise TypeError("initial_value must be an integer")
+        if initial_value < 0:
+            raise ValueError("initial_value must not be negative")
+        if max_value is not None:
+            if not isinstance(max_value, int):
+                raise TypeError("max_value must be an integer")
+            if max_value < initial_value:
+                raise ValueError("max_value must not be less than initial_value")
+        self._value = initial_value
+        self._max_value = max_value
+        self._waiters: dict[_WeightedWaiter, None] = {}
+
+    def _validate_units(self, units: int) -> None:
+        if not isinstance(units, int):
+            raise TypeError("units must be an integer")
+        if units <= 0:
+            raise ValueError("units must be positive")
+        if self._max_value is not None and units > self._max_value:
+            raise ValueError("units exceed max_value")
+
+    def _wake_waiters(self) -> None:
+        while self._waiters:
+            waiter = next(iter(self._waiters))
+            if waiter.units > self._value:
+                break
+            del self._waiters[waiter]
+            self._value -= waiter.units
+            waiter.granted = True
+            waiter.event.set()
+
+    async def acquire(self, units: int = 1) -> None:
+        self._validate_units(units)
+        await checkpoint_if_cancelled()
+        if not self._waiters and self._value >= units:
+            self._value -= units
+            try:
+                await cancel_shielded_checkpoint()
+                await checkpoint_if_cancelled()
+            except BaseException:
+                self._value += units
+                self._wake_waiters()
+                raise
+            return
+        waiter = _WeightedWaiter(units, Event())
+        self._waiters[waiter] = None
+        try:
+            await waiter.event.wait()
+            await checkpoint_if_cancelled()
+        except BaseException:
+            if waiter.granted:
+                self._value += units
+            else:
+                self._waiters.pop(waiter, None)
+            self._wake_waiters()
+            raise
+
+    def acquire_nowait(self, units: int = 1) -> None:
+        self._validate_units(units)
+        if self._waiters or self._value < units:
+            raise WouldBlock
+        self._value -= units
+
+    def release(self, units: int = 1) -> None:
+        self._validate_units(units)
+        if self._max_value is not None and self._value + units > self._max_value:
+            raise ValueError("semaphore released too many times")
+        self._value += units
+        self._wake_waiters()
+
+    @property
+    def value(self) -> int:
+        return self._value
+
+    @property
+    def max_value(self) -> int | None:
+        return self._max_value
+
+    def statistics(self) -> SemaphoreStatistics:
+        return SemaphoreStatistics(tasks_waiting=len(self._waiters))

@@ -0,0 +1,37 @@
+import jinja2
+import pytest
+from starlette.templating import Jinja2Templates
+
+class Request:
+    def __init__(self, prefix):
+        self.prefix = prefix
+    def url_for(self, name, **params):
+        return self.prefix + '/' + name + '/' + str(params['id'])
+
+def test_supplied_environment_gets_request_aware_url_for():
+    env = jinja2.Environment(loader=jinja2.DictLoader({'x':'{{ url_for("item", id=7) }}'}), autoescape=False)
+    templates = Jinja2Templates(env=env)
+    assert templates.env is env
+    first = templates.TemplateResponse('x', {'request': Request('first')})
+    second = templates.TemplateResponse('x', {'request': Request('second')})
+    assert first.body == b'first/item/7'
+    assert second.body == b'second/item/7'
+
+def test_conflicting_modes_leave_environment_unchanged(tmp_path):
+    env = jinja2.Environment(loader=jinja2.DictLoader({}))
+    before = dict(env.globals)
+    with pytest.raises(ValueError):
+        Jinja2Templates(directory=tmp_path, env=env)
+    with pytest.raises(ValueError):
+        Jinja2Templates(env=env, autoescape=False)
+    assert env.globals == before
+
+def test_existing_customization_is_preserved():
+    env = jinja2.Environment(loader=jinja2.DictLoader({'x':'{{ url_for() | tag }}'}), autoescape=False)
+    custom = lambda: '<custom>'
+    env.globals['url_for'] = custom
+    env.filters['tag'] = lambda v: v + '!'
+    templates = Jinja2Templates(env=env)
+    assert templates.env is env
+    assert env.globals['url_for'] is custom
+    assert templates.TemplateResponse('x', {'request': Request('unused')}).body == b'<custom>!'

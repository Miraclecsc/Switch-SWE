@@ -0,0 +1,60 @@
+import pytest
+import trio
+
+
+@pytest.mark.parametrize("operation", ["checkpoint","checkpoint_if_cancelled","sleep_forever"])
+def test_local_cancellation_after_shielding_has_local_reason(operation):
+    async def scenario():
+        with trio.CancelScope() as outer:
+            with trio.CancelScope() as inner:
+                outer.cancel("outer")
+                with pytest.raises(trio.Cancelled) as first:
+                    await trio.lowlevel.checkpoint()
+                assert first.value.reason == "outer"
+                inner.shield = True
+                await trio.lowlevel.checkpoint()
+                inner.cancel("inner")
+                checkpoint = getattr(trio.lowlevel,operation,None) or getattr(trio,operation)
+                with pytest.raises(trio.Cancelled) as second:
+                    await checkpoint()
+                assert second.value.reason == "inner"
+                assert second.value.source == "explicit"
+    trio.run(scenario)
+
+
+def test_descendant_does_not_keep_reason_from_hidden_ancestor():
+    async def scenario():
+        with trio.CancelScope() as outer:
+            with trio.CancelScope() as middle:
+                with trio.CancelScope():
+                    outer.cancel("old ancestor")
+                    with pytest.raises(trio.Cancelled) as first:
+                        await trio.lowlevel.checkpoint()
+                    assert first.value.reason == "old ancestor"
+                    middle.shield = True
+                    await trio.lowlevel.checkpoint()
+                    middle.cancel("visible ancestor")
+                    with pytest.raises(trio.Cancelled) as second:
+                        await trio.lowlevel.checkpoint()
+                    assert second.value.reason == "visible ancestor"
+    trio.run(scenario)
+
+
+def test_repeated_local_cancel_keeps_first_reason():
+    async def scenario():
+        with trio.CancelScope() as scope:
+            scope.cancel("first")
+            scope.cancel("second")
+            with pytest.raises(trio.Cancelled) as caught:
+                await trio.lowlevel.checkpoint()
+            assert caught.value.reason == "first"
+    trio.run(scenario)
+
+
+def test_shielded_scope_without_local_cancel_remains_uncancelled():
+    async def scenario():
+        with trio.CancelScope() as outer:
+            outer.cancel("outside")
+            with trio.CancelScope(shield=True):
+                await trio.lowlevel.checkpoint()
+    trio.run(scenario)

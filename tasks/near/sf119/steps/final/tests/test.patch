diff --git a/tests/test_marker_short_circuit_v1.py b/tests/test_marker_short_circuit_v1.py
new file mode 100644
index 0000000..5e6f392
--- /dev/null
+++ b/tests/test_marker_short_circuit_v1.py
@@ -0,0 +1,31 @@
+import pytest
+from packaging.markers import Marker, UndefinedComparison
+
+
+ENV = {"os_name":"posix", "sys_platform":"linux", "python_version":"3.12", "implementation_name":"cpython"}
+
+
+def test_true_or_branch_skips_invalid_version_comparison():
+    assert Marker("os_name == 'posix' or python_version ~= 'surprise'").evaluate(ENV)
+
+
+def test_false_and_branch_skips_invalid_version_comparison():
+    assert not Marker("os_name == 'nt' and python_version ~= 'surprise'").evaluate(ENV)
+
+
+def test_nested_short_circuit_and_precedence():
+    assert Marker("(os_name == 'posix' or python_version ~= 'surprise') and implementation_name == 'cpython'").evaluate(ENV)
+    assert Marker("os_name == 'nt' and python_version ~= 'surprise' or sys_platform == 'linux'").evaluate(ENV)
+
+
+def test_unavailable_context_variable_is_not_read_in_unreachable_branch():
+    assert Marker("os_name == 'posix' or 'dev' in extras").evaluate(ENV,context="metadata")
+    assert not Marker("os_name == 'nt' and 'dev' in dependency_groups").evaluate(ENV,context="metadata")
+
+
+def test_reached_errors_and_version_semantics_are_preserved():
+    with pytest.raises(UndefinedComparison):
+        Marker("os_name == 'nt' or python_version ~= 'surprise'").evaluate(ENV)
+    assert Marker("python_version == '3.12.0'").evaluate(ENV)
+    assert not Marker("os_name < 'zzz'").evaluate(ENV)
+    assert Marker("python_version >= '3.0' and os_name == 'posix'").evaluate(ENV)

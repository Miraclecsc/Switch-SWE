diff --git a/tests/test_sf143_markers.py b/tests/test_sf143_markers.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf143_markers.py
@@ -0,0 +1,66 @@
+import sys
+import pytest
+from rich.traceback import Traceback
+
+def extract(call,locals=False):
+    try: call()
+    except Exception:
+        return Traceback.extract(*sys.exc_info(),show_locals=locals)
+
+def names(trace): return [f.name for f in trace.stacks[0].frames]
+
+def test_false_callable_retains_frame_and_runs_once():
+    calls=[]
+    def target():
+        _rich_traceback_omit=lambda exc:calls.append(exc) or False
+        raise ValueError("visible")
+    trace=extract(target)
+    assert "target" in names(trace)
+    assert len(calls)==1 and str(calls[0])=="visible"
+
+def test_guard_still_clears_when_omitted():
+    def leaf(): raise ValueError("leaf")
+    def wrapper():
+        _rich_traceback_omit=True
+        _rich_traceback_guard=lambda exc:isinstance(exc,ValueError)
+        leaf()
+    trace=extract(wrapper)
+    assert names(trace)==["leaf"]
+    assert trace.stacks[0].exc_value=="leaf"
+
+@pytest.mark.parametrize("kind",["call","bool"])
+def test_broken_marker_does_not_break_extraction(kind):
+    class Bad:
+        def __bool__(self): raise RuntimeError("bad bool")
+    def broken(exc): raise RuntimeError("bad callback")
+    def target():
+        _rich_traceback_omit=broken if kind=="call" else Bad()
+        raise ValueError("original")
+    trace=extract(target)
+    assert "target" in names(trace) and trace.stacks[0].exc_value=="original"
+
+def test_controls_hidden_from_locals():
+    def target():
+        _rich_traceback_omit=False
+        _rich_traceback_guard=False
+        public="keep"
+        raise ValueError(public)
+    trace=extract(target,True)
+    frame=next(f for f in trace.stacks[0].frames if f.name=="target")
+    assert "public" in frame.locals
+    assert "_rich_traceback_omit" not in frame.locals
+    assert "_rich_traceback_guard" not in frame.locals
+
+def test_cause_predicate_receives_corresponding_exception():
+    calls=[]
+    def inner():
+        _rich_traceback_omit=lambda exc:calls.append(type(exc)) or False
+        raise KeyError("cause")
+    def outer():
+        _rich_traceback_omit=lambda exc:calls.append(type(exc)) or False
+        try: inner()
+        except KeyError as cause: raise ValueError("outer") from cause
+    trace=extract(outer)
+    assert [stack.exc_type for stack in trace.stacks]==["ValueError","KeyError"]
+    assert calls==[ValueError,KeyError,KeyError]
+    assert any(f.name=="inner" for f in trace.stacks[1].frames)

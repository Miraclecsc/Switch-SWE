diff --git a/tests/test_sf179_staged.py b/tests/test_sf179_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf179_staged.py
@@ -0,0 +1,23 @@
+
+from packaging.markers import Marker
+
+def test_full_version_override_updates_short_version(monkeypatch):
+    import packaging.markers as markers
+    default = markers.default_environment()
+    default.update(python_version='3.9', python_full_version='3.9.1')
+    monkeypatch.setattr(markers, 'default_environment', lambda: dict(default))
+    for full, short in [('3.12.7', '3.12'), ('12.100.4rc1', '12.100')]:
+        override = {'python_full_version': full, 'os_name': 'posix'}
+        assert Marker('python_version == "' + short + '" and os_name == "posix"').evaluate(override)
+        assert override == {'python_full_version': full, 'os_name': 'posix'}
+    assert Marker('python_version == "3.9"').evaluate()
+
+def test_explicit_short_version_takes_precedence():
+    assert Marker('python_version == "3.8"').evaluate({'python_full_version': '3.12.1', 'python_version': '3.8'})
+
+def test_numerical_short_version_order(monkeypatch):
+    import packaging.markers as markers
+    default = markers.default_environment()
+    default.update(python_version='3.9', python_full_version='3.9.1')
+    monkeypatch.setattr(markers, 'default_environment', lambda: dict(default))
+    assert Marker('python_version >= "3.10" and python_version < "3.20"').evaluate({'python_full_version': '3.12.1'})

+++ b/sympy/logic/tests/test_root_assumptions_v1.py
@@ -0,0 +1,45 @@
+import pytest
+from sympy import And, Or, Symbol, symbols
+from sympy.assumptions.cnf import EncodedCNF
+from sympy.logic.inference import satisfiable
+
+
+def test_boolean_assumptions_constrain_the_returned_model():
+    p,q,r = symbols("p q r")
+    model = satisfiable(Or(p,q),assumptions=[~p,r])
+    assert model[p] is False and model[q] is True and model[r] is True
+
+
+def test_theory_inconsistent_assumptions_are_root_unsat():
+    x = Symbol("x")
+    expression = And(x>=0,x<=3)
+    assert satisfiable(expression,use_lra_theory=True,assumptions=[x>4]) is False
+    assert list(satisfiable(expression,use_lra_theory=True,assumptions=[x>4],all_models=True)) == [False]
+    assert satisfiable(expression,use_lra_theory=True,assumptions=[x<1]) is not False
+
+
+def test_encoded_cnf_and_interleaved_generators_are_isolated():
+    p,q = symbols("p q")
+    encoded = EncodedCNF()
+    encoded.add_prop(Or(p,q))
+    data,encoding = [set(c) for c in encoded.data],dict(encoded.encoding)
+    left = satisfiable(encoded,assumptions=iter([~p]),all_models=True)
+    right = satisfiable(encoded,assumptions=[~q],all_models=True)
+    assert list(left) == [{p:False,q:True}]
+    assert list(right) == [{p:True,q:False}]
+    assert encoded.data == data and encoded.encoding == encoding
+    assert len(list(satisfiable(encoded,algorithm="dpll2",all_models=True))) == 3
+
+
+def test_nonliteral_assumptions_and_unsupported_backend_are_explicit_errors():
+    p,q = symbols("p q")
+    with pytest.raises(ValueError):
+        satisfiable(p,assumptions=[Or(p,q)])
+    with pytest.raises(ValueError):
+        satisfiable(p,algorithm="dpll",assumptions=[q])
+
+
+def test_empty_assumptions_preserve_original_boolean_behavior():
+    p,q = symbols("p q")
+    assert satisfiable(p & ~p,algorithm="dpll2",assumptions=()) is False
+    assert satisfiable(p & ~q,algorithm="dpll2",assumptions=()) == {p:True,q:False}

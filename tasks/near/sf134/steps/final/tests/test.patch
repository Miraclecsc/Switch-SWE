+++ b/networkx/algorithms/tests/test_sf134_demand.py
@@ -0,0 +1,41 @@
+import copy
+import networkx as nx
+import pytest
+
+@pytest.mark.parametrize("name", ["centroid", "barycenter"])
+def test_demand_tree_and_edge_lengths(name):
+    g = nx.path_graph(4)
+    g.nodes[3]["demand"] = 10
+    for a, b in g.edges: g[a][b]["cost"] = a + 1
+    fn = getattr(nx, name)
+    result = fn(g, node_weight="demand", weight="cost", attr="objective")
+    assert result == [3]
+    assert [g.nodes[i]["objective"] for i in g] == [64, 53, 35, 14]
+    assert fn(g, node_weight="demand") == [3]
+
+def test_cache_and_zero_demands():
+    g = nx.cycle_graph(4)
+    nx.set_node_attributes(g, 0, "demand")
+    cache = dict(nx.all_pairs_shortest_path_length(g))
+    before = copy.deepcopy(cache)
+    assert set(nx.barycenter(g, node_weight="demand", sp=cache, attr="obj")) == set(g)
+    assert all(g.nodes[n]["obj"] == 0 for n in g)
+    assert cache == before
+    assert nx.barycenter is nx.centroid
+
+@pytest.mark.parametrize("missing", ["source", "destination"])
+def test_cache_failure_does_not_publish(missing):
+    g = nx.path_graph(3)
+    nx.set_node_attributes(g, 99, "obj")
+    sp = dict(nx.all_pairs_shortest_path_length(g))
+    if missing == "source": del sp[2]
+    else: del sp[2][0]
+    with pytest.raises(nx.NetworkXNoPath): nx.centroid(g, sp=sp, attr="obj")
+    assert all(g.nodes[n]["obj"] == 99 for n in g)
+
+@pytest.mark.parametrize("bad", [-1, float("inf"), float("nan"), "heavy"])
+def test_invalid_demand_is_transactional(bad):
+    g = nx.path_graph(3)
+    g.nodes[2]["d"] = bad
+    with pytest.raises(ValueError): nx.barycenter(g, node_weight="d", attr="obj")
+    assert all("obj" not in g.nodes[n] for n in g)

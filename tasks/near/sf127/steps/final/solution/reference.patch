diff --git a/sympy/core/function.py b/sympy/core/function.py
index 60acc06c23..1b94ec48d9 100644
--- a/sympy/core/function.py
+++ b/sympy/core/function.py
@@ -1640,6 +1640,33 @@ def doit(self, **hints):
         expr = self.expr
         if hints.get('deep', True):
             expr = expr.doit(**hints)
+        if hints.get('expand_noncommutative', False) and all(
+                isinstance(count, Integer) for _, count in self.variable_count):
+            def ordered_diff(value, variable):
+                if value.is_Add:
+                    return Add(*(ordered_diff(term, variable) for term in value.args))
+                if value.is_Mul:
+                    factors = value.args
+                    return Add(*(Mul(*factors[:i], ordered_diff(factor, variable),
+                                     *factors[i + 1:])
+                                 for i, factor in enumerate(factors)))
+                if value.is_Pow and not value.base.is_commutative:
+                    base, exponent = value.args
+                    if isinstance(exponent, Integer) and exponent.diff(variable).is_zero:
+                        derivative = ordered_diff(base, variable)
+                        n = int(exponent)
+                        if n >= 0:
+                            return Add(*(base**i * derivative * base**(n-1-i)
+                                         for i in range(n)))
+                        return -Add(*(base**(-i) * derivative * base**(n+i-1)
+                                      for i in range(1, -n+1)))
+                return value.diff(variable)
+
+            for variable, count in self.variable_count:
+                for _ in range(int(count)):
+                    expr = ordered_diff(expr, variable)
+            return expr
+
         hints['evaluate'] = True
         rv = self.func(expr, *self.variable_count, **hints)
         if rv!= self and rv.has(Derivative):

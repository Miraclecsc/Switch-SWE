@@ -0,0 +1,45 @@
+
+import subprocess
+import sys
+import pytest
+from trio._core import _thread_cache
+
+def test_native_library_load_failure_is_optional(monkeypatch):
+    monkeypatch.setattr(_thread_cache.ctypes.util, 'find_library', lambda name: 'missing-pthread')
+    def unavailable(*args):
+        raise OSError('native naming library unavailable')
+    monkeypatch.setattr(_thread_cache.ctypes, 'CDLL', unavailable)
+    assert _thread_cache.get_os_thread_name_func() is None
+
+def test_native_naming_errors_do_not_lose_jobs():
+    program = r"""
+import threading
+import trio
+from trio._core import _thread_cache
+calls = []
+def unavailable(ident, name):
+    if ident is not None:
+        calls.append(name)
+        raise OSError('native name denied')
+_thread_cache.set_os_thread_name = unavailable
+async def main():
+    result = await trio.to_thread.run_sync(lambda: (threading.current_thread().name, 42), thread_name='first')
+    assert result == ('first', 42)
+    def fail():
+        assert threading.current_thread().name == 'second'
+        raise ValueError('user failure')
+    try:
+        await trio.to_thread.run_sync(fail, thread_name='second')
+    except ValueError as error:
+        assert str(error) == 'user failure'
+    else:
+        raise AssertionError('user exception lost')
+    assert await trio.to_thread.run_sync(lambda: 9, thread_name='third') == 9
+trio.run(main)
+assert 'first' in calls and 'second' in calls and 'third' in calls
+"""
+    try:
+        result = subprocess.run([sys.executable, '-c', program], text=True, capture_output=True, timeout=8)
+    except subprocess.TimeoutExpired:
+        pytest.fail('native naming failure lost a worker completion')
+    assert result.returncode == 0, result.stdout + result.stderr

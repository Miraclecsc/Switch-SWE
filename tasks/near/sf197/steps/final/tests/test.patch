--- /dev/null
+++ b/tests/test_sf197_staged.py
@@ -0,0 +1,45 @@
+
+import os
+import re
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from trio._tools import gen_exports as gen
+
+def test_hook_triggers_for_generator_and_generated_outputs():
+    config = (Path(__file__).resolve().parents[1] / '.pre-commit-config.yaml').read_text()
+    block = config.split('- id: regenerate-files',1)[1]
+    pattern = re.search(r'files:\s*(.+)', block).group(1).strip().strip("'\"")
+    for path in ('src/trio/_tools/gen_exports.py', 'src/trio/_core/_generated_run.py', 'src/trio/_core/_generated_io_epoll.py', 'src/trio/_core/_run.py'):
+        assert re.search(pattern,path), path
+    assert not re.search(pattern,'src/trio/_core/_unrelated.py')
+
+def configure(monkeypatch, tmp_path, sources):
+    files = [SimpleNamespace(path=tmp_path/name) for name in sources]
+    monkeypatch.setattr(gen, 'gen_public_wrappers_source', lambda file: sources[file.path.name])
+    monkeypatch.setattr(gen, 'run_linters', lambda file, source: source)
+    return files
+
+def test_noop_preserves_metadata_and_changed_output_preserves_mode(tmp_path, monkeypatch):
+    files = configure(monkeypatch,tmp_path,{'_run.py':'new content\n'})
+    target = tmp_path/'_generated_run.py'
+    target.write_text('old content\n')
+    target.chmod(0o640)
+    with pytest.raises(SystemExit) as caught:
+        gen.process(files,do_test=False)
+    assert caught.value.code == 1 and target.read_text() == 'new content\n'
+    assert target.stat().st_mode & 0o777 == 0o640
+    os.utime(target,ns=(1000000000,1000000000))
+    before = target.stat()
+    gen.process(files,do_test=False)
+    after = target.stat()
+    assert after.st_mtime_ns == before.st_mtime_ns
+    assert after.st_ino == before.st_ino
+
+def test_encoding_failure_preserves_all_outputs(tmp_path, monkeypatch):
+    files = configure(monkeypatch,tmp_path,{'_run.py':'valid new','_io_epoll.py':'invalid \ud800'})
+    first, second = tmp_path/'_generated_run.py', tmp_path/'_generated_io_epoll.py'
+    first.write_text('old first'); second.write_text('old second')
+    with pytest.raises(UnicodeEncodeError):
+        gen.process(files,do_test=False)
+    assert first.read_text() == 'old first' and second.read_text() == 'old second'

diff --git a/tests/test_sf199_staged.py b/tests/test_sf199_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf199_staged.py
@@ -0,0 +1,21 @@
+
+from sympy import Pow, S, Rational, Symbol, Float, I
+
+def test_zero_base_positive_rational_has_no_polar_nan():
+    for exponent in (Rational(1,3), Rational(2,3), Rational(5,2)):
+        expression = Pow(S.Zero, exponent, evaluate=False)
+        assert expression.as_real_imag() == (S.Zero,S.Zero)
+        assert expression.as_real_imag(deep=False) == (S.Zero,S.Zero)
+
+def test_assumed_zero_base_and_real_exponent_signs():
+    zero = Symbol('z', zero=True)
+    positive = Symbol('p', positive=True)
+    negative = Symbol('n', negative=True)
+    for base in (S.Zero,zero):
+        for exponent, expected in [(positive,(S.Zero,S.Zero)), (negative,(S.NaN,S.NaN)), (Float('0.5'),(S.Zero,S.Zero)), (Float('-0.5'),(S.NaN,S.NaN))]:
+            assert Pow(base,exponent,evaluate=False).as_real_imag() == expected
+
+def test_zero_and_negative_exponents_and_nonzero_control():
+    assert Pow(S.Zero,S.Zero,evaluate=False).as_real_imag() == (S.One,S.Zero)
+    assert Pow(S.Zero,Rational(-1,3),evaluate=False).as_real_imag() == (S.NaN,S.NaN)
+    assert Pow(1+I,2,evaluate=False).as_real_imag() == (S.Zero,2)

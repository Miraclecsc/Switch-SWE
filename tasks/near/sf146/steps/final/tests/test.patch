diff --git a/tests/test_sf146_aliases.py b/tests/test_sf146_aliases.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf146_aliases.py
@@ -0,0 +1,48 @@
+import pytest
+from textual.app import App
+from textual.screen import Screen
+from textual.app import ScreenError
+
+def test_aliases_factory_cache_and_app_isolation():
+    calls=[]
+    def factory():calls.append(True);return Screen()
+    class Demo(App):SCREENS={"first":"second","second":"target","target":factory}
+    assert calls==[]
+    a,b=Demo(),Demo()
+    screen=a.get_screen("first")
+    assert a.get_screen("second") is screen and a.get_screen("target") is screen
+    assert b.get_screen("first") is not screen and len(calls)==2
+    a.uninstall_screen("target")
+    replacement=Screen();a.install_screen(replacement,"target")
+    assert a.get_screen("first") is replacement
+    assert Demo.SCREENS["first"]=="second"
+
+def test_cycle_missing_and_bad_factory_retry():
+    count=[]
+    def factory():count.append(True);return object() if len(count)==1 else Screen()
+    class Demo(App):SCREENS={"a":"b","b":"a","missing":"absent","retry":factory}
+    app=Demo()
+    with pytest.raises(ScreenError):app.get_screen("a")
+    with pytest.raises(KeyError):app.get_screen("missing")
+    with pytest.raises(TypeError):app.get_screen("retry")
+    assert isinstance(app.get_screen("retry"),Screen)
+    with pytest.raises(ScreenError):app.get_screen("b")
+
+async def test_failed_mode_switch_does_not_suspend_current():
+    suspends=[]
+    class Main(Screen):
+        def on_screen_suspend(self):suspends.append(True)
+    class Demo(App):
+        SCREENS={"main":Main,"alias":"main"}
+        MODES={"good":"alias","bad":lambda:object()}
+    app=Demo()
+    async with app.run_test() as pilot:
+        await app.switch_mode("good");await pilot.pause();suspends.clear()
+        current=app.screen
+        with pytest.raises(TypeError):app.switch_mode("bad")
+        await pilot.pause()
+        assert app.screen is current and suspends==[]
+        with pytest.raises(TypeError):app.add_mode("invalid",17)
+        app.add_mode("invalid","alias")
+        await app.switch_mode("invalid")
+        assert app.screen is current

new file mode 100644
index 0000000000..6a1133c72b
--- /dev/null
+++ b/tests/ordering/test_random_ordering_prefix_v1.py
@@ -0,0 +1,50 @@
+from django.db import models
+from django.db.models.functions import Random
+from django.test import SimpleTestCase
+from django.test.utils import isolate_apps
+
+
+class RandomOrderingPrefixTests(SimpleTestCase):
+    def model(self):
+        class Record(models.Model):
+            a = models.IntegerField()
+            b = models.IntegerField()
+            optional = models.IntegerField(null=True, unique=True)
+            class Meta:
+                app_label = "ordering"
+                unique_together = (("a","b"),)
+        return Record
+
+    @isolate_apps("ordering")
+    def test_random_before_unique_tie_breaker_is_not_deterministic(self):
+        record = self.model()
+        self.assertIs(record.objects.order_by("?","pk").totally_ordered,False)
+        self.assertIs(record.objects.order_by(Random(),"pk").totally_ordered,False)
+        self.assertIs(record.objects.order_by("a",Random()+models.Value(1),"pk").totally_ordered,False)
+
+    @isolate_apps("ordering")
+    def test_annotation_alias_keeps_randomness_visible(self):
+        record = self.model()
+        qs = record.objects.annotate(shuffle=Random())
+        self.assertIs(qs.order_by("shuffle","pk").totally_ordered,False)
+        self.assertIs(qs.order_by(models.F("shuffle").desc(),"pk").totally_ordered,False)
+
+    @isolate_apps("ordering")
+    def test_composite_unique_prefix_must_be_complete_before_randomness(self):
+        record = self.model()
+        self.assertIs(record.objects.order_by("a","?","b").totally_ordered,False)
+        self.assertIs(record.objects.order_by("a","b","?").totally_ordered,True)
+
+    @isolate_apps("ordering")
+    def test_already_unique_prefix_dominates_later_randomness(self):
+        record = self.model()
+        self.assertIs(record.objects.order_by("pk","?").totally_ordered,True)
+        self.assertIs(record.objects.order_by("-pk",Random()).totally_ordered,True)
+        self.assertIs(record.objects.order_by("optional","?","pk").totally_ordered,False)
+
+    @isolate_apps("ordering")
+    def test_deterministic_and_unordered_queries_keep_original_results(self):
+        record = self.model()
+        self.assertIs(record.objects.all().totally_ordered,False)
+        self.assertIs(record.objects.order_by("a","b").totally_ordered,True)
+        self.assertIs(record.objects.order_by("a").totally_ordered,False)

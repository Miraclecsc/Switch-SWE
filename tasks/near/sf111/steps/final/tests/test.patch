diff --git a/tests/client/test_staged_contract.py b/tests/client/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/client/test_staged_contract.py
@@ -0,0 +1,84 @@
+import asyncio
+import warnings
+from pathlib import Path
+import pytest
+import httpx
+
+
+class App:
+    def __bool__(self):
+        raise AssertionError("application truth value must not be inspected")
+    def __call__(self, environ, start_response):
+        start_response("200 OK", [("Content-Type", "text/plain")])
+        return [b"ok"]
+
+
+async def asgi_app(scope, receive, send):
+    await send({"type": "http.response.start", "status": 200, "headers": []})
+    await send({"type": "http.response.body", "body": b"ok"})
+
+
+class AsyncApp:
+    def __bool__(self):
+        raise AssertionError("application truth value must not be inspected")
+    async def __call__(self, scope, receive, send):
+        await asgi_app(scope, receive, send)
+
+
+@pytest.mark.parametrize("client_type", [httpx.Client, httpx.AsyncClient])
+def test_application_presence_without_truth_testing(client_type):
+    app = AsyncApp() if client_type is httpx.AsyncClient else App()
+    with warnings.catch_warnings(record=True) as seen:
+        warnings.simplefilter("always")
+        client = client_type(app=app, trust_env=False)
+    if isinstance(client, httpx.AsyncClient):
+        async def use():
+            try:
+                assert (await client.get("http://test/")).text == "ok"
+            finally:
+                await client.aclose()
+        asyncio.run(use())
+    else:
+        assert client.get("http://test/").text == "ok"
+        client.close()
+    app_warnings = [w for w in seen if issubclass(w.category, DeprecationWarning) and "app" in str(w.message)]
+    assert len(app_warnings) == 1
+
+
+@pytest.mark.parametrize("client_type", [httpx.Client, httpx.AsyncClient])
+def test_warning_points_to_call_site(client_type):
+    with warnings.catch_warnings(record=True) as seen:
+        warnings.simplefilter("always")
+        client = client_type(app=asgi_app, trust_env=False)
+    if isinstance(client, httpx.AsyncClient):
+        asyncio.run(client.aclose())
+    else:
+        client.close()
+    app_warnings = [w for w in seen if issubclass(w.category, DeprecationWarning) and "app" in str(w.message)]
+    assert len(app_warnings) == 1
+    assert Path(app_warnings[0].filename).resolve() == Path(__file__).resolve()
+    assert "Transport" in str(app_warnings[0].message)
+
+
+def test_async_app_ignores_ambient_proxy_routes(monkeypatch):
+    monkeypatch.setenv("HTTP_PROXY", "http://unused.invalid:8080")
+    monkeypatch.setenv("HTTPS_PROXY", "http://unused.invalid:8080")
+    monkeypatch.setenv("ALL_PROXY", "http://unused.invalid:8080")
+    monkeypatch.setenv("NO_PROXY", "")
+    def forbidden(*args, **kwargs):
+        raise AssertionError("in-process app must not create a proxy transport")
+    monkeypatch.setattr(httpx.AsyncClient, "_init_proxy_transport", forbidden)
+    async def run():
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", DeprecationWarning)
+            async with httpx.AsyncClient(app=asgi_app, base_url="http://test", trust_env=True) as client:
+                assert (await client.get("/")).text == "ok"
+    asyncio.run(run())
+
+
+def test_none_app_is_not_deprecated():
+    with warnings.catch_warnings(record=True) as seen:
+        warnings.simplefilter("always")
+        with httpx.Client(app=None, transport=httpx.MockTransport(lambda request: httpx.Response(200)), trust_env=False):
+            pass
+    assert not [w for w in seen if "app" in str(w.message) and issubclass(w.category, DeprecationWarning)]

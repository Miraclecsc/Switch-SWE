new file mode 100644
--- /dev/null
+++ b/tests/test_sf194_staged.py
@@ -0,0 +1,39 @@
+
+import attr
+import pytest
+from attr import validators as v
+
+def test_outer_iterable_sequence_before_members():
+    events = []
+    outer = lambda inst, field, value: events.append(('outer', value))
+    inner = lambda inst, field, value: events.append(('inner', value))
+    @attr.s
+    class Example:
+        value = attr.ib(validator=v.deep_iterable([inner], [outer]))
+    Example([1,2])
+    assert events == [('outer',[1,2]), ('inner',1), ('inner',2)]
+
+def test_mapping_sequences_forward_context_and_order():
+    events = []
+    def record(kind):
+        return lambda inst, field, value: events.append((kind, inst, field.name, value))
+    @attr.s
+    class Example:
+        value = attr.ib(validator=v.deep_mapping([record('key1'),record('key2')], (record('value'),), [record('mapping')]))
+    example = Example({'a':1,'b':2})
+    assert [(k,name,value) for k,inst,name,value in events] == [('mapping','value',{'a':1,'b':2}),('key1','value','a'),('key2','value','a'),('value','value',1),('key1','value','b'),('key2','value','b'),('value','value',2)]
+    assert all(inst is example for _,inst,_,_ in events)
+
+def test_mapping_failure_short_circuits_and_empty_sequences():
+    events = []
+    error = ValueError('stop')
+    def fail(*args):
+        events.append('fail')
+        raise error
+    def later(*args):
+        events.append('later')
+    validator = v.deep_mapping([], [], [fail,later])
+    with pytest.raises(ValueError) as caught:
+        validator(None,None,{'x':1})
+    assert caught.value is error and events == ['fail']
+    v.deep_mapping([], (), [])(None,None,{'x':1})

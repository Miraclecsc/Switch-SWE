diff --git a/tests/test_sf137_diagnostics.py b/tests/test_sf137_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf137_diagnostics.py
@@ -0,0 +1,58 @@
+from functools import partial
+import click
+import pytest
+from click.testing import CliRunner
+
+def parse(value, prefix=""):
+    if value == "bad":
+        err=ValueError(prefix+"cannot parse")
+        err.add_note("use a decimal")
+        err.add_note("数字")
+        raise err
+    return int(value)
+
+def test_partial_and_callable_object():
+    p=click.types.FuncParamType(partial(parse,prefix="X: "))
+    assert p.name == "parse"
+    assert p.convert("4",None,None) == 4
+    class Parser:
+        def __call__(self,value): return parse(value)
+    q=click.types.FuncParamType(Parser())
+    assert q.name == "Parser" and q.convert("5",None,None)==5
+    with pytest.raises(click.BadParameter) as exc: p.convert("bad",None,None)
+    assert exc.value.message == "X: cannot parse\nuse a decimal\n数字"
+
+def test_empty_message_with_notes():
+    def bad(value):
+        err=ValueError();err.add_note("try again");raise err
+    with pytest.raises(click.BadParameter) as exc:
+        click.types.FuncParamType(bad).convert("original",None,None)
+    assert exc.value.message=="original\ntry again"
+
+def test_tuple_cli_has_context_and_notes():
+    @click.command()
+    @click.option("--pair",type=(str,parse),multiple=True)
+    def command(pair): click.echo(repr(pair))
+    runner=CliRunner()
+    good=runner.invoke(command,["--pair","a","2","--pair","b","3"])
+    assert good.exit_code==0 and "('b', 3)" in good.output
+    bad=runner.invoke(command,["--pair","a","2","--pair","b","bad"])
+    assert bad.exit_code==2
+    assert "--pair" in bad.output and "item 2: cannot parse" in bad.output
+    assert "use a decimal" in bad.output and "数字" in bad.output
+
+def test_nested_tuple_path_retains_parameter():
+    ty=click.Tuple([str,click.Tuple([parse,str])])
+    param=click.Option(["--pair"]);ctx=click.Context(click.Command("cmd"))
+    with pytest.raises(click.BadParameter) as exc:
+        ty.convert(("a",("bad","x")),param,ctx)
+    assert exc.value.message.startswith("item 2: item 1: cannot parse")
+    assert exc.value.param is param and exc.value.ctx is ctx
+
+def test_non_value_error_and_single_conversion():
+    calls=[]
+    def bad(value):
+        calls.append(value);raise RuntimeError("bug")
+    with pytest.raises(RuntimeError):
+        click.types.FuncParamType(bad).convert("x",None,None)
+    assert calls==["x"]

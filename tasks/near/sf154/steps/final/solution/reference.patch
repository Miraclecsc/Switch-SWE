+    if sys.version_info >= (3, 12):
+
+        def relative_to(
+            self, *other: str | PathLike[str], walk_up: bool = False, max_up: int | None = None
+        ) -> Path:
+            if max_up is not None:
+                if isinstance(max_up, bool) or not isinstance(max_up, int):
+                    raise TypeError("max_up must be an integer or None")
+                if max_up < 0:
+                    raise ValueError("max_up must be non-negative")
+            result = self._path.relative_to(*other, walk_up=walk_up)
+            if max_up is not None and result.parts.count("..") > max_up:
+                raise ValueError("relative path exceeds max_up")
+            return Path(result)
+
+    else:
+
+        def relative_to(self, *other: str | PathLike[str]) -> Path:

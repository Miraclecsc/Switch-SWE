diff --git a/tests/test_staged_contract.py b/tests/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_staged_contract.py
@@ -0,0 +1,27 @@
+import pathlib
+import pytest
+from anyio import Path
+
+def test_traversal_budget():
+    path = Path('/srv/a/file')
+    assert path.relative_to('/srv/b', walk_up=True, max_up=1) == Path('../a/file')
+    with pytest.raises(ValueError):
+        path.relative_to('/srv/b', walk_up=True, max_up=0)
+    assert isinstance(path.relative_to('/srv', max_up=0), Path)
+
+def test_budget_validation():
+    for value in (-1, -9):
+        with pytest.raises(ValueError):
+            Path('a').relative_to('a', max_up=value)
+    for value in (True, 1.5, '1'):
+        with pytest.raises(TypeError):
+            Path('a').relative_to('a', max_up=value)
+    with pytest.raises(ValueError):
+        Path('/a').relative_to('/b', max_up=9)
+
+def test_literal_parent_components_and_pathlike():
+    target = Path('/srv/a/../x')
+    assert target.relative_to(pathlib.Path('/srv'), max_up=1) == Path('a/../x')
+    with pytest.raises(ValueError):
+        target.relative_to('/srv', max_up=0)
+    assert target.relative_to('/srv', max_up=None) == Path('a/../x')

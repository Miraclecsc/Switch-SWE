+    async def send_and_wait(self, item: T_Item) -> None:
+        """
+        Send an item and wait until a receiver consumes it.
+
+        Buffer admission alone does not complete this operation. Cancellation
+        before consumption retracts this particular item; consumption wins a
+        race with cancellation or closing the last receive channel.
+
+        :raises ClosedResourceError: if this sending handle was already closed
+        :raises BrokenResourceError: if all receive handles close before consumption
+        """
+        if self._closed:
+            raise ClosedResourceError
+        if not self._state.open_receive_channels:
+            raise BrokenResourceError
+
+        delivery = _Delivery(item, anyio.create_event())
+        self._state.receipts[delivery.event] = delivery
+        try:
+            try:
+                await self.send(delivery)
+                if not delivery.received:
+                    await delivery.event.wait()
+            except (anyio.get_cancelled_exc_class(), BrokenResourceError):
+                if not delivery.received:
+                    raise
+
+            if not delivery.received:
+                raise BrokenResourceError
+        finally:
+            self._state.receipts.pop(delivery.event, None)
+            if not delivery.received:
+                delivery.cancelled = True
+                # Compare by identity: user payload equality may be effectful.
+                for index, buffered in enumerate(self._state.buffer):
+                    if buffered is delivery:
+                        del self._state.buffer[index]
+                        async with anyio.open_cancel_scope(shield=True):
+                            if self._state.open_receive_channels:
+                                await self._state.refill_buffer()
+                        break
+

new file mode 100644
--- /dev/null
+++ b/tests/test_sf189_staged.py
@@ -0,0 +1,44 @@
+
+import pytest
+import attrs
+
+def test_invalid_transformer_item_reports_contract():
+    def transform(cls, fields):
+        yield fields[0]
+        yield object()
+    with pytest.raises(TypeError, match='Attribute'):
+        @attrs.define(field_transformer=transform)
+        class Example:
+            value: int
+
+def test_duplicate_names_are_rejected_before_codegen():
+    def transform(cls, fields):
+        yield fields[0]
+        yield fields[0]
+    with pytest.raises(ValueError, match='value'):
+        @attrs.define(field_transformer=transform)
+        class Example:
+            value: int
+
+def test_duplicate_default_and_explicit_aliases():
+    def transform(cls, fields):
+        yield fields[0]
+        yield fields[1].evolve(alias='left')
+    with pytest.raises(ValueError, match='left'):
+        @attrs.define(field_transformer=transform)
+        class Example:
+            _left: int
+            right: int
+
+def test_valid_generator_consumed_once_with_noninit_alias():
+    visits = []
+    def transform(cls, fields):
+        for field in fields:
+            visits.append(field.name)
+            yield field
+    @attrs.define(field_transformer=transform)
+    class Example:
+        value: int
+        cache: int = attrs.field(init=False, default=0, alias='value')
+    assert Example(3).value == 3
+    assert visits == ['value','cache']

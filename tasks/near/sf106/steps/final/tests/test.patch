+++ b/tests/annotations/test_staged_contract.py
@@ -0,0 +1,38 @@
+from django.core.exceptions import FieldError
+from django.db.models import F, Value
+from django.test import SimpleTestCase
+from .models import Book
+
+
+class AnnotationOriginTests(SimpleTestCase):
+    def test_all_annotations_masked(self):
+        source = Book.objects.annotate(answer=Value(1))
+        for projected in (source.values("pk"), source.values_list("pk")):
+            with self.assertRaisesMessage(FieldError, "was excluded by a previous"):
+                projected.values("answer")
+
+    def test_alias_with_other_selected_annotation(self):
+        source = Book.objects.alias(hidden=Value(1)).annotate(visible=Value(2))
+        with self.assertRaisesMessage(FieldError, "Use annotate() to promote it"):
+            source.values_list("hidden")
+
+    def test_branch_replacement_does_not_change_parent(self):
+        parent = Book.objects.annotate(answer=Value(1)).values("pk")
+        child = parent.alias(answer=Value(2))
+        with self.assertRaisesMessage(FieldError, "Use annotate() to promote it"):
+            child.values("answer")
+        with self.assertRaisesMessage(FieldError, "was excluded by a previous"):
+            parent.values("answer")
+
+    def test_promotion_and_later_masking(self):
+        source = Book.objects.alias(answer=Value(1))
+        promoted = source.annotate(answer=F("answer"))
+        self.assertIn("answer", str(promoted.values("answer").query))
+        with self.assertRaisesMessage(FieldError, "was excluded by a previous"):
+            promoted.values("pk").values("answer")
+        with self.assertRaisesMessage(FieldError, "Use annotate() to promote it"):
+            source.values("answer")
+
+    def test_original_partial_masking_diagnostic(self):
+        with self.assertRaisesMessage(FieldError, "was excluded by a previous"):
+            Book.objects.annotate(first=Value(1), second=Value(2)).values("first").values("second")

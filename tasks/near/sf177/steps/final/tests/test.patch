diff --git a/tests/test_sf177_staged.py b/tests/test_sf177_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf177_staged.py
@@ -0,0 +1,38 @@
+import pytest
+from jinja2 import Environment, TemplateRuntimeError
+
+def test_missing_filter_keyword_call_runtime_error():
+    template = Environment().from_string("{{ value | absent(flag=true) if enabled else 'safe' }}")
+    assert template.render(enabled=False, value="x") == "safe"
+    with pytest.raises(TemplateRuntimeError, match="absent"):
+        template.render(enabled=True, value="x")
+
+def test_missing_test_in_conditional_branch():
+    template = Environment().from_string("{% if enabled %}{{ value is absent(flag=true) }}{% else %}safe{% endif %}")
+    assert template.render(enabled=False, value="x") == "safe"
+    with pytest.raises(TemplateRuntimeError, match="test.*absent"):
+        template.render(enabled=True, value="x")
+
+def test_existing_keyword_filter_and_test():
+    env = Environment()
+    env.filters["suffix"] = lambda value, tail="": value + tail
+    env.tests["same"] = lambda value, other=None: value == other
+    assert env.from_string("{{ 'x' | suffix(tail='y') if true else '' }}").render() == "xy"
+    assert env.from_string("{{ 'x' is same(other='x') if true else false }}").render() == "True"
+
+def test_unconditional_dependencies_still_compile_errors():
+    from jinja2 import TemplateAssertionError
+    for source in ("{{ value | absent }}", "{{ value is absent }}"):
+        with pytest.raises(TemplateAssertionError):
+            Environment().from_string(source)
+
+def test_nested_conditional_tests_do_not_evaluate_arguments():
+    def boom():
+        raise AssertionError("unexecuted argument evaluated")
+    for source in (
+        "{{ value is absent(flag=boom()) if enabled else 'safe' }}",
+        "{% if outer %}{% if enabled %}{{ value is absent(flag=boom()) }}{% else %}safe{% endif %}{% endif %}",
+        "{% if enabled %}bad{% elif other %}{{ value is absent(flag=boom()) }}{% else %}safe{% endif %}",
+    ):
+        template = Environment().from_string(source)
+        assert template.render(value='x', enabled=False, other=False, outer=True, boom=boom) == 'safe'

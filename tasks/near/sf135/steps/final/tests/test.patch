+import copy
+from itertools import combinations
+import networkx as nx
+import pytest
+
+def expected(g, left, right):
+    out = dict.fromkeys(g, 0)
+    for a,b in combinations(left, 2):
+        for c,d in combinations(right, 2):
+            pairs = [(a,c),(a,d),(b,c),(b,d)]
+            if all(g.has_edge(u,v) for u,v in pairs):
+                product = 1
+                for u,v in pairs:
+                    data = g[u][v]
+                    product *= sum(x.get("w",1) for x in data.values()) if g.is_multigraph() else data.get("w",1)
+                for n in (a,b,c,d): out[n] += product
+    return out
+
+@pytest.mark.parametrize("multi", [False, True])
+@pytest.mark.parametrize("scale", [1, 0.5, 10**12])
+def test_weighted_overlapping_motifs(multi, scale):
+    left = ["a", (1,2), 7]; right = ["x", "y", 9]
+    g = nx.MultiGraph() if multi else nx.Graph()
+    for i,u in enumerate(left):
+        for j,v in enumerate(right): g.add_edge(u,v,w=(i+j)*scale)
+    if multi: g.add_edge("a","x",w=3)
+    g.add_node("isolated")
+    before = copy.deepcopy(dict(g.nodes(data=True))), copy.deepcopy(list(g.edges(data=True)))
+    want = expected(g,left,right)
+    assert nx.bipartite.butterflies(g,weight="w") == want
+    assert nx.bipartite.butterflies(g,nodes=iter(["a","isolated"]),weight="w") == {n:want[n] for n in ["a","isolated"]}
+    assert before == (dict(g.nodes(data=True)),list(g.edges(data=True)))
+
+def test_missing_weights_default_one():
+    g = nx.complete_bipartite_graph(2,2)
+    g[0][2]["w"] = 5
+    assert nx.bipartite.butterflies(g,weight="w") == dict.fromkeys(g,5)
+
+@pytest.mark.parametrize("bad", [-1, float("inf"), float("nan"), "x"])
+def test_invalid_even_outside_subset(bad):
+    g = nx.complete_bipartite_graph(2,2)
+    g.add_edge("unrelated", "other", w=bad)
+    with pytest.raises(ValueError): nx.bipartite.butterflies(g,nodes=[0],weight="w")
+
+def test_unweighted_parallel_edges_still_collapse():
+    g=nx.MultiGraph(nx.complete_bipartite_graph(2,2));g.add_edge(0,2)
+    assert nx.bipartite.butterflies(g) == dict.fromkeys(g,1)

+def _readline_prompt(func: t.Callable[[str], str], text: str, err: bool) -> str:
+    """Call a prompt function, passing the full prompt on non-Windows so
+    readline can handle line editing and cursor positioning correctly.
+
+    On Windows the prompt is written separately via :func:`echo` for
+    colorama support, with only the last character passed to *func*.
+    """
+    target = sys.stderr if err else sys.stdout
+    if WIN:
+        echo(text[:-1], nl=False, err=err)
+        if err:
+            with redirect_stdout(target):
+                return func(text[-1:])
+        return func(text[-1:])
+    if func is visible_prompt_func and func is not hidden_prompt_func:
+        # Normalize existing readline delimiters before wrapping CSI sequences.
+        text = text.replace("\001", "").replace("\002", "")
+        if isatty(target):
+            text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]",
+                          lambda match: "\001" + match.group() + "\002", text)
+        else:
+            text = strip_ansi(text)
+    if err:
+        with redirect_stdout(target):
+            return func(text)
+    return func(text)
+

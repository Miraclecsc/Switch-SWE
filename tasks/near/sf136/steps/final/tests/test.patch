+++ b/tests/test_sf136_readline.py
@@ -0,0 +1,57 @@
+import sys
+import click
+import pytest
+from click import termui
+
+@pytest.mark.parametrize("confirm", [False, True])
+@pytest.mark.parametrize("err", [False, True])
+def test_color_terminal_and_redirect(monkeypatch, confirm, err):
+    seen=[]
+    monkeypatch.setattr(termui,"WIN",False)
+    monkeypatch.setattr(termui,"isatty",lambda stream: stream is (sys.stderr if err else sys.stdout))
+    monkeypatch.setattr(termui,"visible_prompt_func",lambda text: seen.append(text) or "y")
+    name="\x1b[31mName\x1b[0m"
+    (click.confirm if confirm else click.prompt)(name,err=err)
+    assert seen == ["\x01\x1b[31m\x02Name\x01\x1b[0m\x02" + (" [y/N]: " if confirm else ": ")]
+
+def test_piped_and_preannotated(monkeypatch):
+    seen=[]
+    monkeypatch.setattr(termui,"WIN",False)
+    monkeypatch.setattr(termui,"visible_prompt_func",lambda text:seen.append(text) or "ok")
+    monkeypatch.setattr(termui,"isatty",lambda stream:False)
+    click.prompt("\x01\x1b[32m\x02Name\x01\x1b[0m\x02")
+    assert seen == ["Name: "]
+    monkeypatch.setattr(termui,"isatty",lambda stream:True)
+    click.prompt("\x01\x1b[32m\x02Name\x01\x1b[0m\x02")
+    assert seen[-1] == "\x01\x1b[32m\x02Name\x01\x1b[0m\x02: "
+
+@pytest.mark.parametrize("confirm", [False,True])
+@pytest.mark.parametrize("suffix", ["",": "])
+def test_windows_complete_stderr(monkeypatch,capsys,confirm,suffix):
+    monkeypatch.setattr(termui,"WIN",True)
+    def read(text):
+        print(text,end="")
+        return "y"
+    monkeypatch.setattr(termui,"visible_prompt_func",read)
+    before=sys.stdout
+    (click.confirm if confirm else click.prompt)("Name",err=True,prompt_suffix=suffix)
+    assert sys.stdout is before
+    out,err=capsys.readouterr()
+    assert out == ""
+    assert err == "Name" + (" [y/N]" if confirm else "") + suffix
+
+def test_windows_abort_restores_stream(monkeypatch,capsys):
+    monkeypatch.setattr(termui,"WIN",True)
+    def abort(text): raise EOFError()
+    monkeypatch.setattr(termui,"visible_prompt_func",abort)
+    before=sys.stdout
+    with pytest.raises(click.Abort): click.prompt("Name",err=True)
+    assert sys.stdout is before
+
+def test_hidden_full_unannotated(monkeypatch):
+    seen=[]
+    monkeypatch.setattr(termui,"WIN",False)
+    monkeypatch.setattr(termui,"isatty",lambda stream:True)
+    monkeypatch.setattr(termui,"hidden_prompt_func",lambda text:seen.append(text) or "secret")
+    click.prompt("Password",hide_input=True)
+    assert seen == ["Password: "]

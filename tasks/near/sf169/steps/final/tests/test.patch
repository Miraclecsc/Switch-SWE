+++ b/tests/test_sf169_staged.py
@@ -0,0 +1,31 @@
+import networkx as nx
+import pytest
+
+class Bound:
+    def __init__(self, value): self.value = value
+    def __index__(self): return self.value
+
+def test_index_bound_selfloops_and_parallel_edges():
+    for kind in (nx.MultiGraph, nx.MultiDiGraph):
+        graph = kind()
+        graph.add_edge("loop", "loop")
+        graph.add_edge("a", "b")
+        graph.add_edge("b", "a")
+        for bound in (0, 1, 2, 3):
+            expected = list(nx.chordless_cycles(graph, length_bound=bound))
+            assert list(nx.chordless_cycles(graph, length_bound=Bound(bound))) == expected
+
+def test_noninteger_bounds_rejected_before_yield():
+    for kind in (nx.Graph, nx.DiGraph, nx.MultiGraph, nx.MultiDiGraph):
+        for invalid in (1.5, 2.0, float("inf"), "2"):
+            graph = kind()
+            graph.add_edge(0, 0)
+            with pytest.raises(TypeError):
+                list(nx.chordless_cycles(graph, length_bound=invalid))
+
+def test_negative_index_bound_and_input_integrity():
+    graph = nx.MultiGraph([(0, 0), (0, 1), (0, 1)])
+    before = list(graph.edges(keys=True))
+    with pytest.raises(ValueError):
+        list(nx.chordless_cycles(graph, length_bound=Bound(-1)))
+    assert list(graph.edges(keys=True)) == before

+from types import MappingProxyType
+from unittest.mock import patch
+import networkx as nx
+import pytest
+
+class Once:
+    def __init__(self,rows):self.rows=rows;self.calls=0
+    def __iter__(self):
+        self.calls+=1
+        assert self.calls==1
+        yield from self.rows
+
+@pytest.mark.parametrize("directed", [False,True])
+@pytest.mark.parametrize("weighted", [False,True])
+def test_generator_cache(directed,weighted):
+    G=nx.DiGraph() if directed else nx.Graph()
+    G.add_weighted_edges_from([(0,1,2),(1,2,5),(2,0,1),(2,3,4)]);G.add_node(4)
+    kwargs={"distance":"weight"} if weighted else {}
+    expected=nx.closeness_centrality(G,**kwargs)
+    rows=list(nx.all_pairs_dijkstra_path_length(G,weight="weight") if weighted else nx.all_pairs_shortest_path_length(G))
+    cache=Once(rows)
+    with patch.object(nx,"single_source_shortest_path_length",side_effect=AssertionError("recomputed")),patch.object(nx,"single_source_dijkstra_path_length",side_effect=AssertionError("recomputed")):
+        assert nx.closeness_centrality(G,sp=cache,**kwargs)==expected
+    assert cache.calls==1
+
+@pytest.mark.parametrize("improved", [False,True])
+def test_inward_asymmetric_and_partial(improved):
+    G=nx.DiGraph();G.add_weighted_edges_from([(0,1,2),(1,2,5),(2,0,1),(2,3,4)]);G.add_node(4)
+    expected=nx.closeness_centrality(G,distance="weight",wf_improved=improved)
+    inward=dict(nx.all_pairs_dijkstra_path_length(G.reverse(),weight="weight"))
+    assert nx.closeness_centrality(G,sp=inward,sp_orientation="inward",wf_improved=improved)==expected
+    for node in [0,3,4]:
+        cache=Once([(node,MappingProxyType(inward[node]))])
+        assert nx.closeness_centrality(G,u=node,sp=cache,sp_orientation="inward",wf_improved=improved,distance="unused")==expected[node]
+
+def test_mapping_unchanged():
+    G=nx.path_graph(4,create_using=nx.DiGraph)
+    raw=dict(nx.all_pairs_shortest_path_length(G))
+    cache=MappingProxyType({k:MappingProxyType(v) for k,v in raw.items()})
+    before={k:dict(v) for k,v in cache.items()}
+    assert nx.closeness_centrality(G,sp=cache)==nx.closeness_centrality(G)
+    assert cache==before
+
+def test_bad_orientation_does_not_consume():
+    rows=Once([(0,{0:0})])
+    with pytest.raises(ValueError):nx.closeness_centrality(nx.empty_graph(1),sp=rows,sp_orientation="sideways")
+    assert rows.calls==0
+
+def test_undirected_inward():
+    G=nx.path_graph(4)
+    assert nx.closeness_centrality(G,sp=nx.all_pairs_shortest_path_length(G),sp_orientation="inward")==nx.closeness_centrality(G)

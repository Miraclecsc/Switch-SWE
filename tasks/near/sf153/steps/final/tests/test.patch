diff --git a/tests/test_staged_contract.py b/tests/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_staged_contract.py
@@ -0,0 +1,227 @@
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from anyio import (
+    CancelScope, CapacityLimiter, Event, WouldBlock, create_task_group,
+    fail_after, run, sleep, wait_all_tasks_blocked,
+)
+
+
+def invoke(func, name, options):
+    run(func, backend=name, backend_options=options)
+
+
+def test_a2_event_set_before_run_and_after_cancel(anyio_backend_name, anyio_backend_options):
+    event = Event()
+    assert not event.is_set()
+    assert event.statistics().tasks_waiting == 0
+    event.set()
+    event.set()
+    for _ in range(2):
+        async def use():
+            with fail_after(2):
+                await event.wait()
+            assert event.is_set()
+            assert event.statistics().tasks_waiting == 0
+        invoke(use, anyio_backend_name, anyio_backend_options)
+    assert event.is_set()
+    assert event.statistics().tasks_waiting == 0
+
+
+def test_a3_offloop_explicit_borrow_and_release(anyio_backend_name, anyio_backend_options):
+    limiter = CapacityLimiter(2)
+    a, b, c = object(), object(), object()
+    limiter.acquire_on_behalf_of_nowait(a)
+    limiter.acquire_on_behalf_of_nowait(b)
+    stats = limiter.statistics()
+    assert stats.borrowed_tokens == 2 and set(stats.borrowers) == {a, b}
+    assert limiter.available_tokens == 0
+    with pytest.raises(WouldBlock):
+        limiter.acquire_on_behalf_of_nowait(c)
+    with pytest.raises(RuntimeError):
+        limiter.acquire_on_behalf_of_nowait(a)
+    with pytest.raises(RuntimeError):
+        limiter.release_on_behalf_of(c)
+    limiter.release_on_behalf_of(a)
+    assert stats.borrowed_tokens == 2  # statistics is a snapshot
+    limiter.release_on_behalf_of(b)
+    assert limiter.borrowed_tokens == 0
+    assert limiter.available_tokens == 2
+
+
+def test_a4_borrowers_survive_sequential_runs(anyio_backend_name, anyio_backend_options):
+    limiter = CapacityLimiter(2)
+    a, b, c = object(), object(), object()
+    limiter.acquire_on_behalf_of_nowait(a)
+
+    async def first():
+        assert set(limiter.statistics().borrowers) == {a}
+        await limiter.acquire_on_behalf_of(b)
+        assert limiter.borrowed_tokens == 2
+
+    invoke(first, anyio_backend_name, anyio_backend_options)
+    assert set(limiter.statistics().borrowers) == {a, b}
+    limiter.total_tokens = 1
+    assert limiter.available_tokens == -1
+    with pytest.raises(WouldBlock):
+        limiter.acquire_on_behalf_of_nowait(c)
+    limiter.release_on_behalf_of(a)
+    assert limiter.available_tokens == 0
+
+    async def second():
+        assert set(limiter.statistics().borrowers) == {b}
+        limiter.release_on_behalf_of(b)
+        async with limiter:
+            assert limiter.borrowed_tokens == 1
+        assert limiter.borrowed_tokens == 0
+
+    # Same object moves between sequential runs, including a different backend.
+    run(second, backend="trio" if anyio_backend_name == "asyncio" else "asyncio")
+    assert limiter.available_tokens == 1 and limiter.statistics().borrowers == ()
+
+
+def test_a5_fifo_grants_prevent_barging(anyio_backend_name, anyio_backend_options):
+    limiter = CapacityLimiter(1)
+    owner, first, second, outsider = (object() for _ in range(4))
+    limiter.acquire_on_behalf_of_nowait(owner)
+
+    async def use():
+        order = []
+        release_first = Event()
+        async def waiter(borrower):
+            await limiter.acquire_on_behalf_of(borrower)
+            order.append(borrower)
+            if borrower is first:
+                await release_first.wait()
+            limiter.release_on_behalf_of(borrower)
+        with fail_after(3):
+            async with create_task_group() as tg:
+                tg.start_soon(waiter, first)
+                await wait_all_tasks_blocked()
+                tg.start_soon(waiter, second)
+                await wait_all_tasks_blocked()
+                assert limiter.statistics().tasks_waiting == 2
+                limiter.release_on_behalf_of(owner)
+                with pytest.raises(WouldBlock):
+                    limiter.acquire_on_behalf_of_nowait(outsider)
+                await wait_all_tasks_blocked()
+                assert order == [first]
+                release_first.set()
+        assert order == [first, second]
+        assert limiter.borrowed_tokens == 0 and limiter.statistics().tasks_waiting == 0
+
+    invoke(use, anyio_backend_name, anyio_backend_options)
+    assert limiter.available_tokens == 1
+
+
+def test_a5_growth_reserves_only_free_capacity(anyio_backend_name, anyio_backend_options):
+    limiter = CapacityLimiter(3)
+    owners = [object() for _ in range(3)]
+    for borrower in owners:
+        limiter.acquire_on_behalf_of_nowait(borrower)
+    limiter.total_tokens = 1
+
+    async def use():
+        entered = Event()
+        child = object()
+        async def waiter():
+            await limiter.acquire_on_behalf_of(child)
+            entered.set()
+            limiter.release_on_behalf_of(child)
+        with fail_after(3):
+            async with create_task_group() as tg:
+                tg.start_soon(waiter)
+                await wait_all_tasks_blocked()
+                limiter.total_tokens = 2
+                await wait_all_tasks_blocked()
+                assert not entered.is_set()
+                limiter.release_on_behalf_of(owners.pop())
+                await wait_all_tasks_blocked()
+                assert not entered.is_set()
+                limiter.release_on_behalf_of(owners.pop())
+                await entered.wait()
+        assert limiter.borrowed_tokens == 1
+
+    invoke(use, anyio_backend_name, anyio_backend_options)
+    limiter.release_on_behalf_of(owners.pop())
+    assert limiter.available_tokens == 2
+
+
+def test_a6_cancel_queued_and_granted_waiters(anyio_backend_name, anyio_backend_options):
+    for grant_before_cancel in (False, True):
+        limiter = CapacityLimiter(1)
+        owner, victim, survivor = object(), object(), object()
+        limiter.acquire_on_behalf_of_nowait(owner)
+        async def use():
+            scope = CancelScope()
+            done = Event()
+            async def doomed():
+                with scope:
+                    await limiter.acquire_on_behalf_of(victim)
+                    # No checkpoint may intervene before cancelling a queued grant.
+                    pytest.fail("cancelled waiter acquired a token")
+            async def remaining():
+                await limiter.acquire_on_behalf_of(survivor)
+                limiter.release_on_behalf_of(survivor)
+                done.set()
+            with fail_after(3):
+                async with create_task_group() as tg:
+                    tg.start_soon(doomed)
+                    await wait_all_tasks_blocked()
+                    tg.start_soon(remaining)
+                    await wait_all_tasks_blocked()
+                    if grant_before_cancel:
+                        limiter.release_on_behalf_of(owner)
+                        scope.cancel()
+                    else:
+                        scope.cancel()
+                        await wait_all_tasks_blocked()
+                        limiter.release_on_behalf_of(owner)
+                    await done.wait()
+            assert limiter.borrowed_tokens == 0
+            assert limiter.statistics().tasks_waiting == 0
+        invoke(use, anyio_backend_name, anyio_backend_options)
+        assert limiter.statistics().borrowers == ()
+
+
+def test_a7_failed_updates_are_atomic(anyio_backend_name, anyio_backend_options):
+    limiter = CapacityLimiter(2)
+    owner = object()
+    limiter.acquire_on_behalf_of_nowait(owner)
+    before = limiter.statistics()
+    for value, error in ((0, ValueError), (-1, ValueError), (1.5, TypeError),
+                         (float("nan"), TypeError), ("3", TypeError), (None, TypeError)):
+        with pytest.raises(error):
+            limiter.total_tokens = value
+        assert limiter.statistics() == before
+    limiter.total_tokens = float("inf")
+    assert limiter.total_tokens == math.inf and limiter.available_tokens == math.inf
+    limiter.total_tokens = 1
+    assert limiter.borrowed_tokens == 1 and limiter.available_tokens == 0
+    limiter.release_on_behalf_of(owner)
+
+
+def test_a8_cancelled_event_can_be_reused(anyio_backend_name, anyio_backend_options):
+    event = Event()
+    async def cancel_wait():
+        scope = CancelScope()
+        async def waiter():
+            with scope:
+                await event.wait()
+        async with create_task_group() as tg:
+            tg.start_soon(waiter)
+            await wait_all_tasks_blocked()
+            assert event.statistics().tasks_waiting == 1
+            scope.cancel()
+        assert event.statistics().tasks_waiting == 0
+    invoke(cancel_wait, anyio_backend_name, anyio_backend_options)
+    assert not event.is_set()
+    assert event.statistics().tasks_waiting == 0
+    event.set()
+    async def reuse():
+        with fail_after(2):
+            await event.wait()
+    run(reuse, backend="trio" if anyio_backend_name == "asyncio" else "asyncio")

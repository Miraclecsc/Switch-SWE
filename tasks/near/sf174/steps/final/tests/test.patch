@@ -0,0 +1,34 @@
+import io
+import gc
+import click
+
+def test_text_only_pager_strips_color(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr("sys.stdout", stream)
+    with click.get_pager_file(color=False) as pager:
+        pager.write("\x1b[31mred\x1b[0m")
+        pager.writelines(["\x1b[32mgreen\x1b[0m", " plain"])
+    gc.collect()
+    assert not stream.closed
+    assert stream.getvalue() == "redgreen plain"
+
+def test_text_only_pager_preserves_requested_color(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr("sys.stdout", stream)
+    with click.get_pager_file(color=True) as pager:
+        pager.write("\x1b[31mred\x1b[0m")
+    assert stream.getvalue() == "\x1b[31mred\x1b[0m"
+    assert not stream.closed
+
+def test_text_pager_exception_keeps_borrowed_stream(monkeypatch):
+    stream = io.StringIO()
+    monkeypatch.setattr("sys.stdout", stream)
+    try:
+        with click.get_pager_file(color=False) as pager:
+            pager.write("\x1b[31mred\x1b[0m")
+            raise RuntimeError("body")
+    except RuntimeError:
+        pass
+    gc.collect()
+    stream.write(" after")
+    assert stream.getvalue() == "red after"

+def _truncate_visible(text: str, n: int) -> str:
+    """Return the longest prefix of ``text`` containing at most ``n`` visible
+    characters.
+
+    ANSI escape sequences inside the prefix are kept intact and do not count
+    toward the visible width. A cut is never placed inside an escape sequence.
+    """
+    if n <= 0:
+        return ""
+
+    visible = 0
+    i = 0
+    cut = 0
+    end = len(text)
+    while i < end:
+        m = _ansi_re.match(text, i)
+        if m is not None:
+            i = m.end()
+            continue
+        visible += 1
+        i += 1
+        cut = i
+        if visible >= n:
+            break
+    return text[:cut]
+
 
 class TextWrapper(textwrap.TextWrapper):
+    """``textwrap.TextWrapper`` variant that measures widths by visible
+    character count.
+
+    ANSI escape sequences embedded in chunks, indents, or the placeholder are
+    excluded from the width budget. Without this, styled help text (a styled
+    ``Usage:`` prefix, a colorized option name, ...) would be wrapped earlier
+    than its visible length warrants and tokens would split mid-word.
+    """
+
+    def _munge_whitespace(self, text: str) -> str:
+        result = []
+        offset = 0
+        for match in _ansi_re.finditer(text):
+            result.append(super()._munge_whitespace(text[offset:match.start()]))
+            result.append(match.group())
+            offset = match.end()
+        result.append(super()._munge_whitespace(text[offset:]))
+        return "".join(result)
+
+    def _split(self, text: str) -> list[str]:
+        # Split the visible text, not control payloads (which can contain
+        # whitespace and punctuation). Map the chunks back to intact controls.
+        units: list[str] = []
+        visible: list[str] = []
+        pending = ""
+        i = 0
+        while i < len(text):
+            match = _ansi_re.match(text, i)
+            if match is not None:
+                if units and not visible[-1].isspace():
+                    units[-1] += match.group()
+                else:
+                    pending += match.group()
+                i = match.end()
+            else:
+                units.append(pending + text[i])
+                visible.append(text[i])
+                pending = ""
+                i += 1
+        if not units:
+            return [pending] if pending else []
+        units[-1] += pending
+        result = []
+        offset = 0
+        for chunk in super()._split("".join(visible)):
+            result.append("".join(units[offset:offset + len(chunk)]))
+            offset += len(chunk)
+        return result
+

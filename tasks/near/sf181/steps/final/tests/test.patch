diff --git a/tests/test_sf181_staged.py b/tests/test_sf181_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf181_staged.py
@@ -0,0 +1,22 @@
+
+import sys
+import types
+from packaging import tags
+
+def test_armv8l_32bit_hardfloat_and_fallback(monkeypatch):
+    monkeypatch.setattr(tags.distutils.util, 'get_platform', lambda: 'linux-armv8l')
+    monkeypatch.setattr(tags, '_is_manylinux_compatible', lambda *args: True)
+    monkeypatch.setattr(tags, '_is_linux_armhf', lambda: True)
+    assert list(tags._linux_platforms(is_32bit=True)) == ['manylinux2014_armv7l', 'linux_armv7l']
+    monkeypatch.setattr(tags, '_is_linux_armhf', lambda: False)
+    assert list(tags._linux_platforms(is_32bit=True)) == ['linux_armv7l']
+
+def test_explicit_manylinux_veto_survives_newer_acceptance(monkeypatch):
+    monkeypatch.setattr(tags.distutils.util, 'get_platform', lambda: 'linux-x86_64')
+    monkeypatch.setitem(sys.modules, '_manylinux', types.SimpleNamespace(manylinux2014_compatible=True, manylinux2010_compatible=False, manylinux1_compatible=True))
+    assert list(tags._linux_platforms(is_32bit=False)) == ['manylinux2014_x86_64', 'manylinux1_x86_64', 'linux_x86_64']
+
+def test_missing_older_flags_keep_inference(monkeypatch):
+    monkeypatch.setattr(tags.distutils.util, 'get_platform', lambda: 'linux-x86_64')
+    monkeypatch.setitem(sys.modules, '_manylinux', types.SimpleNamespace(manylinux2014_compatible=True))
+    assert list(tags._linux_platforms(is_32bit=False)) == ['manylinux2014_x86_64', 'manylinux2010_x86_64', 'manylinux1_x86_64', 'linux_x86_64']

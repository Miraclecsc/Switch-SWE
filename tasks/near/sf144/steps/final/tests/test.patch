diff --git a/tests/test_sf144_position.py b/tests/test_sf144_position.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf144_position.py
@@ -0,0 +1,33 @@
+import pytest
+from rich.cells import chop_cells,cell_len
+from rich._wrap import divide_line
+
+def chunks(text,breaks):
+    points=[0,*breaks,len(text)]
+    return [text[a:b] for a,b in zip(points,points[1:])]
+
+def test_chop_occupied_prefix_and_unicode():
+    assert chop_cells("ab界cd",4,position=2)==["ab","界cd"]
+    assert chop_cells("界a",4,position=4)==["","界a"]
+    assert chop_cells("界\u0301a",1)==["界\u0301","a"]
+    assert chop_cells("",4,position=4)==[""]
+
+def test_divide_first_long_word_uses_remainder():
+    text="ab界cd"
+    result=chunks(text,divide_line(text,4,position=2))
+    assert result==["ab","界cd"]
+    assert "".join(result)==text
+    assert cell_len(result[0])+2<=4
+
+def test_break_before_short_word_and_full_initial_line():
+    assert divide_line("abc de",4,position=3)==[0,4]
+    assert divide_line("abc",4,position=4)==[0]
+    assert divide_line("abcdef",4,position=3,fold=False)==[]
+
+@pytest.mark.parametrize("width,position",[(0,0),(-1,0),(3,-1),(3,4)])
+def test_invalid_dimensions(width,position):
+    for fn in [chop_cells,divide_line]:
+        with pytest.raises(ValueError):fn("x",width,position=position)
+
+def test_zero_position_original_mixed_case():
+    assert chop_cells("あ1り234が5と6う78",3)==["あ1","り2","34","が5","と6","う7","8"]

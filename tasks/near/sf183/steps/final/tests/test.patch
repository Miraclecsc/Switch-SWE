diff --git a/tests/test_sf183_staged.py b/tests/test_sf183_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf183_staged.py
@@ -0,0 +1,24 @@
+
+from packaging.specifiers import SpecifierSet
+from packaging.version import Version
+
+def test_fallback_applies_after_all_constraints():
+    spec = SpecifierSet('>=1,<=2,!=1.5')
+    candidates = [Version('1.2rc1+cpu'), '1.5', '3.0']
+    result = list(spec.filter(iter(candidates)))
+    assert result == [candidates[0]]
+    assert result[0] is candidates[0]
+
+def test_final_local_version_suppresses_preview():
+    preview = Version('1.2rc1+cpu')
+    final = Version('2.0+gpu')
+    assert list(SpecifierSet('>=1,<=2').filter(iter([preview, final]))) == [final]
+
+def test_explicit_prerelease_preferences_and_order():
+    values = ['1.2rc1+cpu', '1.3rc2+gpu']
+    spec = SpecifierSet('>=1,<=2')
+    assert list(spec.filter(iter(values))) == values
+    assert list(spec.filter(values, prereleases=False)) == []
+    assert list(SpecifierSet('>=1,<=2', prereleases=False).filter(values)) == []
+    assert list(SpecifierSet('>=1,<=2', prereleases=False).filter(values, prereleases=True)) == values
+    assert not spec.contains(values[0])

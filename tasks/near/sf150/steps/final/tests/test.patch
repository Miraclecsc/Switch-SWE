diff --git a/tests/test_sf150_resize.py b/tests/test_sf150_resize.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf150_resize.py
@@ -0,0 +1,69 @@
+import math
+import pytest
+from anyio import (create_memory_object_stream,create_task_group,wait_all_tasks_blocked,
+                   open_cancel_scope,create_event,WouldBlock,ClosedResourceError,BrokenResourceError)
+
+pytestmark=pytest.mark.anyio
+
+async def test_grow_wakes_fifo_and_keeps_snapshot():
+    send,receive=create_memory_object_stream(1);clone=send.clone()
+    send.send_nowait("head")
+    async with create_task_group() as tg:
+        for value in [1,2,3]:
+            tg.spawn(send.send,value)
+            await wait_all_tasks_blocked()
+        before=receive.statistics()
+        clone.set_max_buffer_size(3)
+        after=send.statistics()
+        assert (after.max_buffer_size,after.current_buffer_used,after.tasks_waiting_send)==(3,3,1)
+        assert (before.max_buffer_size,before.current_buffer_used,before.tasks_waiting_send)==(1,1,3)
+        assert [receive.receive_nowait() for _ in range(4)]==["head",1,2,3]
+    assert receive.statistics().tasks_waiting_send==0
+
+async def test_shrink_drains_before_admitting_waiters():
+    send,receive=create_memory_object_stream(3)
+    for value in [0,1,2]:send.send_nowait(value)
+    async with create_task_group() as tg:
+        tg.spawn(send.send,3);await wait_all_tasks_blocked()
+        send.set_max_buffer_size(1)
+        assert receive.receive_nowait()==0
+        stats=receive.statistics()
+        assert stats.current_buffer_used==2 and stats.tasks_waiting_send==1
+        assert receive.receive_nowait()==1
+        assert receive.statistics().tasks_waiting_send==1
+        assert receive.receive_nowait()==2
+        assert receive.statistics().tasks_waiting_send==0
+        assert receive.receive_nowait()==3
+    send.set_max_buffer_size(0)
+    with pytest.raises(WouldBlock):send.send_nowait("blocked")
+    send.set_max_buffer_size(math.inf);send.send_nowait("accepted")
+    assert receive.receive_nowait()=="accepted"
+
+async def test_invalid_and_closed_are_atomic():
+    send,receive=create_memory_object_stream(1);send.send_nowait("kept")
+    before=send.statistics()
+    for size in [-1,1.5,float("nan"),-math.inf,"2",None]:
+        with pytest.raises(ValueError):send.set_max_buffer_size(size)
+        assert send.statistics()==before
+    clone=send.clone();await clone.aclose()
+    with pytest.raises(ClosedResourceError):clone.set_max_buffer_size(2)
+    assert receive.receive_nowait()=="kept"
+    await receive.aclose()
+    with pytest.raises(BrokenResourceError):send.set_max_buffer_size(2)
+
+async def test_cancelled_sender_not_revived():
+    send,receive=create_memory_object_stream(0);scopes=[];finished=create_event()
+    async def blocked():
+        try:
+            with open_cancel_scope() as scope:
+                scopes.append(scope)
+                await send.send("cancelled")
+        finally:
+            finished.set()
+    async with create_task_group() as tg:
+        tg.spawn(blocked);await wait_all_tasks_blocked()
+        scopes[0].cancel();await finished.wait()
+        send.set_max_buffer_size(2)
+        assert send.statistics().tasks_waiting_send==0
+        assert send.statistics().current_buffer_used==0
+        with pytest.raises(WouldBlock):receive.receive_nowait()

+from unittest.mock import patch
+from django.db import connection
+from django.db.models import CharField, Q, Value
+from django.test import TestCase
+from .models import NullableName
+
+
+class ExclusionInputTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        for name in (None, "alpha", "beta", "gamma"):
+            NullableName.objects.create(name=name)
+
+    def names(self, queryset):
+        return list(queryset.order_by("pk").values_list("name", flat=True))
+
+    def test_backend_in_list_splitting(self):
+        with patch.object(connection.ops, "max_in_list_size", return_value=1):
+            self.assertEqual(self.names(NullableName.objects.exclude(name__in=[None, "alpha", None, "beta"])), ["gamma"])
+            self.assertEqual(self.names(NullableName.objects.exclude(name__in=[None, None])), ["alpha", "beta", "gamma"])
+
+    def test_constant_value_entries(self):
+        rhs = [Value(None, output_field=CharField()), Value("alpha", output_field=CharField())]
+        self.assertEqual(self.names(NullableName.objects.exclude(name__in=rhs)), ["beta", "gamma"])
+        self.assertEqual(len(rhs), 2)
+        self.assertIsNone(rhs[0].value)
+
+    def test_one_shot_iterable_survives_cloning(self):
+        class Once:
+            def __init__(self):
+                self.items = iter([None, "alpha"])
+            def __iter__(self):
+                return self.items
+        query = NullableName.objects.exclude(name__in=Once())
+        str(query.query)
+        str(query.query)
+        self.assertEqual(self.names(query.all()), ["beta", "gamma"])
+        self.assertEqual(self.names(query), ["beta", "gamma"])
+
+    def test_generator_and_negated_q(self):
+        query = NullableName.objects.filter(~Q(name__in=(x for x in (None, "alpha"))))
+        self.assertEqual(self.names(query), ["beta", "gamma"])
+        self.assertEqual(self.names(NullableName.objects.exclude(name__in=[])), [None, "alpha", "beta", "gamma"])

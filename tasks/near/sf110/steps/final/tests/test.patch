@@ -0,0 +1,61 @@
+import threading
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+from django.contrib import auth
+from django.contrib.auth.middleware import RemoteUserMiddleware
+from django.test import SimpleTestCase
+
+
+class RemoteCleanerTests(SimpleTestCase):
+    def middleware(self):
+        return RemoteUserMiddleware(lambda request: None)
+
+    def request(self):
+        return SimpleNamespace(session=SimpleNamespace(aget=AsyncMock(return_value="backend")))
+
+    async def test_async_backend_hook_precedence(self):
+        class Backend:
+            async def aclean_username(self, username):
+                return username.upper()
+            def clean_username(self, username):
+                raise AssertionError("sync hook must not run when async hook exists")
+        with patch.object(auth, "load_backend", return_value=Backend()):
+            try:
+                result = await self.middleware().aclean_username("alice", self.request())
+            except Exception as exc:
+                self.fail("Async cleaner dispatch failed: %r" % (exc,))
+        self.assertEqual(result, "ALICE")
+
+    async def test_sync_cleaner_is_offloaded(self):
+        event_loop_thread = threading.get_ident()
+        observed = []
+        class Backend:
+            def clean_username(self, username):
+                observed.append(threading.get_ident())
+                return username.upper()
+        with patch.object(auth, "load_backend", return_value=Backend()):
+            result = await self.middleware().aclean_username("alice", self.request())
+        self.assertEqual(result, "ALICE")
+        self.assertEqual(len(observed), 1)
+        self.assertNotEqual(observed[0], event_loop_thread)
+
+    async def test_async_cleaner_attribute_error_propagates(self):
+        class Backend:
+            async def aclean_username(self, username):
+                raise AttributeError("cleaner exploded")
+        with patch.object(auth, "load_backend", return_value=Backend()):
+            with self.assertRaisesMessage(AttributeError, "cleaner exploded"):
+                await self.middleware().aclean_username("alice", self.request())
+
+    def test_sync_cleaner_attribute_error_propagates(self):
+        class Backend:
+            def clean_username(self, username):
+                raise AttributeError("cleaner exploded")
+        request = SimpleNamespace(session={auth.BACKEND_SESSION_KEY: "backend"})
+        with patch.object(auth, "load_backend", return_value=Backend()):
+            with self.assertRaisesMessage(AttributeError, "cleaner exploded"):
+                self.middleware().clean_username("alice", request)
+
+    async def test_absent_cleaner_is_optional(self):
+        with patch.object(auth, "load_backend", return_value=SimpleNamespace()):
+            self.assertEqual(await self.middleware().aclean_username("alice", self.request()), "alice")

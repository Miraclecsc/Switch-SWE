+import click
+
+
+class Marker:
+    pass
+
+
+def test_lazy_true_default_aligns_without_calling_flag_value(runner):
+    calls = []
+    def default():
+        calls.append("factory")
+        return True
+    @click.command()
+    @click.option("--mode", flag_value=Marker, type=click.UNPROCESSED, default=default)
+    def cli(mode):
+        assert mode is Marker
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert calls == ["factory"]
+
+
+def test_default_map_factory_has_same_true_alignment(runner):
+    calls = []
+    @click.command()
+    @click.option("--mode", flag_value=Marker, type=click.UNPROCESSED, default=False)
+    def cli(mode):
+        assert mode is Marker
+    def factory():
+        calls.append("map")
+        return True
+    result = runner.invoke(cli, [], default_map={"mode":factory})
+    assert result.exit_code == 0, result.output
+    assert calls == ["map"]
+
+
+def test_call_false_and_help_never_evaluate_factory(runner):
+    calls = []
+    def factory():
+        calls.append(1)
+        return True
+    @click.command()
+    @click.option("--mode", flag_value=Marker, type=click.UNPROCESSED, default=factory, show_default=True)
+    def cli(mode):
+        pass
+    option = cli.params[0]
+    assert option.get_default(click.Context(cli),call=False) is factory
+    assert runner.invoke(cli,["--help"]).exit_code == 0
+    assert calls == []
+
+
+def test_explicit_flag_wins_without_evaluating_default(runner):
+    def forbidden():
+        raise AssertionError("Default should not be used")
+    @click.command()
+    @click.option("--mode",flag_value=Marker,type=click.UNPROCESSED,default=forbidden)
+    def cli(mode):
+        assert mode is Marker
+    assert runner.invoke(cli,["--mode"]).exit_code == 0
+
+
+def test_explicit_callable_default_retains_factory_semantics():
+    option = click.Option(["--mode"],flag_value=Marker,type=click.UNPROCESSED,default=Marker)
+    assert isinstance(option.get_default(click.Context(click.Command("cli"))), Marker)
+
+
+def test_nonflag_true_factory_remains_boolean_true():
+    option = click.Option(["--value"],type=click.UNPROCESSED,default=lambda:True)
+    assert option.get_default(click.Context(click.Command("cli"))) is True

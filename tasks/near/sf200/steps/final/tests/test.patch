--- /dev/null
+++ b/tests/test_sf200_staged.py
@@ -0,0 +1,27 @@
+
+import pytest
+from sympy import Matrix, Rational, zeros
+from sympy.solvers.simplex import linprog
+
+def test_bounds_only_returns_complete_decision_vector():
+    optimum, solution = linprog([-1,2], bounds=[(0,5),(0,3)])
+    assert optimum == -5 and solution == [5,0]
+
+def test_sparse_bounds_are_reusable_and_preserved_on_failure():
+    bounds = {0:(0,5)}
+    first = linprog([-1,1], bounds=bounds)
+    assert bounds == {0:(0,5)}
+    assert linprog([-1,1], bounds=bounds) == first
+    invalid = {3:(0,1)}
+    with pytest.raises((IndexError,ValueError)):
+        linprog([1],bounds=invalid)
+    assert invalid == {3:(0,1)}
+
+def test_empty_matrix_shape_and_constraint_pairs_are_validated():
+    for kwargs in ({'A':zeros(0,3), 'b':zeros(0,1)}, {'A':[[1,0]], 'b':None}, {'A_eq':[[1,0]], 'b_eq':None}, {'A_eq':[[1,0]], 'b_eq':[1,2]}, {'A_eq':zeros(0,3), 'b_eq':zeros(0,1)}):
+        with pytest.raises(ValueError):
+            linprog([1,2],**kwargs)
+
+def test_equality_only_exact_arithmetic():
+    optimum, solution = linprog([1,2], A_eq=[[1,1]], b_eq=[Rational(1,2)])
+    assert optimum == Rational(1,2) and solution == [Rational(1,2),0]

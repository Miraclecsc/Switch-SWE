@@ -0,0 +1,62 @@
+import warnings
+from types import SimpleNamespace
+
+from django.contrib import admin
+from django.test import SimpleTestCase
+from .models import Band
+
+
+class ActionContractTests(SimpleTestCase):
+    def request(self):
+        return SimpleNamespace(GET={}, user=SimpleNamespace(has_perm=lambda name: True))
+
+    def make_admin(self, action):
+        return type("BandAdmin", (admin.ModelAdmin,), {"actions": [action]})(Band, admin.AdminSite())
+
+    def test_generator_locations_are_repeatable(self):
+        locations = (x for x in (admin.ActionLocation.CHANGE_FORM, admin.ActionLocation.CHANGE_LIST))
+        @admin.action(location=locations)
+        def chosen(modeladmin, request, queryset):
+            pass
+        instance = self.make_admin(chosen)
+        for _ in range(3):
+            for location in (admin.ActionLocation.CHANGE_FORM, admin.ActionLocation.CHANGE_LIST):
+                self.assertIn("chosen", instance.get_actions(self.request(), action_location=location))
+
+    def test_caller_mutation_does_not_change_actions(self):
+        locations = [admin.ActionLocation.CHANGE_FORM]
+        @admin.action(location=locations)
+        def chosen(modeladmin, request, queryset):
+            pass
+        locations.clear()
+        instance = self.make_admin(chosen)
+        self.assertIn("chosen", instance.get_actions(self.request(), action_location=admin.ActionLocation.CHANGE_FORM))
+        self.assertNotIn("chosen", instance.get_actions(self.request(), action_location=admin.ActionLocation.CHANGE_LIST))
+
+    def test_invalid_locations_rejected_early(self):
+        for locations in (None, "CHANGE_FORM", [object()], [admin.ActionLocation.CHANGE_FORM, 7]):
+            with self.assertRaises(TypeError):
+                admin.action(location=locations)(lambda modeladmin, request, queryset: None)
+
+    def test_default_location_remains_change_list(self):
+        @admin.action
+        def chosen(modeladmin, request, queryset):
+            pass
+        instance = self.make_admin(chosen)
+        self.assertIn("chosen", instance.get_actions(self.request()))
+        self.assertNotIn("chosen", instance.get_actions(self.request(), action_location=admin.ActionLocation.CHANGE_FORM))
+
+    def test_kwargs_override_preserves_form_choices(self):
+        @admin.action(location=admin.ActionLocation.CHANGE_FORM)
+        def chosen(modeladmin, request, queryset):
+            pass
+        class GenericAdmin(admin.ModelAdmin):
+            actions = [chosen]
+            def get_actions(self, request, **kwargs):
+                return super().get_actions(request, **kwargs)
+        instance = GenericAdmin(Band, admin.AdminSite())
+        with warnings.catch_warnings(record=True) as seen:
+            warnings.simplefilter("always")
+            choices = instance.get_action_choices(self.request(), action_location=admin.ActionLocation.CHANGE_FORM)
+        self.assertIn("chosen", [value for value, label in choices])

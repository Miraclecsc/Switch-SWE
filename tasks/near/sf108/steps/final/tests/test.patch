@@ -0,0 +1,58 @@
+import asyncio
+import inspect
+from functools import partial
+from django.core.cache.backends.base import BaseCache
+from django.test import SimpleTestCase
+
+
+SPECS = [
+    ("get_many", "aget_many", (["key"],), {"version": 3}, {"key": 9}),
+    ("set_many", "aset_many", ({"key": 9},), {"timeout": 4, "version": 3}, []),
+    ("delete_many", "adelete_many", (["key"],), {"version": 3}, None),
+    ("get_or_set", "aget_or_set", ("key", 9), {"timeout": 4, "version": 3}, 9),
+    ("has_key", "ahas_key", ("key",), {"version": 3}, True),
+    ("incr", "aincr", ("key",), {"delta": 2, "version": 3}, 11),
+    ("incr_version", "aincr_version", ("key",), {"delta": 2, "version": 3}, 5),
+    ("close", "aclose", (), {"reason": "done"}, None),
+]
+
+
+class CallableBackendTests(SimpleTestCase):
+    async def exercise(self, kind):
+        for sync_name, async_name, args, kwargs, expected in SPECS:
+            cache = BaseCache({})
+            calls = []
+            def plain(*actual_args, **actual_kwargs):
+                calls.append((actual_args, actual_kwargs))
+                return expected
+            async def native(*actual_args, **actual_kwargs):
+                await asyncio.sleep(0)
+                return plain(*actual_args, **actual_kwargs)
+            class AsyncCallable:
+                async def __call__(self, *a, **kw):
+                    return await native(*a, **kw)
+            def deferred(*a, **kw):
+                return native(*a, **kw)
+            override = {"partial": partial(plain), "native": native, "async_object": AsyncCallable(), "deferred": deferred}[kind]
+            setattr(cache, sync_name, override)
+            try:
+                actual = await getattr(cache, async_name)(*args, **kwargs)
+            except Exception as exc:
+                self.fail("%s/%s dispatch raised: %r" % (kind, async_name, exc))
+            if inspect.iscoroutine(actual):
+                actual.close()
+                self.fail("%s leaked an unawaited coroutine" % async_name)
+            self.assertEqual(actual, expected)
+            self.assertEqual(calls, [(args, kwargs)])
+
+    async def test_partial_callable_overrides(self):
+        await self.exercise("partial")
+
+    async def test_native_async_overrides(self):
+        await self.exercise("native")
+
+    async def test_async_callable_objects(self):
+        await self.exercise("async_object")
+
+    async def test_sync_returning_awaitable(self):
+        await self.exercise("deferred")

@@ -0,0 +1,47 @@
+import pytest
+from textual.app import App
+from textual.widgets import TextArea
+from textual.document._document import Selection
+
+class Demo(App):
+    def compose(self):yield TextArea()
+
+@pytest.mark.parametrize("key",["ctrl+u","ctrl+k"])
+@pytest.mark.parametrize("reverse",[False,True])
+async def test_selection_priority_undo_redo(key,reverse):
+    app=Demo()
+    async with app.run_test() as pilot:
+        area=app.query_one(TextArea);area.selection_deletion=True;text="one\nTWO\nthree";area.load_text(text)
+        points=((0,1),(2,2))
+        selected=Selection(*reversed(points)) if reverse else Selection(*points)
+        area.selection=selected
+        await pilot.press(key)
+        assert area.text=="oree" and area.selection==Selection.cursor((0,1))
+        await pilot.press("ctrl+z")
+        assert area.text==text and area.selection==selected
+        await pilot.press("ctrl+y")
+        assert area.text=="oree"
+
+@pytest.mark.parametrize("text,expected",[
+    ("...word rest","word rest"),
+    ("  ::name tail","name tail"),
+    ("变量_name...next","...next"),
+    ("   ",""),
+])
+async def test_word_and_punctuation_runs(text,expected):
+    app=Demo()
+    async with app.run_test() as pilot:
+        area=app.query_one(TextArea);area.load_text(text);area.selection=Selection.cursor((0,0))
+        await pilot.press("alt+delete")
+        assert area.text==expected
+        await pilot.press("ctrl+z")
+        assert area.text==text
+
+@pytest.mark.parametrize("key",["ctrl+u","ctrl+k","alt+delete"])
+async def test_readonly_selection_unchanged(key):
+    app=Demo()
+    async with app.run_test() as pilot:
+        area=app.query_one(TextArea);area.load_text("alpha\nbeta")
+        selection=Selection((0,2),(1,2));area.selection=selection;area.read_only=True
+        await pilot.press(key)
+        assert area.text=="alpha\nbeta" and area.selection==selection

diff --git a/tests/test_sf192_staged.py b/tests/test_sf192_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf192_staged.py
@@ -0,0 +1,40 @@
+
+import warnings
+import attr
+
+class EmptyLookupKey:
+    def __len__(self):
+        return 0
+    def __call__(self, value):
+        return value.lower()
+
+def test_falsey_cmp_key_controls_equality_without_warnings():
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter('always')
+        @attr.s
+        class Example:
+            value = attr.ib(cmp=EmptyLookupKey())
+        assert Example('A') == Example('a')
+        assert not (Example('A') != Example('a'))
+    assert not [w for w in caught if issubclass(w.category, DeprecationWarning)]
+    assert Example('x').__eq__(object()) is NotImplemented
+
+def test_falsey_keys_control_all_ordering_operators():
+    @attr.s
+    class Example:
+        value = attr.ib(cmp=EmptyLookupKey())
+    a, b = Example('a'), Example('B')
+    assert a < b and a <= b and b > a and b >= a
+    assert Example('b') <= b and Example('b') >= b
+
+def test_comparison_never_calls_key_truth_value():
+    class Key:
+        def __bool__(self):
+            raise AssertionError('callable truth-value queried')
+        def __call__(self, value):
+            return len(value)
+    @attr.s
+    class Example:
+        value = attr.ib(eq=Key(), order=Key())
+    assert Example('aa') == Example('bb')
+    assert Example('a') < Example('cc')

@@ -373,12 +380,35 @@ def attributes(maybe_cls=None, these=None, repr_ns=None,
                 # It might not actually be in there, e.g. if using 'these'.
                 cls_dict.pop(ca_name, None)
             cls_dict.pop("__dict__", None)
+            old_cls = cls
 
             qualname = getattr(cls, "__qualname__", None)
             cls = type(cls)(cls.__name__, cls.__bases__, cls_dict)
             if qualname is not None:
                 cls.__qualname__ = qualname
 
+            # The following is a fix for
+            # https://github.com/python-attrs/attrs/issues/102.  On Python 3,
+            # if a method mentions `__class__` or uses the no-arg super(), the
+            # compiler will bake a reference to the class in the method itself
+            # as `method.__closure__`.  Since we replace the class with a
+            # clone, we rewrite these references so it keeps working.
+            for item in cls.__dict__.values():
+                if isinstance(item, (classmethod, staticmethod)):
+                    functions = (item.__func__,)
+                elif isinstance(item, property):
+                    functions = (item.fget, item.fset, item.fdel)
+                else:
+                    functions = (item,)
+                for function in functions:
+                    for cell in getattr(function, "__closure__", None) or ():
+                        try:
+                            matches = cell.cell_contents is old_cls
+                        except ValueError:
+                            continue
+                        if matches:
+                            set_closure_cell(cell, cls)
+
         return cls
 

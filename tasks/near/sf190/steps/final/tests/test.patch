diff --git a/tests/test_sf190_staged.py b/tests/test_sf190_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf190_staged.py
@@ -0,0 +1,51 @@
+
+import attr
+
+def test_classmethod_and_staticmethod_class_cells():
+    class Parent(object):
+        @classmethod
+        def identify(cls):
+            return cls
+    @attr.s(slots=True)
+    class Child(Parent):
+        @classmethod
+        def identify(cls):
+            return super().identify()
+        @staticmethod
+        def owner():
+            return __class__
+    assert Child.identify() is Child
+    assert Child.owner() is Child
+
+def test_property_accessors_rebind_class():
+    @attr.s(slots=True)
+    class Child(object):
+        stored = attr.ib(default=None)
+        @property
+        def owner(self):
+            return __class__
+        @owner.setter
+        def owner(self, value):
+            self.stored = (__class__, value)
+        @owner.deleter
+        def owner(self):
+            self.stored = (__class__, 'deleted')
+    instance = Child()
+    assert instance.owner is Child
+    instance.owner = 3
+    assert instance.stored == (Child,3)
+    del instance.owner
+    assert instance.stored == (Child,'deleted')
+
+def test_empty_and_unrelated_closure_cells_are_preserved():
+    token = object()
+    removed = object()
+    def empty(self):
+        return removed
+    del removed
+    class Child(object):
+        empty_cell = empty
+        def capture(self):
+            return token, __class__
+    Child = attr.s(slots=True)(Child)
+    assert Child().capture() == (token,Child)

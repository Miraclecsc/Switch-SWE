@@ -0,0 +1,24 @@
+import networkx as nx
+import pytest
+from networkx.algorithms.isomorphism import rooted_tree_isomorphism
+
+def test_directed_wrong_root_rejected():
+    good = nx.DiGraph([(0, 1), (1, 2)])
+    for first, r1, second, r2 in [(good, 1, good, 0), (good, 0, good, 1)]:
+        with pytest.raises(nx.NetworkXError):
+            rooted_tree_isomorphism(first, r1, second, r2)
+
+def test_mixed_orientation_rejected_without_mutation():
+    invalid = nx.DiGraph([(0, 1), (2, 1), (2, 3)])
+    good = nx.path_graph(4, create_using=nx.DiGraph)
+    before = list(invalid.edges())
+    for first, second in [(invalid, good), (good, invalid)]:
+        with pytest.raises(nx.NetworkXError):
+            rooted_tree_isomorphism(first, 0, second, 0)
+    assert list(invalid.edges()) == before
+
+def test_valid_deep_directed_mapping_is_complete():
+    a = nx.path_graph(1200, create_using=nx.DiGraph)
+    b = nx.relabel_nodes(a, lambda n: ("node", n))
+    result = dict(rooted_tree_isomorphism(a, 0, b, ("node", 0)))
+    assert result == {n: ("node", n) for n in a}

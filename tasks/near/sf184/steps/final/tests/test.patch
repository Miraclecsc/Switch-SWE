diff --git a/tests/test_sf184_staged.py b/tests/test_sf184_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf184_staged.py
@@ -0,0 +1,26 @@
+
+from packaging.requirements import Requirement
+
+def test_semantic_name_specifier_hash_and_lookup():
+    a = Requirement('My_Pkg>=1.0')
+    b = Requirement('my-pkg>=1.0.0')
+    assert a == b and hash(a) == hash(b)
+    assert {a:'found'}[b] == 'found'
+    assert a.name == 'My_Pkg'
+    class Derived(Requirement):
+        pass
+    assert Derived('my-pkg>=1') == b
+    assert hash(Derived('my-pkg>=1')) == hash(b)
+
+def test_normalized_extras_are_semantic_sets():
+    a = Requirement('demo[Fast_IO,fast.io,TLS]>=1')
+    b = Requirement('demo[fast-io,tls]>=1.0')
+    assert a == b and hash(a) == hash(b)
+    assert len({a,b}) == 1
+    assert a.extras == {'Fast_IO','fast.io','TLS'}
+    assert a != Requirement('demo[fast-io]>=1')
+
+def test_distinct_urls_markers_and_foreign_operands():
+    assert Requirement('demo @ https://example.invalid/a') != Requirement('demo @ https://example.invalid/b')
+    assert Requirement('demo; os_name == "a"') != Requirement('demo; os_name == "b"')
+    assert Requirement('demo').__eq__(object()) is NotImplemented

diff --git a/tests/test_sf182_staged.py b/tests/test_sf182_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf182_staged.py
@@ -0,0 +1,27 @@
+
+from packaging.specifiers import Specifier, SpecifierSet
+
+def test_colliding_hashes_do_not_define_equality():
+    class Collision(Specifier):
+        def __hash__(self):
+            return 7
+    a, b = Collision('>=1'), Collision('>=2')
+    assert hash(a) == hash(b)
+    assert not (a == b)
+    assert len({a, b}) == 2
+
+def test_normalized_inequality_complements_equality():
+    a, b = Specifier('==1.0'), Specifier('==1.0.0')
+    assert a == b and not (a != b)
+    assert a == '==1.0.0' and not (a != '==1.0.0')
+    assert hash(a) == hash(b)
+    assert a.__eq__(object()) is NotImplemented
+
+def test_compatible_release_precision_kept_in_keys():
+    broad, narrow = Specifier('~=1.0'), Specifier('~=1.0.0')
+    assert broad.contains('1.5') and not narrow.contains('1.5')
+    assert broad != narrow and not (broad == narrow)
+    assert len({broad, narrow}) == 2
+    combined = SpecifierSet('~=1.0,~=1.0.0')
+    assert len(combined) == 2
+    assert combined.contains('1.0.5') and not combined.contains('1.5')

diff --git a/tests/test_staged_contract.py b/tests/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_staged_contract.py
@@ -0,0 +1,62 @@
+import asyncio
+import pytest
+from anyio._backends._asyncio import TestRunner as Runner
+
+def test_restore_handler_success():
+    runner = Runner(use_uvloop=False)
+    handler = lambda loop, context: None
+    runner._loop.set_exception_handler(handler)
+    async def call():
+        return 17
+    try:
+        assert runner.call(call) == 17
+        assert runner._loop.get_exception_handler() is handler
+    finally:
+        runner.close()
+
+def test_delegate_message_context():
+    runner = Runner(use_uvloop=False)
+    seen = []
+    handler = lambda loop, context: seen.append(context)
+    runner._loop.set_exception_handler(handler)
+    context = {'message': 'diagnostic without exception', 'detail': object()}
+    async def call():
+        asyncio.get_running_loop().call_exception_handler(context)
+        return 3
+    try:
+        assert runner.call(call) == 3
+        assert seen == [context]
+        assert seen[0] is context
+    finally:
+        runner.close()
+
+def test_delegate_default_handler():
+    runner = Runner(use_uvloop=False)
+    seen = []
+    runner._loop.default_exception_handler = seen.append
+    context = {'message': 'diagnostic'}
+    async def call():
+        asyncio.get_running_loop().call_exception_handler(context)
+    try:
+        runner.call(call)
+        assert seen == [context]
+    finally:
+        runner.close()
+
+def test_restore_sync_failure_and_reuse():
+    runner = Runner(use_uvloop=False)
+    handler = lambda loop, context: None
+    runner._loop.set_exception_handler(handler)
+    error = ValueError('sync')
+    def fail():
+        raise error
+    async def ok():
+        return 'fresh'
+    try:
+        with pytest.raises(ValueError) as caught:
+            runner.call(fail)
+        assert caught.value is error
+        assert runner._loop.get_exception_handler() is handler
+        assert runner.call(ok) == 'fresh'
+    finally:
+        runner.close()

+import pandas as pd
+import pandas._testing as tm
+import pytest
+
+def test_distinct_labels_colliding_after_cleaning():
+    df=pd.DataFrame([[1,90]],columns=["a b","BACKTICK_QUOTED_STRING_a_b"])
+    before=df.copy(deep=True)
+    with pytest.raises(ValueError,match="[Aa]mbiguous"):
+        df.eval("`a b` + 1",engine="python")
+    tm.assert_frame_equal(df,before)
+
+@pytest.mark.parametrize("quoted",[False,True])
+def test_duplicate_group_arithmetic_preserves_metadata(quoted):
+    label="a b" if quoted else "a"
+    df=pd.DataFrame([[1,10,5],[2,20,6]],columns=[label,label,"b"],
+                    index=pd.Index(["x","y"],name="row"))
+    before=df.copy(deep=True)
+    got=df.eval(("`a b`" if quoted else "a")+" + 1",engine="python")
+    tm.assert_frame_equal(got,df[label]+1)
+    tm.assert_frame_equal(df,before)
+
+def test_failed_multiline_duplicate_assignment_rolls_back():
+    df=pd.DataFrame([[1,10,100],[2,20,200]],columns=["a","a","b"])
+    before=df.copy(deep=True)
+    with pytest.raises(pd.errors.UndefinedVariableError):
+        df.eval("a = a + 1\nb = does_not_exist + 1",inplace=True,engine="python")
+    tm.assert_frame_equal(df,before)
+
+def test_successful_multiline_transaction_and_expression_error():
+    df=pd.DataFrame([[1,10,100],[2,20,200]],columns=["a","a","b"],
+                    index=pd.Index(["x","y"],name="row"))
+    expected=df.copy(deep=True);expected["a"]=expected["a"]+1
+    expected["b"]=expected["b"]+3
+    assert df.eval("a = a + 1\nb = b + 1\nb = b + 2",inplace=True,engine="python") is None
+    tm.assert_frame_equal(df,expected)
+    with pytest.raises(ValueError):df.eval("b + 1",inplace=True,engine="python")
+    tm.assert_frame_equal(df,expected)

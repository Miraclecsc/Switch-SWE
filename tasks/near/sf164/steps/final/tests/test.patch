+++ b/tests/test_staged_contract.py
@@ -0,0 +1,178 @@
+import anyio
+import pytest
+
+from starlette.background import BackgroundTask
+from starlette.middleware.base import BaseHTTPMiddleware, _StreamingResponse
+from starlette.responses import Response
+
+
+SCOPE = {"type": "http", "method": "GET", "path": "/", "headers": []}
+
+
+async def no_receive():
+    raise AssertionError("Response streaming must not poll receive")
+
+
+class Body:
+    def __init__(self, events, error=None, close_error=None):
+        self.events = events
+        self.error = error
+        self.close_error = close_error
+        self.iterated = False
+
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        if not self.iterated:
+            self.iterated = True
+            return b"first"
+        if self.error:
+            raise self.error
+        raise StopAsyncIteration
+
+    async def aclose(self):
+        await anyio.sleep(0)
+        self.events.append("closed")
+        if self.close_error:
+            raise self.close_error
+
+
+def run_backends(scenario):
+    for backend in ("asyncio",):
+        anyio.run(scenario, backend=backend)
+
+
+def test_middleware_can_attach_background_to_call_next_response():
+    async def scenario():
+        events = []
+        async def downstream(scope, receive, send):
+            await Response(b"ok")(scope, receive, send)
+        async def dispatch(request, call_next):
+            response = await call_next(request)
+            assert response.background is None
+            response.background = BackgroundTask(events.append, "background")
+            return response
+        async def send(message):
+            if message["type"] == "http.response.body" and not message.get("more_body"):
+                events.append("terminal")
+        await BaseHTTPMiddleware(downstream, dispatch)(SCOPE, no_receive, send)
+        assert events == ["terminal", "background"]
+    run_backends(scenario)
+
+
+def test_success_closes_body_before_background():
+    async def scenario():
+        events = []
+        response = _StreamingResponse(Body(events), info={})
+        response.background = BackgroundTask(events.append, "background")
+        messages = []
+        async def send(message):
+            messages.append(message)
+        await response(SCOPE, no_receive, send)
+        assert events == ["closed", "background"]
+        assert [m["type"] for m in messages] == [
+            "http.response.debug", "http.response.start", "http.response.body", "http.response.body"]
+        assert messages[-1] == {"type": "http.response.body", "body": b"", "more_body": False}
+    run_backends(scenario)
+
+
+def test_send_failure_closes_body_and_emits_no_terminal_body():
+    async def scenario():
+        events = []
+        error = OSError("client gone")
+        response = _StreamingResponse(Body(events))
+        messages = []
+        async def send(message):
+            messages.append(message)
+            if message["type"] == "http.response.body":
+                raise error
+        with pytest.raises(OSError) as caught:
+            await response(SCOPE, no_receive, send)
+        assert caught.value is error
+        assert events == ["closed"]
+        assert not any(m.get("more_body") is False for m in messages)
+    run_backends(scenario)
+
+
+def test_send_failure_still_runs_attached_background_once():
+    async def scenario():
+        events = []
+        response = _StreamingResponse(Body(events))
+        response.background = BackgroundTask(events.append, "background")
+        async def send(message):
+            raise OSError("closed before start")
+        with pytest.raises(OSError):
+            await response(SCOPE, no_receive, send)
+        assert events == ["closed", "background"]
+    run_backends(scenario)
+
+
+def test_cancelled_send_waits_for_shielded_cleanup():
+    async def scenario():
+        events = []
+        entered = anyio.Event()
+        response = _StreamingResponse(Body(events))
+        async def background():
+            await anyio.sleep(0)
+            events.append("background")
+        response.background = background
+        async def send(message):
+            if message["type"] == "http.response.body":
+                entered.set()
+                await anyio.sleep_forever()
+        async with anyio.create_task_group() as tasks:
+            tasks.start_soon(response, SCOPE, no_receive, send)
+            await entered.wait()
+            tasks.cancel_scope.cancel()
+        assert events == ["closed", "background"]
+    run_backends(scenario)
+
+
+def test_original_stream_error_survives_failing_cleanup():
+    async def scenario():
+        events = []
+        original = ValueError("body failed")
+        response = _StreamingResponse(Body(events, original, RuntimeError("close failed")))
+        async def background():
+            events.append("background")
+            raise LookupError("background failed")
+        response.background = background
+        async def send(message):
+            pass
+        with pytest.raises(ValueError) as caught:
+            await response(SCOPE, no_receive, send)
+        assert caught.value is original
+        assert events == ["closed", "background"]
+    run_backends(scenario)
+
+
+def test_successful_stream_surfaces_cleanup_failure_and_runs_background():
+    async def scenario():
+        events = []
+        close_error = RuntimeError("close failed")
+        response = _StreamingResponse(Body(events, close_error=close_error))
+        response.background = BackgroundTask(events.append, "background")
+        async def send(message):
+            pass
+        with pytest.raises(RuntimeError) as caught:
+            await response(SCOPE, no_receive, send)
+        assert caught.value is close_error
+        assert events == ["closed", "background"]
+    run_backends(scenario)
+
+
+def test_async_iterable_without_aclose_remains_supported():
+    async def scenario():
+        class Chunks:
+            def __aiter__(self):
+                async def generate():
+                    yield b"data"
+                return generate()
+        response = _StreamingResponse(Chunks())
+        messages = []
+        async def send(message):
+            messages.append(message)
+        await response(SCOPE, no_receive, send)
+        assert [m["body"] for m in messages if m["type"] == "http.response.body"] == [b"data", b""]
+    run_backends(scenario)

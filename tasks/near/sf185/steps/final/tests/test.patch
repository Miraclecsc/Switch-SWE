diff --git a/tests/test_sf185_staged.py b/tests/test_sf185_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf185_staged.py
@@ -0,0 +1,24 @@
+
+import pytest
+from packaging import tags
+
+def test_empty_extension_configuration(monkeypatch):
+    for suffix in ('', '.', None, 7):
+        monkeypatch.setattr(tags.sysconfig, 'get_config_var', lambda name, value=suffix: value)
+        with pytest.raises(SystemError, match='EXT_SUFFIX'):
+            tags._generic_abi()
+
+def test_incomplete_recognized_abi_tokens(monkeypatch):
+    for suffix in ('.cpython.so', '.cpython-.so', '.pypy39.so', '.pypy39-.so', '.graalpy-38.so', '.graalpy--native.so'):
+        monkeypatch.setattr(tags.sysconfig, 'get_config_var', lambda name, value=suffix: value)
+        with pytest.raises(SystemError, match='EXT_SUFFIX'):
+            tags._generic_abi()
+
+def test_valid_platform_tails_and_explicit_abi_bypass(monkeypatch):
+    for suffix, expected in [('.cpython-310-x86_64-linux-gnu.so','cp310'), ('.pypy39-pp73-x86_64-linux-gnu.so','pypy39_pp73'), ('.graalpy-38-native-x86_64-darwin.dylib','graalpy_38_native'), ('.custom-abi.so','custom_abi')]:
+        monkeypatch.setattr(tags.sysconfig, 'get_config_var', lambda name, value=suffix: value)
+        assert tags._generic_abi() == [expected]
+    def forbidden(*args):
+        raise AssertionError('explicit ABI must bypass discovery')
+    monkeypatch.setattr(tags, '_generic_abi', forbidden)
+    assert list(tags.generic_tags('custom', abis=['abi'], platforms=['target'])) == [tags.Tag('custom','abi','target'), tags.Tag('custom','none','target')]

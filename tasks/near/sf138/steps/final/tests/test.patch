diff --git a/pandas/tests/arrays/string_/test_sf138_sort_key.py b/pandas/tests/arrays/string_/test_sf138_sort_key.py
new file mode 100644
--- /dev/null
+++ b/pandas/tests/arrays/string_/test_sf138_sort_key.py
@@ -0,0 +1,37 @@
+import numpy as np
+import pandas as pd
+import pandas._testing as tm
+import pytest
+
+@pytest.mark.parametrize("storage",["python","pyarrow"])
+@pytest.mark.parametrize("ascending",[True,False])
+def test_numeric_keys_and_stable_ties(storage,ascending):
+    a=pd.array(["bb","a","cc","d"],dtype=pd.StringDtype(storage=storage))
+    calls=[]
+    def key(copy):
+        calls.append(copy)
+        assert copy is not a
+        return np.array([2,1,2,1])
+    assert a.sort(key=key,ascending=ascending,kind="stable") is None
+    want=["a","d","bb","cc"] if ascending else ["bb","cc","a","d"]
+    tm.assert_extension_array_equal(a,pd.array(want,dtype=a.dtype))
+    assert len(calls)==1
+
+@pytest.mark.parametrize("storage",["python","pyarrow"])
+def test_missing_keys_and_empty(storage):
+    a=pd.array(["b",None,"a"],dtype=pd.StringDtype(storage=storage))
+    a.sort(key=lambda x:np.array([2,np.nan,1]),na_position="first")
+    tm.assert_extension_array_equal(a,pd.array([None,"a","b"],dtype=a.dtype))
+    empty=pd.array([],dtype=a.dtype);empty.sort(key=lambda x:[])
+    assert len(empty)==0
+
+@pytest.mark.parametrize("storage",["python","pyarrow"])
+@pytest.mark.parametrize("bad",["length","dimension","raise"])
+def test_failure_and_copy_are_atomic(storage,bad):
+    a=pd.array(["z","a"],dtype=pd.StringDtype(storage=storage));before=a.copy()
+    def key(copy):
+        copy[0]="changed"
+        if bad=="raise": raise RuntimeError("key failed")
+        return [1] if bad=="length" else [[1,2]]
+    with pytest.raises(RuntimeError if bad=="raise" else ValueError): a.sort(key=key)
+    tm.assert_extension_array_equal(a,before)

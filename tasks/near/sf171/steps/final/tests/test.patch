diff --git a/tests/test_sf171_staged.py b/tests/test_sf171_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf171_staged.py
@@ -0,0 +1,28 @@
+import networkx as nx
+import pytest
+
+def test_report_cycle_period():
+    for n in (2, 3, 7):
+        g = nx.cycle_graph(n, create_using=nx.DiGraph)
+        assert nx.is_aperiodic(g, return_period=True) == n
+        assert nx.is_aperiodic(g) is False
+
+def test_period_overlapping_cycles_and_parallel_edges():
+    g = nx.MultiDiGraph()
+    nx.add_cycle(g, [0, 1, 2, 3])
+    nx.add_cycle(g, [0, 4, 5, 6, 7, 8])
+    g.add_edge(0, 1)
+    assert nx.is_aperiodic(g, return_period=True) == 2
+    g.add_edge(0, 0)
+    assert nx.is_aperiodic(g, return_period=True) == 1
+    assert nx.is_aperiodic(g) is True
+
+def test_period_degenerate_and_disconnected():
+    g = nx.DiGraph()
+    g.add_node("single")
+    assert nx.is_aperiodic(g, return_period=True) == 0
+    g.add_edge("single", "single")
+    assert nx.is_aperiodic(g, return_period=True) == 1
+    g.add_node("other")
+    with pytest.raises(nx.NetworkXError):
+        nx.is_aperiodic(g, return_period=True)

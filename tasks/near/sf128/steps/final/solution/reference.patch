+@t.overload
+def add_completion_class(
+    cls: None = None, name: t.Optional[str] = None, *,
+    aliases: t.Iterable[str] = (), replace: bool = True,
+) -> t.Callable[[ShellCompleteType], ShellCompleteType]: ...
+
+
+def add_completion_class(
+    cls: t.Optional[ShellCompleteType] = None, name: t.Optional[str] = None, *,
+    aliases: t.Iterable[str] = (), replace: bool = True,
+) -> t.Union[ShellCompleteType, t.Callable[[ShellCompleteType], ShellCompleteType]]:
+    """Register a shell completion class directly or as a decorator factory.
+
+    ``aliases`` registers additional lookup names atomically. ``replace=False``
+    refuses to replace a different class; re-registering the same class is safe.
+    The class itself, including its name attribute, is never modified.
+    """
+    if isinstance(aliases, (str, bytes)):
+        raise TypeError("aliases must be an iterable of names, not a string")
+    alias_names = tuple(aliases)
+
+    def register(value: ShellCompleteType) -> ShellCompleteType:
+        if not isinstance(value, type) or not issubclass(value, ShellComplete):
+            raise TypeError("completion class must subclass ShellComplete")
+        names = (value.name if name is None else name, *alias_names)
+        for key in names:
+            if not isinstance(key, str):
+                raise TypeError("completion names must be strings")
+            if not key:
+                raise ValueError("completion names must not be empty")
+            if not replace and key in _available_shells and _available_shells[key] is not value:
+                raise ValueError(f"completion name {key!r} is already registered")
+        for key in names:
+            _available_shells[key] = value
+        return value
+
+    return register if cls is None else register(cls)
 
 

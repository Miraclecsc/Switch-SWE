@@ -0,0 +1,63 @@
+import pytest
+import click.shell_completion as sc
+
+@pytest.fixture(autouse=True)
+def registry():
+    before=sc._available_shells.copy()
+    yield
+    sc._available_shells.clear();sc._available_shells.update(before)
+
+class One(sc.ShellComplete):
+    name="sf128-one"
+class Two(sc.ShellComplete):
+    name="sf128-two"
+
+def test_named_decorator():
+    decorated=sc.add_completion_class(name="sf128-named")(One)
+    assert decorated is One and One.name=="sf128-one"
+    assert sc.get_completion_class("sf128-named") is One
+    assert sc.get_completion_class("sf128-one") is None
+
+def test_aliases_and_identity():
+    assert sc.add_completion_class(One, aliases=(x for x in ["sf128-a","sf128-b"])) is One
+    for key in [One.name,"sf128-a","sf128-b"]:assert sc.get_completion_class(key) is One
+    assert sc.add_completion_class(One,aliases=["sf128-a"],replace=False) is One
+
+def test_collision_rolls_back_every_name():
+    sc.add_completion_class(Two,name="sf128-used")
+    with pytest.raises(ValueError):sc.add_completion_class(One,aliases=["sf128-fresh","sf128-used"],replace=False)
+    assert sc.get_completion_class(One.name) is None
+    assert sc.get_completion_class("sf128-fresh") is None
+    assert sc.get_completion_class("sf128-used") is Two
+
+def test_default_replacement():
+    sc.add_completion_class(Two,name="sf128-used")
+    assert sc.add_completion_class(One,aliases=["sf128-used"]) is One
+    assert sc.get_completion_class("sf128-used") is One
+
+@pytest.mark.parametrize("bad,exc", [("",ValueError),(5,TypeError)])
+def test_invalid_alias_is_atomic(bad,exc):
+    sc.add_completion_class(Two,name=One.name)
+    with pytest.raises(exc):sc.add_completion_class(One,aliases=["sf128-good",bad])
+    assert sc.get_completion_class(One.name) is Two
+    assert sc.get_completion_class("sf128-good") is None
+
+def test_iterator_failure_is_atomic():
+    def aliases():
+        yield "sf128-good"
+        raise RuntimeError("alias discovery failed")
+    with pytest.raises(RuntimeError):sc.add_completion_class(One,aliases=aliases())
+    assert sc.get_completion_class(One.name) is None
+    assert sc.get_completion_class("sf128-good") is None
+
+@pytest.mark.parametrize("bad", [object,42,One(None,{},"x","x")])
+def test_invalid_class(bad):
+    with pytest.raises(TypeError):sc.add_completion_class(bad)
+
+@pytest.mark.parametrize("bad", ["sf128-alias", b"sf128-alias"])
+def test_alias_string_rejected(bad):
+    with pytest.raises(TypeError):sc.add_completion_class(One,aliases=bad)
+
+def test_legacy_bare_decorator_and_return():
+    assert sc.add_completion_class(One) is One
+    assert sc.get_completion_class(One.name) is One

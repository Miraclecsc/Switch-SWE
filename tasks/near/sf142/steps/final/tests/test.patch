diff --git a/tests/test_sf142_dimensions.py b/tests/test_sf142_dimensions.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf142_dimensions.py
@@ -0,0 +1,47 @@
+import io
+import os
+import pytest
+import rich.console as mod
+from rich.console import Console
+
+class Output(io.StringIO):
+    def fileno(self): return 99
+
+def setup(monkeypatch,sizes):
+    calls=[]
+    monkeypatch.setattr(mod,"WINDOWS",False)
+    monkeypatch.setattr(mod,"_STD_STREAMS",(10,11,12))
+    def probe(fd):
+        calls.append(fd)
+        value=sizes.get(fd)
+        if value is None: raise OSError("not a terminal")
+        return os.terminal_size(value)
+    monkeypatch.setattr(mod.os,"get_terminal_size",probe)
+    return calls
+
+def test_output_preferred_and_resize(monkeypatch):
+    sizes={99:(100,40),10:(80,20)};calls=setup(monkeypatch,sizes)
+    c=Console(file=Output(),_environ={"TERM":"xterm"})
+    assert c.size==(100,40) and calls==[99]
+    sizes[99]=(120,50)
+    assert c.size==(120,50)
+
+def test_partial_dimensions_and_duplicate_descriptors(monkeypatch):
+    calls=setup(monkeypatch,{99:(0,40),10:(-1,50),11:(120,60)})
+    monkeypatch.setattr(mod,"_STD_STREAMS",(99,10,11,12))
+    c=Console(file=Output(),_environ={"TERM":"xterm"})
+    assert c.size==(120,40) and calls==[99,10,11]
+
+@pytest.mark.parametrize("invalid",["0","-5","bad"])
+def test_env_validation_and_explicit_precedence(monkeypatch,invalid):
+    setup(monkeypatch,{99:(100,40)})
+    c=Console(file=Output(),width=70,_environ={"TERM":"xterm","COLUMNS":"150","LINES":invalid})
+    assert c.size==(70,40)
+    c=Console(file=Output(),height=30,_environ={"TERM":"xterm","COLUMNS":invalid,"LINES":"60"})
+    assert c.size==(100,30)
+
+def test_closed_output_and_dimension_default(monkeypatch):
+    setup(monkeypatch,{10:(0,35),11:(0,0)})
+    out=io.StringIO();out.close()
+    c=Console(file=out,_environ={"TERM":"xterm"})
+    assert c.size==(80,35)

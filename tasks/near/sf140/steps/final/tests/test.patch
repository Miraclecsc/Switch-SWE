diff --git a/pandas/tests/arrays/test_sf140_public_keepdims.py b/pandas/tests/arrays/test_sf140_public_keepdims.py
new file mode 100644
--- /dev/null
+++ b/pandas/tests/arrays/test_sf140_public_keepdims.py
@@ -0,0 +1,88 @@
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+
+def _run_arrow_case(request):
+    if os.environ.get("SSB_ARROW_CHILD") == "1":
+        return False
+    extra = os.environ["SSB_ARROW_TEST_PYTHONPATH"]
+    assert Path(extra, "pyarrow").is_dir(), "Optional Arrow dependency was not staged"
+    env = dict(os.environ)
+    env["SSB_ARROW_CHILD"] = "1"
+    env.pop("PYTEST_CURRENT_TEST", None)
+    env["PYTHONPATH"] = env.get("PYTHONPATH", "") + os.pathsep + extra
+    root = Path(__file__).resolve().parent
+    while not (root / "pyproject.toml").is_file():
+        assert root != root.parent
+        root = root.parent
+    with tempfile.TemporaryDirectory(prefix="sf140-arrow-") as directory:
+        report = Path(directory) / "result.xml"
+        result = subprocess.run(
+            [sys.executable, "-B", "-m", "pytest", "-q", request.node.nodeid,
+             "--junitxml=" + str(report)],
+            cwd=root, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+            text=True, timeout=90,
+        )
+        assert result.returncode == 0, result.stdout
+        cases = list(ET.parse(report).getroot().iter("testcase"))
+        assert len(cases) == 1, result.stdout
+        assert not any(cases[0].find(tag) is not None for tag in ("failure", "error", "skipped")), result.stdout
+    return True
+
+import numpy as np
+import pandas as pd
+import pandas._testing as tm
+import pytest
+from pandas.api.extensions import ExtensionArray
+
+@pytest.mark.parametrize("dtype",["Int64","Float64","int64[pyarrow]","float64[pyarrow]"])
+@pytest.mark.parametrize("method",["sum","prod","min","max","mean","median","std","var","sem"])
+def test_public_numeric_keepdims(dtype,method,request):
+    if "pyarrow" in dtype and _run_arrow_case(request):
+        return
+    a=pd.array([1,None,4],dtype=dtype);before=a.copy()
+    scalar=getattr(a,method)()
+    result=getattr(a,method)(keepdims=True)
+    assert isinstance(result,ExtensionArray) and result.shape==(1,)
+    assert result[0]==pytest.approx(scalar)
+    assert ("pyarrow" in str(result.dtype))==("pyarrow" in dtype)
+    if method in ["mean","median","std","var","sem"]:assert result.dtype.kind=="f"
+    tm.assert_extension_array_equal(a,before)
+    assert not isinstance(getattr(a,method)(keepdims=False),ExtensionArray)
+
+@pytest.mark.parametrize("dtype",["Int64","int64[pyarrow]"])
+def test_mask_min_count_skipna_and_ddof(dtype,request):
+    if "pyarrow" in dtype and _run_arrow_case(request):
+        return
+    a=pd.array([1,None,4],dtype=dtype)
+    for method in ["sum","prod"]:
+        result=getattr(a,method)(min_count=3,keepdims=True)
+        assert isinstance(result,ExtensionArray) and result.isna().tolist()==[True]
+    assert a.mean(skipna=False,keepdims=True).isna().tolist()==[True]
+    assert a.var(ddof=0,keepdims=True)[0]==pytest.approx(2.25)
+    assert a.sum(axis=None,keepdims=True)[0]==5
+    with pytest.raises((ValueError,IndexError)):a.sum(axis=1,keepdims=True)
+
+@pytest.mark.parametrize("storage",["python","pyarrow"])
+@pytest.mark.parametrize("method,expected",[("min","a"),("max","b"),("sum","ba")])
+def test_string_keepdims(storage,method,expected,request):
+    if storage == "pyarrow" and _run_arrow_case(request):
+        return
+    a=pd.array(["b",None,"a"],dtype=pd.StringDtype(storage=storage));before=a.copy()
+    result=getattr(a,method)(keepdims=True)
+    tm.assert_extension_array_equal(result,pd.array([expected],dtype=a.dtype))
+    missing=getattr(a,method)(skipna=False,keepdims=True)
+    assert missing.isna().tolist()==[True] and missing.dtype==a.dtype
+    tm.assert_extension_array_equal(a,before)
+
+@pytest.mark.parametrize("dtype",["Float64","float64[pyarrow]"])
+def test_all_missing_result_keeps_mask(dtype,request):
+    if "pyarrow" in dtype and _run_arrow_case(request):
+        return
+    a=pd.array([None,None],dtype=dtype)
+    result=a.mean(keepdims=True)
+    assert isinstance(result,ExtensionArray) and result.shape==(1,)
+    assert result.isna().tolist()==[True]

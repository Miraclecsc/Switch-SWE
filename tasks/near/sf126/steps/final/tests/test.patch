--- /dev/null
+++ b/sympy/assumptions/tests/test_sf126_joint_phase.py
@@ -0,0 +1,40 @@
+import pytest
+from sympy import Q, Symbol, cos, sin, pi, refine, simplify
+
+n, m, r, x = map(Symbol, ("n", "m", "r", "x"))
+
+@pytest.mark.parametrize("trig", [sin, cos])
+@pytest.mark.parametrize("phase", [n+m, n-m+r])
+@pytest.mark.parametrize("odd", [False, True])
+def test_joint_parity(trig, phase, odd):
+    expr = trig(x + phase.expand()*pi/2)
+    assumption = Q.odd(phase) if odd else Q.even(phase)
+    expected = ((-1)**((phase-1)/2)*cos(x) if trig == sin else
+                (-1)**((phase+1)/2)*sin(x)) if odd else (-1)**(phase/2)*trig(x)
+    result = refine(expr, assumption)
+    assert not any(atom.args[0].has(n,m,r) for atom in result.atoms(sin,cos))
+    assert simplify(result - expected) == 0
+    assert refine(result, assumption) == result
+
+@pytest.mark.parametrize("trig", [sin, cos])
+@pytest.mark.parametrize("odd", [False, True])
+def test_integral_quotient(trig, odd):
+    phase = n-m+r
+    assumption = Q.integer((phase-int(odd))/2)
+    result = refine(trig(x+pi*n/2-pi*m/2+pi*r/2), assumption)
+    assert not any(atom.args[0].has(n,m,r) for atom in result.atoms(sin,cos))
+    # Negative as well as positive integer substitutions independently check sign.
+    for k in [-5, -2, 0, 3]:
+        values = {n: 2*k+int(odd)+4, m: 7, r: 3}
+        assert simplify(result.subs(values)-trig(x+(2*k+int(odd))*pi/2)) == 0
+    assert refine(result, assumption) == result
+
+@pytest.mark.parametrize("trig", [sin, cos])
+def test_unknown_parity_is_preserved(trig):
+    expr = trig(x+pi*n/2+pi*m/2)
+    assert refine(expr, Q.integer(n+m)) == expr
+    assert refine(expr, Q.real(n+m)) == expr
+
+@pytest.mark.parametrize("trig", [sin, cos])
+def test_partial_phase_compatibility(trig):
+    assert refine(trig(x+pi*n+pi*m/2), Q.even(n)&Q.integer(m)) == trig(x+pi*m/2)

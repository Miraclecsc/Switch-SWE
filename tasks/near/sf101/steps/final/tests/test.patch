diff --git a/tests/model_fields/test_staged_contract.py b/tests/model_fields/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/model_fields/test_staged_contract.py
@@ -0,0 +1,36 @@
+from django.core.exceptions import ValidationError
+from django.db.models import BinaryField
+from django.test import SimpleTestCase
+
+
+class CanonicalBinaryTests(SimpleTestCase):
+    def test_reject_noncanonical_base64(self):
+        field = BinaryField()
+        for value in ["Zh==", "Zm9=", "Zg===", "====", "Zg==\n", "Zg== "]:
+            with self.assertRaises(ValidationError) as caught:
+                field.to_python(value)
+            self.assertEqual(caught.exception.code, "invalid")
+            self.assertEqual(caught.exception.params, {"value": value})
+
+    def test_valid_and_passthrough_values(self):
+        field = BinaryField()
+        for value, expected in [("", b""), ("Zg==", b"f"), ("Zm8=", b"fo"), ("Zm9v", b"foo")]:
+            self.assertEqual(bytes(field.to_python(value)), expected)
+        for value in [None, b"a", bytearray(b"b"), memoryview(b"c")]:
+            self.assertIs(field.to_python(value), value)
+
+    def test_reject_other_python_values(self):
+        field = BinaryField(error_messages={"invalid": "Invalid binary %(value)s"})
+        for value in [3, False, 3.0, [1, 2], {"x": 1}, object()]:
+            with self.assertRaises(ValidationError) as caught:
+                field.to_python(value)
+            self.assertEqual(caught.exception.code, "invalid")
+            self.assertIs(caught.exception.params["value"], value)
+            self.assertEqual(caught.exception.message, "Invalid binary %(value)s")
+
+    def test_custom_message_on_noncanonical_string(self):
+        field = BinaryField(error_messages={"invalid": "Bad encoded data"})
+        with self.assertRaises(ValidationError) as caught:
+            field.to_python("Zh==")
+        self.assertEqual(caught.exception.message, "Bad encoded data")
+        self.assertEqual(caught.exception.code, "invalid")

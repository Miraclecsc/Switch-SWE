diff --git a/tests/tracing/test_staged_contract.py b/tests/tracing/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/tracing/test_staged_contract.py
@@ -0,0 +1,60 @@
+import asyncio
+import copy
+import pytest
+from ariadne import graphql, graphql_sync, make_executable_schema
+from ariadne.contrib.tracing.apollotracing import ApolloTracingExtension, ApolloTracingExtensionSync
+
+
+SCHEMA = make_executable_schema("type Query { hello: String! }")
+
+
+def extension(sync, enabled=True):
+    cls = ApolloTracingExtensionSync if sync else ApolloTracingExtension
+    return cls(trace_default_resolver=enabled)
+
+
+def execute(ext, query, sync):
+    kwargs = dict(root_value={"hello": "ok"}, extensions=[lambda: ext])
+    result = graphql_sync(SCHEMA, {"query": query}, **kwargs) if sync else asyncio.run(graphql(SCHEMA, {"query": query}, **kwargs))
+    success, data = result
+    assert success and "errors" not in data
+    return data
+
+
+def paths(data):
+    return [r["path"] for r in data["extensions"]["tracing"]["execution"]["resolvers"]]
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_default_resolvers_are_traced_in_both_modes(sync):
+    data = execute(extension(sync), "{ hello }", sync)
+    assert paths(data) == [["hello"]]
+    record = data["extensions"]["tracing"]["execution"]["resolvers"][0]
+    assert record["duration"] >= 0 and record["startOffset"] >= 0
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_sequential_requests_keep_independent_results(sync):
+    ext = extension(sync)
+    first = execute(ext, "{ first: hello }", sync)
+    frozen = copy.deepcopy(first)
+    second = execute(ext, "{ second: hello }", sync)
+    assert paths(second) == [["second"]]
+    assert first == frozen
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_aliased_introspection_is_excluded(sync):
+    data = execute(extension(sync), "{ schemaAlias: __schema { queryType { name } } }", sync)
+    assert paths(data) == []
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_ordinary_alias_named_like_introspection_is_traced(sync):
+    data = execute(extension(sync), "{ __schema: hello }", sync)
+    assert paths(data) == [["__schema"]]
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_default_option_still_excludes_default_resolvers(sync):
+    assert paths(execute(extension(sync, False), "{ hello }", sync)) == []

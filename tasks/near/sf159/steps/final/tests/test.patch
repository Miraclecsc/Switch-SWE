diff --git a/tests/test_staged_contract.py b/tests/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_staged_contract.py
@@ -0,0 +1,32 @@
+import pytest
+import httpx
+
+def test_unknown_encoding_is_atomic():
+    r = httpx.Response(200, content=b'caf\xe9')
+    r.encoding = 'latin-1'
+    previous = r.encoding
+    for name in ('not-a-real-codec', ''):
+        with pytest.raises(ValueError):
+            r.encoding = name
+        assert r.encoding == previous
+        assert r.content == b'caf\xe9'
+    r.encoding = 'iso-8859-1'
+    assert r.text == 'café'
+
+def test_wrong_type_does_not_poison_response():
+    r = httpx.Response(200, content=b'hello')
+    previous = r.encoding
+    for value in (None, 7, False, b'utf8'):
+        with pytest.raises(TypeError):
+            r.encoding = value
+        assert r.encoding == previous
+    r.encoding = 'UTF8'
+    assert r.text == 'hello'
+
+def test_text_lock_keeps_cached_value():
+    r = httpx.Response(200, content=b'text')
+    assert r.text == 'text'
+    for value in ('utf8', 'unknown-encoding', None):
+        with pytest.raises(ValueError):
+            r.encoding = value
+    assert r.text == 'text'

diff --git a/tests/test_staged_contract.py b/tests/test_staged_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_staged_contract.py
@@ -0,0 +1,151 @@
+import asyncio
+import warnings
+
+import pytest
+
+from starlette.background import BackgroundTask
+from starlette.requests import Request
+from starlette.templating import Jinja2Templates
+
+
+def setup_templates(tmp_path, processors=()):
+    (tmp_path / "index.html").write_text("{{ request.url.path }}:{{ value }}")
+    return Jinja2Templates(str(tmp_path), context_processors=list(processors))
+
+
+def request(path="/one"):
+    return Request({"type": "http", "path": path, "root_path": "",
+                    "scheme": "http", "server": ("test", 80), "headers": []})
+
+
+def test_legacy_positional_response_options(tmp_path):
+    templates = setup_templates(tmp_path)
+    calls = []
+    background = BackgroundTask(calls.append, "done")
+    with pytest.warns(DeprecationWarning):
+        response = templates.TemplateResponse(
+            "index.html", {"request": request(), "value": "old"}, 202,
+            {"x-template": "legacy"}, "text/plain", background)
+    assert response.body == b"/one:old"
+    assert response.status_code == 202
+    assert response.headers["x-template"] == "legacy"
+    assert response.headers["content-type"].startswith("text/plain")
+    assert response.background is background
+    asyncio.run(response.background())
+    assert calls == ["done"]
+
+
+def test_modern_mixed_options_remain_supported(tmp_path):
+    templates = setup_templates(tmp_path)
+    response = templates.TemplateResponse(
+        request(), name="index.html", context={"value": "new"}, status_code=201,
+        headers={"x-template": "modern"}, media_type="text/plain")
+    assert response.body == b"/one:new"
+    assert response.status_code == 201
+    assert response.headers["x-template"] == "modern"
+
+
+def test_none_context_with_explicit_request(tmp_path):
+    templates = setup_templates(tmp_path)
+    first = templates.TemplateResponse(request(), "index.html", None)
+    second = templates.TemplateResponse(request=request("/two"), name="index.html", context=None)
+    assert first.body == b"/one:"
+    assert second.body == b"/two:"
+    assert first.context is not second.context
+
+
+def test_shared_context_is_not_mutated_between_requests(tmp_path):
+    seen = []
+    def processor(req):
+        seen.append(req)
+        return {"value": req.url.path}
+    templates = setup_templates(tmp_path, [processor])
+    context = {"value": "original"}
+    one, two = request(), request("/two")
+    first = templates.TemplateResponse(one, "index.html", context)
+    second = templates.TemplateResponse(two, "index.html", context)
+    assert context == {"value": "original"}
+    assert first.body == b"/one:/one"
+    assert second.body == b"/two:/two"
+    assert first.context["request"] is one
+    assert second.context["request"] is two
+    assert seen == [one, two]
+
+
+def test_explicit_request_overrides_stale_context_and_processor_request(tmp_path):
+    stale, current = request("/stale"), request("/current")
+    received = []
+    def processor(req):
+        received.append(req)
+        return {"request": stale, "value": "processed"}
+    templates = setup_templates(tmp_path, [processor])
+    context = {"request": stale, "value": "caller"}
+    response = templates.TemplateResponse(current, "index.html", context)
+    assert response.body == b"/current:processed"
+    assert response.context["request"] is current
+    assert context == {"request": stale, "value": "caller"}
+    assert received == [current]
+
+
+def test_legacy_context_is_not_mutated_by_processors(tmp_path):
+    templates = setup_templates(tmp_path, [lambda req: {"value": "processed"}])
+    req = request()
+    context = {"request": req, "value": "caller"}
+    with pytest.warns(DeprecationWarning):
+        response = templates.TemplateResponse("index.html", context)
+    assert response.body == b"/one:processed"
+    assert context == {"request": req, "value": "caller"}
+
+
+def test_duplicate_arguments_are_rejected_before_processing(tmp_path):
+    calls = []
+    templates = setup_templates(tmp_path, [lambda req: calls.append(req) or {}])
+    req = request()
+    invalid = [
+        ((req, "index.html"), {"name": "index.html"}),
+        ((req, "index.html", {}), {"context": {}}),
+        ((req, "index.html", {}, 201), {"status_code": 202}),
+        ((req, "index.html"), {"request": req}),
+        (("index.html", {"request": req}), {"name": "index.html"}),
+    ]
+    for args, kwargs in invalid:
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", DeprecationWarning)
+            with pytest.raises(TypeError):
+                templates.TemplateResponse(*args, **kwargs)
+    assert calls == []
+
+
+def test_unknown_and_excess_arguments_are_rejected_before_processing(tmp_path):
+    calls = []
+    templates = setup_templates(tmp_path, [lambda req: calls.append(req) or {}])
+    req = request()
+    invalid = [
+        ((req, "index.html"), {"statuz_code": 201}),
+        ((req, "index.html", {}, 200, None, None, None, "extra"), {}),
+        (("index.html", {"request": req}, 200, None, None, None, "extra"), {}),
+        ((), {"request": req, "name": "index.html", "extra": True}),
+        (("index.html", {"request": req}), {"request": req}),
+    ]
+    for args, kwargs in invalid:
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", DeprecationWarning)
+            with pytest.raises(TypeError):
+                templates.TemplateResponse(*args, **kwargs)
+    assert calls == []
+
+
+def test_missing_template_name_is_a_binding_error(tmp_path):
+    templates = setup_templates(tmp_path)
+    with pytest.raises(TypeError):
+        templates.TemplateResponse(request())
+    with pytest.raises(TypeError):
+        templates.TemplateResponse(request=request())
+
+
+def test_all_keyword_legacy_warning_and_rendering_remain_supported(tmp_path):
+    templates = setup_templates(tmp_path)
+    with pytest.warns(DeprecationWarning, match="requires the `request` argument"):
+        response = templates.TemplateResponse(
+            name="index.html", context={"request": request(), "value": "old"})
+    assert response.body == b"/one:old"

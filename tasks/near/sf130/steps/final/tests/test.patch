+import copy
+import os
+import re
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+from django import forms
+from django.test import SimpleTestCase
+
+class RefreshTests(SimpleTestCase):
+    def test_callable_path_and_pathlike(self):
+        with tempfile.TemporaryDirectory() as a, tempfile.TemporaryDirectory() as b:
+            Path(a,"a.txt").touch();Path(b,"b.txt").touch()
+            current=[Path(a)];calls=[]
+            def path(): calls.append(current[0]);return current[0]
+            field=forms.FilePathField(path=path)
+            self.assertEqual(len(calls),1)
+            self.assertEqual(field.choices,[(str(Path(a,"a.txt")),"a.txt")])
+            current[0]=Path(b);field.set_choices()
+            self.assertEqual(len(calls),2)
+            self.assertIs(field.path,path)
+            self.assertEqual(field.widget.choices,[(str(Path(b,"b.txt")),"b.txt")])
+
+    def test_nonrecursive_failure_is_atomic(self):
+        with tempfile.TemporaryDirectory() as root:
+            Path(root,"first").touch();field=forms.FilePathField(root,required=False)
+            before=list(field.choices);widget=list(field.widget.choices)
+            with patch("django.forms.fields.os.scandir",side_effect=OSError("disk failed")):
+                with self.assertRaises(OSError):field.set_choices()
+            self.assertEqual(field.choices,before);self.assertEqual(field.widget.choices,widget)
+            Path(root,"first").unlink();Path(root,"second").touch();field.set_choices()
+            self.assertEqual(field.choices[1:],[(str(Path(root,"second")),"second")])
+            self.assertEqual(field.choices,field.widget.choices)
+
+    def test_bad_pattern_is_atomic_and_recoverable(self):
+        with tempfile.TemporaryDirectory() as root:
+            Path(root,"a.txt").touch();field=forms.FilePathField(root);before=list(field.choices)
+            field.match="["
+            with self.assertRaises(re.error):field.set_choices()
+            self.assertEqual(field.choices,before);self.assertEqual(field.widget.choices,before)
+            field.match=r"\.txt$";field.set_choices();self.assertEqual(field.choices,before)
+
+    def test_recursive_failure_after_partial_scan(self):
+        with tempfile.TemporaryDirectory() as root:
+            Path(root,"original").touch();field=forms.FilePathField(root,recursive=True)
+            before=list(field.choices)
+            def walk(path,**kwargs):
+                yield root,[],["partial"]
+                kwargs["onerror"](PermissionError("subdirectory"))
+            with patch("django.forms.fields.os.walk",side_effect=walk):
+                with self.assertRaises(PermissionError):field.set_choices()
+            self.assertEqual(field.choices,before);self.assertEqual(field.widget.choices,before)
+
+    def test_callable_failure_keeps_snapshot(self):
+        with tempfile.TemporaryDirectory() as root:
+            Path(root,"a").touch();field=forms.FilePathField(root);before=list(field.choices)
+            def unavailable():raise OSError("unavailable")
+            field.path=unavailable
+            with self.assertRaises(OSError):field.set_choices()
+            self.assertEqual(field.choices,before);self.assertEqual(field.widget.choices,before)
+
+    def test_form_instance_isolation_and_replacement(self):
+        with tempfile.TemporaryDirectory() as root:
+            Path(root,"a").touch()
+            class Form(forms.Form):file=forms.FilePathField(root)
+            first,second=Form(),Form();before=list(second.fields["file"].choices)
+            Path(root,"a").unlink();Path(root,"b").touch()
+            first.fields["file"].set_choices();first.fields["file"].set_choices()
+            self.assertEqual(first.fields["file"].choices,[(str(Path(root,"b")),"b")])
+            self.assertEqual(second.fields["file"].choices,before)
+            self.assertEqual(Form.base_fields["file"].choices,before)

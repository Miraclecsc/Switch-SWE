@@ -0,0 +1,72 @@
+import networkx as nx
+import pytest
+
+
+def oracle(graph, sources, targets, edge, normalized):
+    """Independent path enumeration, not the Brandes accumulation helpers."""
+    result = dict.fromkeys(graph.edges() if edge else graph, 0.0)
+    for source in set(sources):
+        for target in set(targets):
+            if source == target:
+                continue
+            try:
+                paths = list(nx.all_shortest_paths(graph, source, target, weight="weight"))
+            except nx.NetworkXNoPath:
+                continue
+            for path in paths:
+                items = zip(path, path[1:]) if edge else path[1:-1]
+                for item in items:
+                    if edge and item not in result:
+                        item = item[::-1]
+                    result[item] += 1 / len(paths)
+    n = len(graph)
+    scale = (1 / (n * (n - 1)) if edge else 1 / ((n - 1) * (n - 2))) if normalized else (1 if graph.is_directed() else 0.5)
+    return {key: value * scale for key, value in result.items()}
+
+
+def graph(directed):
+    result = nx.DiGraph() if directed else nx.Graph()
+    result.add_weighted_edges_from([(0, 1, 1), (1, 2, 1), (0, 2, 2), (2, 3, 1)])
+    return result
+
+
+@pytest.mark.parametrize("edge", [False, True])
+@pytest.mark.parametrize("directed", [False, True])
+@pytest.mark.parametrize("normalized", [False, True])
+def test_generator_node_sets_match_path_enumeration(edge, directed, normalized):
+    g = graph(directed)
+    sources, targets = [0, 0, 1, 2], [2, 3, 3]
+    fn = nx.edge_betweenness_centrality_subset if edge else nx.betweenness_centrality_subset
+    expected = oracle(g, sources, targets, edge, normalized)
+    before = list(g.edges(data=True))
+    actual = fn(g, iter(sources), iter(targets), weight="weight", normalized=normalized)
+    assert actual == pytest.approx(expected)
+    assert list(g.edges(data=True)) == before
+    assert sources == [0, 0, 1, 2] and targets == [2, 3, 3]
+
+
+@pytest.mark.parametrize("edge", [False, True])
+@pytest.mark.parametrize("missing", ["source", "target"])
+def test_missing_nodes_raise_node_not_found(edge, missing):
+    g = nx.path_graph(4)
+    fn = nx.edge_betweenness_centrality_subset if edge else nx.betweenness_centrality_subset
+    sources = [99] if missing == "source" else [0]
+    targets = [99] if missing == "target" else [3]
+    with pytest.raises(nx.NodeNotFound):
+        fn(g, iter(sources), iter(targets))
+
+
+@pytest.mark.parametrize("edge", [False, True])
+def test_valid_empty_sets_remain_zero(edge):
+    g = nx.path_graph(4)
+    fn = nx.edge_betweenness_centrality_subset if edge else nx.betweenness_centrality_subset
+    assert all(value == 0 for value in fn(g, [], []).values())
+
+
+def test_non_orderable_labels_and_list_snapshots():
+    left, right = object(), object()
+    g = nx.path_graph([left, "middle", right])
+    sources, targets = [left, left], [right]
+    result = nx.betweenness_centrality_subset(g, sources, targets)
+    assert result["middle"] == 0.5
+    assert sources == [left, left] and targets == [right]

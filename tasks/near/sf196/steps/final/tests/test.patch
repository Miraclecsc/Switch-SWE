diff --git a/tests/test_sf196_staged.py b/tests/test_sf196_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf196_staged.py
@@ -0,0 +1,44 @@
+
+import warnings
+import pytest
+import trio
+
+class TruthTrap:
+    def __bool__(self):
+        raise AssertionError('invalid option truth value was queried')
+
+def test_run_rejects_nonboolean_before_work_or_warnings():
+    ran = []
+    async def work():
+        ran.append(True)
+    for value in (0, 1, 'False', TruthTrap()):
+        with warnings.catch_warnings():
+            warnings.simplefilter('error')
+            with pytest.raises(TypeError, match='strict_exception_groups'):
+                trio.run(work, strict_exception_groups=value)
+    assert ran == []
+    trio.run(work)
+    assert ran == [True]
+
+def test_nursery_rejects_invalid_option_without_truth_testing():
+    async def main():
+        for value in (0, 'False', TruthTrap()):
+            with warnings.catch_warnings():
+                warnings.simplefilter('error')
+                with pytest.raises(TypeError, match='strict_exception_groups'):
+                    async with trio.open_nursery(strict_exception_groups=value):
+                        raise AssertionError('invalid nursery entered')
+    trio.run(main)
+
+def test_guest_invalid_option_has_no_host_side_effects():
+    callbacks = []
+    async def work():
+        raise AssertionError('guest started')
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')
+        with pytest.raises(TypeError, match='strict_exception_groups'):
+            trio.lowlevel.start_guest_run(work, run_sync_soon_threadsafe=callbacks.append, done_callback=callbacks.append, strict_exception_groups=TruthTrap())
+    assert callbacks == []
+    async def healthy():
+        return 7
+    assert trio.run(healthy) == 7

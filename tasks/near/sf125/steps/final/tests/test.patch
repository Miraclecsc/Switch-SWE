@@ -0,0 +1,38 @@
+from sympy import Matrix, Rational, Symbol, diag, factor, sqrt
+
+
+def positive_factor(expression):
+    # A valid equivalence-preserving normalizer that factors positive roots,
+    # leaving negative characteristic-polynomial coefficients unchanged.
+    return factor(expression) if expression.is_positive else expression
+
+
+def test_simplification_collision_adds_algebraic_multiplicities():
+    a = Symbol("a",positive=True)
+    root = sqrt(a*a+2*a+1)
+    matrix = diag(root,a+1)
+    values = matrix.eigenvals(simplify=positive_factor)
+    assert values == {a+1:2}
+    assert sum(value*count for value,count in values.items()) == matrix.applyfunc(factor).trace()
+
+
+def test_list_output_preserves_dimension_after_coalescing():
+    a = Symbol("a",positive=True)
+    root = sqrt(a*a+2*a+1)
+    matrix = diag(root,a+1,root)
+    values = matrix.eigenvals(multiple=True,simplify=positive_factor)
+    assert values == [a+1,a+1,a+1]
+    assert matrix.eigenvals(simplify=positive_factor) == {a+1:3}
+
+
+def test_simplification_does_not_approximately_merge_distinct_roots():
+    matrix = diag(1,1+Rational(1,10**30))
+    values = matrix.eigenvals(simplify=positive_factor)
+    assert len(values) == 2 and sum(values.values()) == 2
+
+
+def test_default_and_no_collision_behavior_remain_compatible():
+    matrix = Matrix([[1,0],[0,2]])
+    assert matrix.eigenvals() == {1:1,2:1}
+    assert matrix.eigenvals(simplify=positive_factor) == {1:1,2:1}
+    assert sorted(matrix.eigenvals(multiple=True)) == [1,2]

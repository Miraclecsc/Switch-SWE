--- /dev/null
+++ b/networkx/algorithms/tests/test_sf133_faces.py
@@ -0,0 +1,56 @@
+from collections import Counter
+import networkx as nx
+import pytest
+
+def embedding(g):
+    ok, e = nx.check_planarity(g)
+    assert ok
+    return e
+
+def edges(face):
+    return list(zip(face, face[1:] + face[:1]))
+
+def test_all_half_edges_and_bridges():
+    g = nx.disjoint_union(nx.cycle_graph(4), nx.path_graph(4))
+    g.add_node("isolated")
+    e = embedding(g)
+    walks = list(e.faces(as_edges=True))
+    assert Counter(x for f in walks for x in f) == Counter(list(e.edges()))
+    assert sorted(map(len, walks)) == [4, 4, 6]
+    assert list(e.faces()) == [list(u for u, v in f) for f in walks]
+
+def test_selected_sides_and_deduplication():
+    e = embedding(nx.cycle_graph(4))
+    face = e.traverse_face(0, 1)
+    seeds = iter([(0, 1), edges(face)[1], (1, 0), (0, 1)])
+    result = list(e.faces(seeds, as_edges=True))
+    assert result == [edges(face), edges(e.traverse_face(1, 0))]
+    assert list(e.faces(iter([]))) == []
+
+def test_all_seeds_validate_before_yield():
+    e = embedding(nx.path_graph(3))
+    before = e.get_data()
+    with pytest.raises(nx.NetworkXError):
+        iterator = e.faces(iter([(0, 1), (99, 0)]), as_edges=True)
+        next(iterator)
+    assert e.get_data() == before
+
+def test_one_shot_and_heterogeneous_nodes():
+    a, b, c = object(), "b", (1, 2)
+    g = nx.Graph([(a, b), (b, c)])
+    e = embedding(g)
+    class Once:
+        consumed = False
+        def __iter__(self):
+            assert not self.consumed
+            self.consumed = True
+            yield a, b
+            yield b, a
+    before = e.get_data()
+    walks = list(e.faces(Once(), as_edges=True))
+    assert walks == [edges(e.traverse_face(a, b))]
+    assert e.get_data() == before
+
+def test_default_and_isolates_unchanged():
+    e = embedding(nx.empty_graph(3))
+    assert list(e.faces()) == []

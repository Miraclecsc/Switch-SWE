+    def as_sqlite(self, compiler, connection):
+        lhs, lhs_params, keys = self.lhs.preprocess_lhs(compiler, connection)
+        path = connection.ops.compile_json_path(keys)
+        if self.rhs is None or (
+            isinstance(self.rhs, expressions.Value)
+            and self.rhs.value is None
+            and isinstance(self.rhs.output_field, JSONField)
+        ):
+            return "JSON_TYPE(%s, %%s) = 'null'" % lhs, tuple(lhs_params) + (path,)
+        sql, params = super().as_sql(compiler, connection)
+        if isinstance(self.rhs, str):
+            return "(JSON_TYPE(%s, %%s) = 'text' AND (%s))" % (lhs, sql), tuple(lhs_params) + (path,) + tuple(params)
+        return sql, params

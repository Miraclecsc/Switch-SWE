diff --git a/tests/test_sf148_callbacks.py b/tests/test_sf148_callbacks.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf148_callbacks.py
@@ -0,0 +1,71 @@
+from contextvars import ContextVar
+import pytest
+import anyio
+
+pytestmark=pytest.mark.anyio
+
+async def test_callback_order_removal_and_reentrant_registration():
+    gate=anyio.Event();events=[]
+    async def worker():await gate.wait();return 9
+    async with anyio.create_task_group() as tg:
+        h=tg.start_soon(worker)
+        def removed(handle):events.append("removed")
+        def first(handle):
+            assert handle.return_value==9
+            events.append("first")
+            handle.add_done_callback(lambda handle:events.append("late"))
+        h.add_done_callback(first)
+        h.add_done_callback(removed);h.add_done_callback(removed)
+        assert h.remove_done_callback(removed)==2
+        h.add_done_callback(lambda handle:events.append("second"))
+        gate.set()
+        assert await h==9
+        assert events==["first","second","late"]
+        h.add_done_callback(lambda handle:events.append("after"))
+        assert events[-1]=="after" and h.remove_done_callback(removed)==0
+
+async def test_context_is_captured_per_registration():
+    value=ContextVar("value",default="unset");gate=anyio.Event();events=[]
+    async def worker():value.set("worker");await gate.wait();return 4
+    async with anyio.create_task_group() as tg:
+        h=tg.start_soon(worker)
+        def callback(handle):
+            events.append(value.get());value.set("inside")
+        value.set("one");h.add_done_callback(callback)
+        value.set("two");h.add_done_callback(callback)
+        value.set("caller");gate.set();await h
+        assert events==["one","two"] and value.get()=="caller"
+        h.add_done_callback(callback)
+        assert events[-1]=="caller" and value.get()=="caller"
+
+async def test_callback_error_does_not_change_result(caplog):
+    gate=anyio.Event();events=[]
+    async def worker():await gate.wait();return 8
+    async with anyio.create_task_group() as tg:
+        h=tg.start_soon(worker)
+        def broken(handle):raise ValueError("callback marker")
+        h.add_done_callback(broken);h.add_done_callback(lambda h:events.append(h.return_value))
+        gate.set();assert await h==8
+        assert events==[8] and "callback marker" in caplog.text
+        with pytest.raises(TypeError):h.add_done_callback(1)
+
+async def test_start_handle_cancellation_callback():
+    events=[]
+    async def worker(*,task_status=anyio.TASK_STATUS_IGNORED):
+        task_status.started("ready")
+        await anyio.sleep_forever()
+    async with anyio.create_task_group() as tg:
+        h=await tg.start(worker,return_handle=True)
+        h.add_done_callback(lambda handle:events.append((handle.status.name,handle.start_value)))
+        h.cancel();await h.wait()
+        assert events==[("CANCELLED","ready")]
+
+async def test_failed_task_callback_observes_original_exception():
+    gate=anyio.Event();events=[];error=ValueError("worker marker")
+    async def worker():await gate.wait();raise error
+    with pytest.raises(ExceptionGroup):
+        async with anyio.create_task_group() as tg:
+            h=tg.start_soon(worker)
+            h.add_done_callback(lambda handle:events.append(handle.exception))
+            gate.set()
+    assert events==[error]

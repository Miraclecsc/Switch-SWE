diff --git a/sympy/printing/tests/test_rootsum_binding_v1.py b/sympy/printing/tests/test_rootsum_binding_v1.py
new file mode 100644
index 0000000000..aa9b3b68c5
--- /dev/null
+++ b/sympy/printing/tests/test_rootsum_binding_v1.py
@@ -0,0 +1,37 @@
+from sympy import Lambda, RootSum, exp, sstr, symbols, sympify
+
+
+def roundtrip(expression, local_symbols):
+    restored = sympify(sstr(expression),locals={s.name:s for s in local_symbols})
+    assert restored == expression
+    assert restored.free_symbols == expression.free_symbols
+
+
+def test_free_function_symbol_named_w_is_not_captured():
+    x,w = symbols("x w")
+    expression = RootSum(x**3+x+1,Lambda(x,exp(x+w)),auto=False)
+    roundtrip(expression,[w])
+
+
+def test_multiple_colliding_print_names_are_avoided():
+    x,w,w0 = symbols("x w w0")
+    expression = RootSum(x**3+x+1,Lambda(x,exp(x+w+w0)),auto=False)
+    roundtrip(expression,[w,w0])
+
+
+def test_symbolic_polynomial_coefficients_keep_generator_identity():
+    x,w = symbols("x w")
+    expression = RootSum(x**3+w*x+1,Lambda(x,exp(x)),x=x,auto=False)
+    roundtrip(expression,[w])
+
+
+def test_noncolliding_symbolic_coefficient_roundtrip():
+    x,a = symbols("x a")
+    expression = RootSum(x**3+a*x+1,Lambda(x,exp(x)),x=x,auto=False)
+    roundtrip(expression,[a])
+
+
+def test_original_univariate_printing_is_unchanged():
+    x,z = symbols("x z")
+    assert str(RootSum(x**5+2*x-1,Lambda(z,z),auto=False)) == "RootSum(w**5 + 2*w - 1)"
+    assert str(RootSum(x**5+2*x-1,Lambda(z,z**2),auto=False)) == "RootSum(w**5 + 2*w - 1, Lambda(w, w**2))"

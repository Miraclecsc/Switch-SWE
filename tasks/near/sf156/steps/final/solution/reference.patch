+def _filter_cancelled_group(
+    exc: BaseException, memo: dict[int, BaseException | None]
+) -> BaseException | None:
+    """Filter scope cancellation without rebuilding unchanged exception branches."""
+    key = id(exc)
+    if key in memo:
+        return memo[key]
+
+    if isinstance(exc, CancelledError) and is_anyio_cancellation(exc):
+        result: BaseException | None = None
+    elif isinstance(exc, BaseExceptionGroup):
+        children = tuple(
+            child
+            for original in exc.exceptions
+            if (child := _filter_cancelled_group(original, memo)) is not None
+        )
+        if not children:
+            result = None
+        elif len(children) == len(exc.exceptions) and all(
+            new is old for new, old in zip(children, exc.exceptions)
+        ):
+            result = exc
+        else:
+            result = exc.derive(children)
+            result.__traceback__ = exc.__traceback__
+            result.__cause__ = exc.__cause__
+            result.__context__ = exc.__context__
+            result.__suppress_context__ = exc.__suppress_context__
+            if hasattr(exc, "__notes__"):
+                result.__notes__ = list(exc.__notes__)
+    else:
+        result = exc
+
+    memo[key] = result
+    return result
+

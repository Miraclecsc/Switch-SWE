diff --git a/tests/test_sf167_staged.py b/tests/test_sf167_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf167_staged.py
@@ -0,0 +1,18 @@
+from ariadne.utils import convert_camel_case_to_snake, convert_kwargs_to_snake_case
+
+def test_existing_numeric_separator_is_preserved():
+    for original, expected in [("field_365Bar", "field_365_bar"), ("_365Days", "_365_days"), ("field__2Name", "field__2_name")]:
+        assert convert_camel_case_to_snake(original) == expected
+
+def test_numeric_names_are_idempotent():
+    for original in ["foo365Bar", "_365Days", "field_365Bar", "version12_34Value", "testWithUPPERPart", "field__2Name"]:
+        once = convert_camel_case_to_snake(original)
+        assert convert_camel_case_to_snake(once) == once
+
+def test_nested_resolver_numeric_keys():
+    @convert_kwargs_to_snake_case
+    def resolver(**kwargs):
+        return kwargs
+    data = {"field_365Bar": [{"item_2Name": "x"}, {"other12Name": {"_3Days": 4}}]}
+    assert resolver(input365=data) == {"input_365": {"field_365_bar": [{"item_2_name": "x"}, {"other_12_name": {"_3_days": 4}}]}}
+    assert data == {"field_365Bar": [{"item_2Name": "x"}, {"other12Name": {"_3Days": 4}}]}

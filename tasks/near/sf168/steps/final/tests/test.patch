@@ -0,0 +1,27 @@
+import math
+import networkx as nx
+import pytest
+
+def test_singleton_centrality():
+    for kind in (nx.Graph, nx.DiGraph):
+        graph = kind()
+        graph.add_node("only")
+        assert nx.eigenvector_centrality_numpy(graph) == {"only": 1.0}
+        graph.add_edge("only", "only", weight=4)
+        assert nx.eigenvector_centrality_numpy(graph, weight="weight") == {"only": 1.0}
+
+def test_two_node_undirected():
+    graph = nx.Graph()
+    graph.add_edge("left", "right", strength=5)
+    values = nx.eigenvector_centrality_numpy(graph, weight="strength")
+    assert values == pytest.approx({"left": 1/math.sqrt(2), "right": 1/math.sqrt(2)})
+
+def test_two_node_directed_left_eigenvector():
+    graph = nx.DiGraph()
+    graph.add_edge("a", "b", weight=4)
+    graph.add_edge("b", "a", weight=1)
+    values = nx.eigenvector_centrality_numpy(graph, weight="weight")
+    assert values == pytest.approx({"a": 1/math.sqrt(5), "b": 2/math.sqrt(5)})
+    graph.remove_edge("b", "a")
+    with pytest.raises(nx.AmbiguousSolution):
+        nx.eigenvector_centrality_numpy(graph, weight="weight")

+def test_pep_451_import_hook():
+    class ImportHook(importlib.abc.MetaPathFinder, importlib.abc.Loader):
+        def find_spec(self, name, path=None, target=None):
+            if name != "res":
+                return None
+
+            spec = importlib.machinery.PathFinder.find_spec(name)
+            return importlib.util.spec_from_file_location(
+                name,
+                spec.origin,
+                loader=self,
+                submodule_search_locations=spec.submodule_search_locations,
+            )
+
+        def create_module(self, spec):
+            return None  # default behaviour is fine
+
+        def exec_module(self, module):
+            return None  # we need this to satisfy the interface, it's wrong
+
+    # ensure we restore `sys.meta_path` after putting in our loader
+    before = sys.meta_path[:]
+
+    try:
+        sys.meta_path.insert(0, ImportHook())
+        package_loader = PackageLoader("res")
+        assert "test.html" in package_loader.list_templates()
+    finally:
+        sys.meta_path[:] = before
diff --git a/tests/test_sf176_staged.py b/tests/test_sf176_staged.py
new file mode 100644
--- /dev/null
+++ b/tests/test_sf176_staged.py
@@ -0,0 +1,21 @@
+import importlib
+import sys
+from jinja2 import Environment, PackageLoader
+
+def test_namespace_fallback_and_precedence(tmp_path, monkeypatch):
+    roots = [tmp_path / "first", tmp_path / "second"]
+    for root in roots:
+        (root / "staged_namespace" / "templates").mkdir(parents=True)
+    (roots[0] / "staged_namespace/templates/shared.txt").write_text("first")
+    (roots[1] / "staged_namespace/templates/shared.txt").write_text("second")
+    (roots[1] / "staged_namespace/templates/only.txt").write_text("fallback")
+    monkeypatch.syspath_prepend(str(roots[1]))
+    monkeypatch.syspath_prepend(str(roots[0]))
+    importlib.invalidate_caches()
+    try:
+        env = Environment(loader=PackageLoader("staged_namespace"))
+        assert env.get_template("shared.txt").render() == "first"
+        assert env.get_template("only.txt").render() == "fallback"
+        assert env.list_templates() == ["only.txt", "shared.txt"]
+    finally:
+        sys.modules.pop("staged_namespace", None)
